--// NORMS Main Script (Fully Combined, Integrated & Free Run)

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer

if not game or not game:GetService("Players") then
    error("[NORMS] Must run inside Roblox game")
end

if not player then
    Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    player = Players.LocalPlayer
end

-- =====================
-- CONFIG
-- =====================
local WEBHOOK_URL = "https://discord.com/api/webhooks/1392196860026028184/aFSBpdMyZjmg-cLAQsfPd7NEja-9xNUmf-WboOjBcGrmd7GPGK9mPK59UohHPJRDvfb_"

-- Bot State Control (All features enabled by default for free running)
local BotState = {
    Running = true,
    StartTime = os.time(),

    AutoBuySeeds = true,
    AutoBuyGears = true
}

-- Rarity Decimal Mapping for Embeds
local RARITY_DATA = {
    Common = { decimal = 16777215 },
    Uncommon = { decimal = 65280 },
    Rare = { decimal = 255 },
    Epic = { decimal = 8388736 },
    Legendary = { decimal = 16766720 },
    Mythic = { decimal = 16711680 }
}

-- =====================
-- NETWORKING HELPER
-- =====================
local Networking = {}

function Networking.fire(path, ...)
    local args = {...}
    local argc = select("#", ...)
    pcall(function()
        local shared = ReplicatedStorage:WaitForChild("SharedModules", 5)
        local netModule = shared and shared:WaitForChild("Networking", 5)
        if netModule then
            local net = require(netModule)
            local current = net
            for segment in string.gmatch(path, "[^%.]+") do
                if type(current) == "table" then current = current[segment] end
            end
            if current and type(current) == "table" and current.fire then
                current:fire(unpack(args, 1, argc))
            elseif current and current.Fire then
                current:Fire(unpack(args, 1, argc))
            end
        end
    end)
end

-- =====================
-- UI & VISUAL SETUP
-- =====================
pcall(function()
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

local targetStorage = CoreGui or player:FindFirstChildOfClass("PlayerGui")
if targetStorage:FindFirstChild("WaterBotUI") then
    targetStorage.WaterBotUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "WaterBotUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.DisplayOrder = 99999999
ScreenGui.Parent = targetStorage

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(1, 0, 1, 0)
MainFrame.Position = UDim2.new(0, 0, 0, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
MainFrame.BackgroundTransparency = 0 
MainFrame.BorderSizePixel = 0
MainFrame.Parent = ScreenGui

local LogoContainer = Instance.new("Frame")
LogoContainer.Size = UDim2.new(0, 140, 0, 140)
LogoContainer.Position = UDim2.new(0.5, -70, 0.5, -70)
LogoContainer.BackgroundTransparency = 1
LogoContainer.ZIndex = 5
LogoContainer.Parent = MainFrame

local CenterN = Instance.new("TextLabel")
CenterN.Size = UDim2.new(0, 50, 0, 50)
CenterN.Position = UDim2.new(0.5, -25, 0.5, -25)
CenterN.BackgroundTransparency = 1
CenterN.Text = "N"
CenterN.Font = Enum.Font.GothamBold
CenterN.TextSize = 52
CenterN.TextColor3 = Color3.fromRGB(0, 0, 0)
CenterN.TextStrokeTransparency = 1
CenterN.ZIndex = 6
CenterN.Parent = LogoContainer

local letters = {"O", "R", "M", "S"}
local labelObjects = {}

for i, letter in ipairs(letters) do
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 20, 0, 20)
    lbl.BackgroundTransparency = 1
    lbl.Text = letter
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 18
    lbl.TextColor3 = Color3.fromRGB(0, 0, 0)
    lbl.ZIndex = 6
    lbl.Parent = LogoContainer
    table.insert(labelObjects, lbl)
end

-- Rotation & Logo Orbit Engine
task.spawn(function()
    local angle = 0
    local radius = 46
    local rotationSpeed = 0.18
    
    while BotState.Running do
        local deltaTime = task.wait()
        angle = angle + (rotationSpeed * deltaTime)
        
        for i, lbl in ipairs(labelObjects) do
            local currentAngle = angle + ((i - 1) * (math.pi / 2))
            local xOffset = math.cos(currentAngle) * radius
            local yOffset = math.sin(currentAngle) * radius
            
            lbl.Position = UDim2.new(0.5, xOffset - 10, 0.5, yOffset - 10)
        end
    end
end)

-- =====================
-- OPTIMIZERS & PERFORMANCE
-- =====================
pcall(function()
    setfpscap(15)
end)

pcall(function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 2
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Sky") then
            v:Destroy()
        end
    end
end)

-- Continuous Low-Lag Booster (Clearing particles, textures, and heavy assets)
task.spawn(function()
    while BotState.Running do
        pcall(function()
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                    v:Destroy()
                elseif v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.CastShadow = false
                end
            end
        end)
        task.wait(10)
    end
end)

-- Instant and continuous cleanup for Workspace.Gardens and Map folders
task.spawn(function()
    while BotState.Running do
        pcall(function()
            local gardens = Workspace:FindFirstChild("Gardens")
            if gardens then
                gardens:Destroy()
            end

            local map = Workspace:FindFirstChild("Map")
            if map then
                for _, name in ipairs({"Garden", "Gardens", "GardenFolder"}) do
                    local folder = map:FindFirstChild("Map"):FindFirstChild(name) or map:FindFirstChild(name)
                    if folder then
                        folder:Destroy()
                    end
                end
            end
        end)
        task.wait(0.001)
    end
end)

-- =====================
-- AUTO-BUY SEEDS LOOP
-- =====================
task.spawn(function()
    local seedShopFolder = ReplicatedStorage:WaitForChild("StockValues", 10) and ReplicatedStorage.StockValues:WaitForChild("SeedShop", 5) and ReplicatedStorage.StockValues.SeedShop:WaitForChild("Items", 5)
    
    while BotState.Running do
        if BotState.AutoBuySeeds and seedShopFolder then
            for _, seedInstance in ipairs(seedShopFolder:GetChildren()) do
                if not BotState.Running or not BotState.AutoBuySeeds then break end
                
                local stock = seedInstance.Value
                if stock > 0 or stock == -1 then
                    local seedName = seedInstance.Name
                    Networking.fire("SeedShop.PurchaseSeed", seedName)
                    task.wait(0.15)
                end
            end
        end
        task.wait(1.5)
    end
end)

-- =====================
-- AUTO-BUY GEARS LOOP
-- =====================
task.spawn(function()
    local gearShopFolder = ReplicatedStorage:WaitForChild("StockValues", 10) and ReplicatedStorage.StockValues:WaitForChild("GearShop", 5) and ReplicatedStorage.StockValues.GearShop:WaitForChild("Items", 5)
    
    while BotState.Running do
        if BotState.AutoBuyGears and gearShopFolder then
            for _, gearInstance in ipairs(gearShopFolder:GetChildren()) do
                if not BotState.Running or not BotState.AutoBuyGears then break end
                
                local stock = gearInstance.Value
                if stock > 0 or stock == -1 then
                    local gearName = gearInstance.Name
                    Networking.fire("GearShop.PurchaseGear", gearName)
                    task.wait(0.15)
                end
            end
        end
        task.wait(2.5)
    end
end)

-- =====================
-- LOADING & BYPASS LOOP
-- =====================
task.spawn(function()
    while BotState.Running do
        task.wait(0.001)
        
        pcall(function()
            -- STOP LOADING STATE
            local v10 = false
            local v14 = true

            -- CAMERA FIX
            local cam = Workspace.CurrentCamera
            if cam then
                cam.CameraType = Enum.CameraType.Custom
                cam.FieldOfView = 70
            end

            -- UNANCHOR CHARACTER
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Anchored = false
                end
            end

            -- REMOVE LOADING UI
            local v16 = targetStorage:FindFirstChild("LoadingUI") or player:FindFirstChildOfClass("PlayerGui"):FindFirstChild("LoadingUI")
            if v16 then
                v16:Destroy()
            end

            -- RESTORE UI SYSTEM
            game:GetService("ProximityPromptService").Enabled = true
        end)
    end
end)
