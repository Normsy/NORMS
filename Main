        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = false
            end
        end
        
        -- REMOVE LOADING UI
        local v16 = targetStorage:FindFirstChild("LoadingUI") -- Adjusted to safely reference target storage if needed
        if v16 then
            v16:Destroy()
        end
        
        -- RESTORE UI SYSTEM
        pcall(function()
            game:GetService("ProximityPromptService").Enabled = true
        end)
    end
end)
