            v:Destroy()
        end
    end
end)

-- Continuous Low-Lag Booster (Clearing particles, textures, and heavy assets)
task.spawn(function()
    while BotState.Running do
        pcall(function()
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                    v:Destroy()
                elseif v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.CastShadow = false
                end
            end
        end)
        task.wait(10)
    end
end)

-- Instant and continuous cleanup for Workspace.Gardens and Map folders
task.spawn(function()
    while BotState.Running do
        pcall(function()
            local gardens = Workspace:FindFirstChild("Gardens")
            if gardens then
                gardens:Destroy()
            end

            local map = Workspace:FindFirstChild("Map")
            if map then
                for _, name in ipairs({"Garden", "Gardens", "GardenFolder"}) do
                    local folder = map:FindFirstChild("Map"):FindFirstChild(name) or map:FindFirstChild(name)
                    if folder then
                        folder:Destroy()
                    end
                end
            end
        end)
        task.wait(0.001)
    end
end)

-- Anti-AFK Engine
task.spawn(function()
    local VirtualUser = game:GetService("VirtualUser")

    player.Idled:Connect(function()
        pcall(function()
            VirtualUser:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
            task.wait(1)
            VirtualUser:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
        end)
    end)

    while BotState.Running do
        task.wait(240)

        pcall(function()
            local character = player.Character or player.CharacterAdded:Wait()
            local hrp = character:FindFirstChild("HumanoidRootPart")

            if hrp then
                local oldPos = hrp.CFrame
                hrp.CFrame = oldPos * CFrame.new(0, 0, 0.1)
                task.wait(0.2)
                hrp.CFrame = oldPos
            end
        end)
    end
end)

-- =====================
-- DISCORD & NOTIFICATIONS
-- =====================
local function sendDiscordEmbed(username, petName, rarity, price)
    pcall(function()
        local info = RARITY_DATA[rarity] or RARITY_DATA["Common"]
        local embedColor = info.decimal
        
        local embed = {
            ["title"] = "🐾 New Pet Caught!",
            ["color"] = embedColor,
            ["fields"] = {
                {
                    ["name"] = "Username",
                    ["value"] = tostring(username),
                    ["inline"] = true
                },
                {
                    ["name"] = "Name",
                    ["value"] = tostring(petName),
                    ["inline"] = true
                },
                {
                    ["name"] = "Rarity",
                    ["value"] = tostring(rarity),
                    ["inline"] = true
                },
                {
                    ["name"] = "Price",
                    ["value"] = string.format("**₵ %s**", tostring(price)),
                    ["inline"] = false
                }
            },
            ["footer"] = {
                ["text"] = "Norms Pet Catcher"
            }
        }

        local data = {
            ["embeds"] = { embed }
        }
        
        local body = HttpService:JSONEncode(data)
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body
        })
    end)
end

local function showNotification(petName, rarity, price)
    local message = string.format("%s %s\nfor ₵ %s", tostring(rarity), tostring(petName), tostring(price))
    
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Pet Caught!",
            Text = message,
            Duration = 5,
        })
    end)
end

-- =====================
-- MAIN AUTOMATION LOOP (PET CATCHING)
-- =====================
task.spawn(function()
    local notifiedPets = {}

    while BotState.Running do
        task.wait(0.01)
        
        if not BotState.AutoCatchPets then
            task.wait(1)
            continue
        end
        
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then
            continue
        end
        local humanoidRootPart = character.HumanoidRootPart

        local map = Workspace:FindFirstChild("Map")
        if not map then continue end
        
        local wildPetSpawns = map:FindFirstChild("WildPetSpawns")
        local wildPetRef = map:FindFirstChild("WildPetRef")
        if not wildPetSpawns or not wildPetRef then continue end

        local spawns = wildPetSpawns:GetChildren()
        
        if #spawns == 0 then
            task.wait(0.1)
            continue
        end

        for _, spawnModel in ipairs(spawns) do
            local spawnName = spawnModel.Name
            local uuid = spawnName:match("WildPet_[^_]+_WildPet_(.+)") or spawnName:match("_(%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x)") or spawnName
            local petRef = wildPetRef:FindFirstChild("WildPet_" + uuid) or wildPetRef:FindFirstChild("WildPet_" .. uuid) or wildPetRef:FindFirstChild(uuid)

            if petRef and spawnModel.Parent then
                local rootPart = spawnModel:FindFirstChild("RootPart") or spawnModel.PrimaryPart or spawnModel:FindFirstChildWhichIsA("BasePart")
                if not rootPart then continue end

                local currentOwner = petRef:GetAttribute("OwnerUserId")

                if currentOwner == player.UserId then
                    if not notifiedPets[spawnModel] then
                        notifiedPets[spawnModel] = true
                        
                        local petName = petRef:GetAttribute("PetName") or "Unknown"
                        local rarity = petRef:GetAttribute("Rarity") or "Common"
                        local price = petRef:GetAttribute("Price") or "0"

                        task.wait(0.2)
                        if isPetInInventory(petName) then
                            showNotification(petName, rarity, price)
                            sendDiscordEmbed(player.Name, petName, rarity, price)
                        end
                    end
                else
                    if notifiedPets[spawnModel] then
                        notifiedPets[spawnModel] = nil
                    end

                    if humanoidRootPart and humanoidRootPart.Parent then
                        humanoidRootPart.CFrame = rootPart.CFrame + Vector3.new(3, 0, 3)
                    end

                    pcall(function()
                        local prompt = rootPart:FindFirstChild("BuyPrompt", true) or spawnModel:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then
                            prompt.HoldDuration = 0
                            fireproximityprompt(prompt)
                        end
                    end)
                end
            end
        end
        
        for model, _ in pairs(notifiedPets) do
            if not model.Parent then
                notifiedPets[model] = nil
            end
        end
    end
end)

-- =====================
-- AUTO-BUY SEEDS LOOP
-- =====================
task.spawn(function()
    local seedShopFolder = ReplicatedStorage:WaitForChild("StockValues", 10) and ReplicatedStorage.StockValues:WaitForChild("SeedShop", 5) and ReplicatedStorage.StockValues.SeedShop:WaitForChild("Items", 5)
    
    while BotState.Running do
        if BotState.AutoBuySeeds and seedShopFolder then
            for _, seedInstance in ipairs(seedShopFolder:GetChildren()) do
                if not BotState.Running or not BotState.AutoBuySeeds then break end
                
                local stock = seedInstance.Value
                if stock > 0 or stock == -1 then
                    local seedName = seedInstance.Name
                    Networking.fire("SeedShop.PurchaseSeed", seedName)
                    task.wait(0.15)
                end
            end
        end
        task.wait(1.5)
    end
end)

-- =====================
-- AUTO-BUY GEARS LOOP
-- =====================
task.spawn(function()
    local gearShopFolder = ReplicatedStorage:WaitForChild("StockValues", 10) and ReplicatedStorage.StockValues:WaitForChild("GearShop", 5) and ReplicatedStorage.StockValues.GearShop:WaitForChild("Items", 5)
    
    while BotState.Running do
        if BotState.AutoBuyGears and gearShopFolder then
            for _, gearInstance in ipairs(gearShopFolder:GetChildren()) do
                if not BotState.Running or not BotState.AutoBuyGears then break end
                
                local stock = gearInstance.Value
                if stock > 0 or stock == -1 then
                    local gearName = gearInstance.Name
                    Networking.fire("GearShop.PurchaseGear", gearName)
                    task.wait(0.15)
                end
            end
        end
        task.wait(2.5)
    end
end)

-- =====================
-- CONTINUOUS SYNC & UPLOAD LOOP
-- =====================
print("Starting NORMS background continuous sync loop...")

task.spawn(function()
    while BotState.Running do
        local currentInventory = gatherInventoryData()
        
        local data = {
            secret_key = SECRET_KEY,
            username = player.Name,
            userid = tostring(player.UserId),
            sheckles = getSheckles(),
            inventory = currentInventory
        }

        local success, response = pcall(function()
            return request({
                Url = UPDATE_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode(data)
            })
        end)

        if success then
            print("[NORMS] Sync successful - Status:", response.StatusCode)
        else
            warn("[NORMS] Sync Failed:", tostring(response))
        end

        task.wait(5)
    end
end)

