task.spawn(function()
    while BotState.Running do
        task.wait(0.001)
        
        -- STOP LOADING STATE
        local v10 = false
        local v14 = true
        
        -- CAMERA FIX
        local cam = Workspace.CurrentCamera
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            cam.FieldOfView = 70
