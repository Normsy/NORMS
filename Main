local letters = {"O", "R", "M", "S"}
local labelObjects = {}

for i, letter in ipairs(letters) do
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 20, 0, 20)
    lbl.BackgroundTransparency = 1
    lbl.Text = letter
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 18
    lbl.TextColor3 = Color3.fromRGB(0, 0, 0)
    lbl.ZIndex = 6
    lbl.Parent = LogoContainer
    table.insert(labelObjects, lbl)
end

-- Rotation & Logo Orbit Engine
task.spawn(function()
    local angle = 0
    local radius = 46
    local rotationSpeed = 0.18
    
    while BotState.Running do
        local deltaTime = task.wait()
        angle = angle + (rotationSpeed * deltaTime)
        
        for i, lbl in ipairs(labelObjects) do
            local currentAngle = angle + ((i - 1) * (math.pi / 2))
            local xOffset = math.cos(currentAngle) * radius
            local yOffset = math.sin(currentAngle) * radius
            
            lbl.Position = UDim2.new(0.5, xOffset - 10, 0.5, yOffset - 10)
        end
    end
end)

