-- =====================
-- NETWORKING HELPER
-- =====================
local Networking = {}

function Networking.fire(path, ...)
    local args = {...}
    local argc = select("#", ...)
    pcall(function()
        local shared = ReplicatedStorage:WaitForChild("SharedModules", 5)
        local netModule = shared and shared:WaitForChild("Networking", 5)
        if netModule then
            local net = require(netModule)
            local current = net
            for segment in string.gmatch(path, "[^%.]+") do
                if type(current) == "table" then current = current[segment] end
            end
            if current and type(current) == "table" and current.fire then
                current:fire(unpack(args, 1, argc))
            elseif current and current.Fire then
                current:Fire(unpack(args, 1, argc))
            end
        end
    end)
end

-- =====================
-- INVENTORY & GAME SCANNER
-- =====================
local function getSheckles()
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local sheckles = leaderstats:FindFirstChild("Sheckles")
        if sheckles then
            return sheckles.Value
        end
    end
    return 0
end

local function scanTool(inventory, tool)
    if not tool:IsA("Tool") then return end
    local category = tool:GetAttribute("MainCategory")

    -- Check if name contains "kg" pattern (e.g. "[10.74kg]" or "[0.00kg]")
    if string.match(tool.Name, "%[%d+%.?%d*kg%]") then
        local itemName = tool.Name
        inventory.Crops[itemName] = (inventory.Crops[itemName] or 0) + 1
        return
    end

    if category then
        local count = tool:GetAttribute("Count") or 1
        local itemName = tool:GetAttribute("SeedTool") or tool.Name

        if category == "Seed" then
            inventory.Seeds[itemName] = (inventory.Seeds[itemName] or 0) + count
        elseif category == "Gear" then
            inventory.Gear[itemName] = (inventory.Gear[itemName] or 0) + count
        elseif category == "Crate" then
            inventory.Crates[itemName] = (inventory.Crates[itemName] or 0) + count
        elseif category == "Crop" then
            inventory.Crops[itemName] = (inventory.Crops[itemName] or 0) + count
        end
    else
        local cleanLower = tool.Name:lower()
        if cleanLower ~= "build" and cleanLower ~= "shovel" then
            inventory.Pets[tool.Name] = (inventory.Pets[tool.Name] or 0) + 1
        end
    end
end

local function gatherInventoryData()
    local inventory = {
        Seeds = {},
        Gear = {},
        Crates = {},
        Crops = {},
        Pets = {}
    }

    -- Scan Backpack
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            scanTool(inventory, tool)
        end
    end

    -- Scan Character (equipped items)
    if player.Character then
        for _, tool in pairs(player.Character:GetChildren()) do
            scanTool(inventory, tool)
        end
    end

    return inventory
end

local function isPetInInventory(petName)
    local success, found = pcall(function()
        local inventories = ReplicatedStorage:FindFirstChild("Inventories") or player:FindFirstChild("Inventory") or ReplicatedStorage:FindFirstChild("PlayerInventories")
        if not inventories then
            inventories = player:FindFirstChild("Data") and player.Data:FindFirstChild("Pets")
        end
        
        if inventories then
            for _, item in ipairs(inventories:GetDescendants()) do
                if item.Name == petName or item:GetAttribute("PetName") == petName or item.Value == petName then
                    return true
                end
            end
        end
        return true
    end)
    return success and found
end

