local function RefreshInventoryManually()
    RefreshInventoryButton.Text = "REFRESHING..."
    SellingStatus.Text = "Refreshing inventory..."
    SellingStatus.TextColor3 = Color3.fromRGB(251, 191, 36)

    task.spawn(function()
        local inv = nil
        local ok, result = pcall(function()
            local refs = require(ReplicatedStorage:WaitForChild("References"))
            local data = require(refs.PlayerScripts.Priority.Data)
            return data.GetLocal({"inventory"})
        end)
        if ok and type(result) == "table" then inv = result end
        if type(inv) == "table" then
            SellingInventory = inv
            SellingInventoryLoaded = true
            RefreshSellingStats()
            SellingStatus.Text = "Inventory refreshed"
            SellingStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
        else
            SellingStatus.Text = "Inventory refresh failed"
            SellingStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
        end
        RefreshInventoryButton.Text = "REFRESH INVENTORY"
    end)
end

RefreshInventoryButton.Activated:Connect(RefreshInventoryManually)

