    local remote = events:FindFirstChild(SelectedSellRemote)
    if not remote then return nil, SelectedSellRemote .. " not found" end
    if not remote:IsA("RemoteEvent") then return nil, SelectedSellRemote .. " is not a RemoteEvent" end
    return remote
end

