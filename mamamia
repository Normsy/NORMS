--// REMOTE RENAMING SETUP (RUNS FIRST UPON EXECUTION)
--// Matches the old NORMS script: blank RemoteFunctions become Function1, Function2, ...
--// and blank RemoteEvents become Event1, Event2, ...
local Communication = ReplicatedStorage:WaitForChild("Communication")
local Functions = Communication:WaitForChild("Functions")
local Events = Communication:WaitForChild("Events")

local functionIndex = 0
for _, obj in ipairs(Functions:GetChildren()) do
    if obj:IsA("RemoteFunction") and obj.Name == "" then
        functionIndex += 1
        obj.Name = "Function" .. functionIndex
    end
end

local eventIndex = 0
for _, obj in ipairs(Events:GetChildren()) do
    if obj:IsA("RemoteEvent") and obj.Name == "" then
        eventIndex += 1
        obj.Name = "Event" .. eventIndex
    end
end

