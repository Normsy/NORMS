--// HORSE FILTER HELPERS
function N.isOwned(node)
    if not node then return false end
    for attrKey in pairs(node:GetAttributes()) do
        if tostring(attrKey):lower() == "owner" then
            return true
        end
    end
    return false
end

function N.isInShop(node)
    local current = node
    while current and current ~= Workspace do
        local n = tostring(current.Name):lower()
        if n:find("shop", 1, true)
            or n:find("stable", 1, true)
            or n:find("barn", 1, true)
            or n:find("store", 1, true) then
            return true
        end
        current = current.Parent
    end
    return false
end

--// BACKGROUND SCANNER (scans every island folder in Workspace.Islands)
function N.ScanHorses()
    local now = tick()
    -- UPDATED: an empty result no longer forces a rescan on every call
    if now - LastScan < SCAN_INTERVAL then
        return ScanCache
    end

    local results = {}
    local seen = {}
    local islands = Workspace:FindFirstChild("Islands")
    if not islands then
        ScanCache = results
        LastScan = now
        return results
    end

    -- UPDATED: use the "Animal" tag list instead of walking every island's full tree.
    -- Falls back to the old tree walk if nothing is tagged.
    local usedTagged = false
    do
        local tagged = CollectionService:GetTagged("Animal")
        if #tagged > 0 then
            usedTagged = true
            for _, node in ipairs(tagged) do
                if not seen[node] and node.Parent and node:IsDescendantOf(islands)
                    and not N.isOwned(node) and N.CanGoToHorse(node) and not N.isInShop(node) then
                    seen[node] = true
                    local top = node
                    while top.Parent and top.Parent ~= islands do top = top.Parent end
                    local pivot = N.getHorsePivot(node)
                    if pivot then
                        local breed, rarity = N.getHorseBreed(node)
                        local ps = N.GetHorsePriorityStats(node)
                        table.insert(results, {
                            Model = node,
                            Island = top.Name,
                            Name = breed,
                            Rarity = rarity,
                            Unique = ps.UniqueHair,
                            UniqueCoat = ps.UniqueCoat,
                            Mismatched = ps.Mismatched,
                            NaturalDyed = ps.NaturalDyed,
                            Horned = ps.Horned,
                            Priority = ps.Priority,
                            PriorityCount = ps.Count,
                            Position = pivot.Position,
                            UID = node.Name .. "_" .. math.floor(pivot.Position.X) .. "_" .. math.floor(pivot.Position.Z)
                        })
                    end
                end
            end
        end
    end

    local function ScanContainer(container, islandName)
        for _, node in ipairs(container:GetChildren()) do
            if (node:IsA("Folder") or (node:IsA("Model") and not CollectionService:HasTag(node, "Animal"))) and not N.isHorse(node) then
                ScanContainer(node, islandName)
            elseif not seen[node] and N.isHorse(node) and not N.isOwned(node) and N.CanGoToHorse(node) and not N.isInShop(node) then
                seen[node] = true
                local pivot = N.getHorsePivot(node)
                if pivot then
                    local breed, rarity = N.getHorseBreed(node)
                    local unique = N.checkUniqueHair(node)
                    local priorityStats = N.GetHorsePriorityStats(node)
                    table.insert(results, {
                        Model = node,
                        Island = islandName,
                        Name = breed,
                        Rarity = rarity,
                        Unique = unique,
                        UniqueCoat = priorityStats.UniqueCoat,
                        Mismatched = priorityStats.Mismatched,
                        NaturalDyed = priorityStats.NaturalDyed,
                        Horned = priorityStats.Horned,
                        Priority = priorityStats.Priority,
                        PriorityCount = priorityStats.Count,
                        Position = pivot.Position,
                        UID = node.Name .. "_" .. math.floor(pivot.Position.X) .. "_" .. math.floor(pivot.Position.Z)
                    })
                end
            end
        end
    end

    for _, island in ipairs(islands:GetChildren()) do
        if island:IsA("Folder") or island:IsA("Model") then
            if not usedTagged then ScanContainer(island, island.Name) end
        end
    end

    ScanCache = results
    LastScan = now
    return results
end

