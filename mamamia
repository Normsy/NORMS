SavePersistentConfig = function()
    pcall(function()
        if writefile then
            local configData = {
                CatchRemote = CatchRemoteBox.Text,
                TravelRemote = TravelRemoteBox.Text,
                LassoType = LassoNameBox.Text,
                LassoUID = ConfiguredLassoUID or "",
                SelectedIsland = SelectedMainIsland,
                TweenSpeed = TWEEN_SPEED,
                RarityFilters = RarityFilters,
                AutoFarmEnabled = AutoFarmEnabled,
                AutoHopEnabled = autoHopEnabled,
                HopIntervalSeconds = hopIntervalSeconds,
                RemoteSpyEnabled = remoteSpyEnabled
            }
            writefile(CONFIG_FILE_NAME, HttpService:JSONEncode(configData))
        end
    end)
end

LoadPersistentConfig = function()
    pcall(function()
        if isfile and isfile(CONFIG_FILE_NAME) then
            local success, decoded = pcall(function()
                return HttpService:JSONDecode(readfile(CONFIG_FILE_NAME))
            end)
            if success and type(decoded) == "table" then
                if decoded.CatchRemote then
                    CatchRemoteBox.Text = decoded.CatchRemote
                    if decoded.CatchRemote ~= "" then
                        CatchRemoteBox.TextEditable = false
                        MakeUncopyable(CatchRemoteBox)
                        SaveCatchBtn.Text = "Saved"
                        SaveCatchBtn.BackgroundColor3 = Color3.fromRGB(57, 255, 20)
                        SaveCatchBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
                    end
                end
                if decoded.TravelRemote then
                    TravelRemoteBox.Text = decoded.TravelRemote
                    if decoded.TravelRemote ~= "" then
                        TravelRemoteBox.TextEditable = false
                        MakeUncopyable(TravelRemoteBox)
                        SaveTravelBtn.Text = "Saved"
                        SaveTravelBtn.BackgroundColor3 = Color3.fromRGB(57, 255, 20)
                        SaveTravelBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
                    end
                end
                if decoded.LassoType then
                    SelectedLasso = decoded.LassoType
                    LassoNameBox.Text = decoded.LassoType
                end
                if decoded.LassoUID and decoded.LassoUID ~= "" then
                    ConfiguredLassoUID = decoded.LassoUID
                    UidTextBox.Text = decoded.LassoUID
                    LassoStatus.Text = "UID Loaded"
                    LassoStatus.TextColor3 = Color3.fromRGB(57, 255, 20)
                    local lassoUI = findUIElement(LocalPlayer:WaitForChild("PlayerGui"), "Lasso Read Only")
                    if lassoUI and (lassoUI:IsA("TextBox") or lassoUI:IsA("TextLabel")) then
                        lassoUI.Text = decoded.LassoUID
                    end
                end
                if decoded.SelectedIsland then
                    SelectedMainIsland = decoded.SelectedIsland
                    SortBtn.Text = "Island: " .. SelectedMainIsland .. " v"
                end
                if decoded.TweenSpeed then
                    TWEEN_SPEED = tonumber(decoded.TweenSpeed) or 90
                    TweenSpeedLabel.Text = "Tween Speed (" .. tostring(TWEEN_SPEED) .. ")"
                end
                if decoded.RarityFilters and type(decoded.RarityFilters) == "table" then
                    for k, v in pairs(decoded.RarityFilters) do
                        if RarityFilters[k] ~= nil then
                            RarityFilters[k] = v
                            local checkContainer = RarityFilterContainer
                            if checkContainer then
                                local chkBtn = checkContainer:FindFirstChild(k .. "Check")
                                if chkBtn then
                                    local indicator = chkBtn:FindFirstChildOfClass("Frame")
                                    if indicator then
                                        indicator.BackgroundColor3 = v and Color3.fromRGB(124, 58, 237) or Color3.fromRGB(40, 40, 55)
                                        local mark = indicator:FindFirstChildOfClass("TextLabel")
                                        if mark then
                                            mark.Visible = v
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                if decoded.AutoFarmEnabled ~= nil then
                    AutoFarmEnabled = decoded.AutoFarmEnabled
                    if AutoFarmEnabled then
                        AutoToggleBtn.Text = " Auto ON"
                        local themeCol = Color3.fromRGB(57, 255, 20)
                        AutoToggleBtn.TextColor3 = themeCol
                        ToggleSwitch.BackgroundColor3 = themeCol
                        SwitchCircle.Position = UDim2.new(1, -8, 0.5, -3)
                        SwitchCircle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    else
                        AutoToggleBtn.Text = " Auto OFF"
                        AutoToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
                        ToggleSwitch.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
                        SwitchCircle.Position = UDim2.new(0, 1, 0.5, -3)
                        SwitchCircle.BackgroundColor3 = Color3.fromRGB(150, 150, 170)
                    end
                end
                if decoded.AutoHopEnabled ~= nil then
                    autoHopEnabled = decoded.AutoHopEnabled
                    if autoHopEnabled then
                        AutoHopToggleBtn.Text = "Auto: ON"
                        AutoHopToggleBtn.BackgroundColor3 = Color3.fromRGB(57, 255, 20)
                        AutoHopToggleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
