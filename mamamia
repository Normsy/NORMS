local NoClipEnabled = false
local NoClipLast = 0
local NoClipConnection = nil
local NoClipStates = {}
local NoClipParts, NoClipPartsChar, NoClipPartsTime = {}, nil, 0

function N.SetNoClip(enabled)
    NoClipEnabled = enabled

    if enabled then
        if NoClipConnection then
            NoClipConnection:Disconnect()
        end

        -- UPDATED: throttled to every 0.15s instead of every frame (anti-lag)
        NoClipConnection = RunService.Stepped:Connect(function()
            local nowT = tick()
            if nowT - NoClipLast < 0.15 then return end
            NoClipLast = nowT

            local char = LocalPlayer.Character
            if not NoClipEnabled or not char or not char.Parent then return end

            if NoClipPartsChar ~= char or nowT - NoClipPartsTime > 3 then
                NoClipPartsChar, NoClipPartsTime = char, nowT
                NoClipParts = {}
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then NoClipParts[#NoClipParts + 1] = part end
                end
            end
            for i = 1, #NoClipParts do
                local part = NoClipParts[i]
                if part.Parent then part.CanCollide = false end
            end
        end)
    else
        if NoClipConnection then
            NoClipConnection:Disconnect()
            NoClipConnection = nil
        end

        local char = LocalPlayer.Character
        if char and char.Parent then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
        table.clear(NoClipStates)
    end
end

