local function httpGet(url)
    local req = nil
    if typeof(request) == "function" then
        req = request
    elseif syn and typeof(syn.request) == "function" then
        req = syn.request
    elseif http and typeof(http.request) == "function" then
        req = http.request
    end
    if req then
        local r = req({Url = url, Method = "GET"})
        return r.Body
    end
    return game:HttpGet(url)
end

function A.fetchServers()
    local out = {}
    local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId)
        .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=50"
    local ok, body = pcall(httpGet, url)
    if not ok or not body then return out end
    local okD, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not okD or type(data) ~= "table" or not data.data then return out end
    for _, s in ipairs(data.data) do
        local playing = tonumber(s.playing) or 0
        local maxP = tonumber(s.maxPlayers) or 0
        if s.id and s.id ~= game.JobId and playing < maxP then
            out[#out + 1] = {id = s.id, playing = playing, max = maxP, ping = tonumber(s.ping)}
        end
    end
    table.sort(out, function(a, b) return a.playing > b.playing end)
    return out
end

function A.join(id, playing, maxP)
    if A.joining then return end
