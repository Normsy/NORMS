local goldenAppleBasketTween = nil

local function tweenToGoldenAppleBasket()
    if goldenAppleBasketTween then
        goldenAppleBasketTween:Cancel()
        goldenAppleBasketTween = nil
    end

    local basket = Workspace:FindFirstChild("Golden Apple Basket", true)

    if not basket then
        GoldenAppleBasketBtn.Text = "Basket Not Found"
        if StatusText then
            StatusText.Text = "STATUS: Golden Apple Basket not found"
            StatusText.TextColor3 = Color3.fromRGB(239, 68, 68)
        end
        task.delay(1.5, function()
            if GoldenAppleBasketBtn and GoldenAppleBasketBtn.Parent then
                GoldenAppleBasketBtn.Text = "Golden Apple Basket"
            end
        end)
        return
    end

    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not rootPart or not humanoid then
        return
    end

    local targetCFrame

    if basket:IsA("Model") then
        targetCFrame = basket:GetPivot() * CFrame.new(0, 3, 0)
    elseif basket:IsA("BasePart") then
        targetCFrame = basket.CFrame * CFrame.new(0, 3, 0)
    else
        local basketPart = basket:FindFirstChildWhichIsA("BasePart", true)
        if basketPart then
            targetCFrame = basketPart.CFrame * CFrame.new(0, 3, 0)
        end
    end

    if not targetCFrame then
        GoldenAppleBasketBtn.Text = "Invalid Basket"
        if StatusText then
            StatusText.Text = "STATUS: Golden Apple Basket has no usable position"
            StatusText.TextColor3 = Color3.fromRGB(239, 68, 68)
        end
        task.delay(1.5, function()
            if GoldenAppleBasketBtn and GoldenAppleBasketBtn.Parent then
                GoldenAppleBasketBtn.Text = "Golden Apple Basket"
            end
        end)
        return
    end

    local distance = (rootPart.Position - targetCFrame.Position).Magnitude
    local tweenTime = math.max(distance / TWEEN_SPEED, 0.1)

    GoldenAppleBasketBtn.Text = "GOING..."
    if StatusText then
        StatusText.Text = "STATUS: Tweening to Golden Apple Basket..."
        StatusText.TextColor3 = Color3.fromRGB(251, 191, 36)
    end

    rootPart.Anchored = true
    humanoid.PlatformStand = true
    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

    goldenAppleBasketTween = TweenService:Create(
        rootPart,
        TweenInfo.new(tweenTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = targetCFrame}
    )

    goldenAppleBasketTween:Play()

    goldenAppleBasketTween.Completed:Connect(function()
        if rootPart and rootPart.Parent then
            rootPart.CFrame = targetCFrame
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            rootPart.Anchored = false
        end

        if humanoid and humanoid.Parent and humanoid.Health > 0 then
            humanoid.PlatformStand = false
        end

        goldenAppleBasketTween = nil
        GoldenAppleBasketBtn.Text = "Golden Apple Basket"

        if StatusText then
            StatusText.Text = "STATUS: At Golden Apple Basket"
            StatusText.TextColor3 = Color3.fromRGB(52, 211, 153)
        end
    end)
end

GoldenAppleBasketBtn.MouseButton1Click:Connect(tweenToGoldenAppleBasket)

