local hopping = false
local function executeServerHop()
    if hopping then return end
    hopping = true

    ServerHopBtn.Text = "HOPPING..."
    if StatusText then
        StatusText.Text = "STATUS: Finding server..."
        StatusText.TextColor3 = Color3.fromRGB(251, 191, 36)
    end
    task.spawn(function()
        local success, err = pcall(function()
            local servers = {}
            local cursor = nil

            -- Search several pages and collect available servers.
            for page = 1, 5 do
                -- Descending order helps find fuller servers first.
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/public?sortOrder=Desc&limit=100"
                if cursor then
                    url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
                end

                local reqSuccess, reqResult = pcall(function()
                    return game:HttpGet(url)
                end)

                if not reqSuccess or not reqResult then break end

                local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(reqResult) end)
                if not decodeSuccess or not data or not data.data then break end

                for _, s in ipairs(data.data) do
                    if type(s) == "table"
                        and s.id ~= game.JobId
                        and s.playing
                        and s.maxPlayers
                        and s.playing < s.maxPlayers then
                        table.insert(servers, s)
                    end
                end

                cursor = data.nextPageCursor
                if not cursor then break end
            end

            -- Pick the server with the MOST players while still having room.
            local targetServer = nil
            for _, s in ipairs(servers) do
                if not targetServer or s.playing > targetServer.playing then
                    targetServer = s
                end
            end

            if targetServer then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer.id, LocalPlayer)
            else
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end
        end)
        if not success then
            warn("Server hop failed:", err)
            ServerHopBtn.Text = "Server Hop"
            if StatusText then
                StatusText.Text = "STATUS: Hop failed"
                StatusText.TextColor3 = Color3.fromRGB(239, 68, 68)
            end
            hopping = false
        end
    end)
end

