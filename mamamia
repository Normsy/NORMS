local function FindNormalHorseUID(inv)
    if type(inv) ~= "table" then return nil end
    for uid, item in pairs(inv) do
        if type(item) == "table" then
            local info = SellingGetItemInfo(item)
            if SellingGetBreed(item, info) then
                local main, mane, tail = SellingGetColours(item)
                local variants = item.variants or item.Variants or {}
                local unique = UniqueHairValues[NormalizePriorityValue(mane)] or UniqueHairValues[NormalizePriorityValue(tail)]
                local coat = IsOrangeMainColour(main)
                local mismatch = not SellingColoursMatch(mane, tail)
                local nat = item.isNatDyed ~= nil
                local horn = variants.hornColour ~= nil and tostring(variants.hornColour) ~= ""
                if not unique and not coat and not mismatch and not nat and not horn then
                    return tostring(uid)
                end
            end
        end
    end
    return nil
end

