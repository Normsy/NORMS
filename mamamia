--// CURRENT ISLAND (UPDATED: cached island points instead of looping every part every call)
local IslandPoints = {}
local IslandPointsTime = 0
local IslandRebuilding = false
local IslandLastName, IslandLastTime, IslandLastPos = nil, 0, nil

local ISLAND_CELL = 48 -- studs; one saved point per 48-stud cube (precise, but far fewer points than "every part")

function N.RebuildIslandPoints(async)
    if IslandRebuilding then return end
    IslandRebuilding = true
    pcall(function()
        local cache = {}
        local islands = Workspace:FindFirstChild("Islands")
        if islands then
            local walked = 0
            for _, island in ipairs(islands:GetChildren()) do
                if island:IsA("Folder") or island:IsA("Model") then
                    local pts, seenCells = {}, {}
                    -- chunked walk: no giant GetDescendants() table
                    local stack = {island}
                    while #stack > 0 do
                        local node = table.remove(stack)
                        for _, obj in ipairs(node:GetChildren()) do
                            walked += 1
                            if async and walked % 1500 == 0 then task.wait() end
                            if obj:IsA("BasePart") then
                                local pos = obj.Position
                                local key = (math.floor(pos.X / ISLAND_CELL) + 4000)
                                    + (math.floor(pos.Y / ISLAND_CELL) + 4000) * 8001
                                    + (math.floor(pos.Z / ISLAND_CELL) + 4000) * 64016001
                                if not seenCells[key] then
                                    seenCells[key] = true
                                    pts[#pts + 1] = pos
                                end
                            end
                            if #obj:GetChildren() > 0 then stack[#stack + 1] = obj end
                        end
                    end
                    if island:IsA("Model") then
                        local ok, pivot = pcall(function() return island:GetPivot() end)
                        if ok and pivot then pts[#pts + 1] = pivot.Position end
                    end
                    cache[island.Name] = pts
                end
            end
        end
        IslandPoints = cache
        IslandPointsTime = tick()
    end)
    IslandRebuilding = false
end

GetCurrentPlayerIsland = function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.Position
    local now = tick()
    if IslandLastPos and now - IslandLastTime < 0.4 and (pos - IslandLastPos).Magnitude < 40 then
        return IslandLastName
    end
    if next(IslandPoints) == nil then
        N.RebuildIslandPoints(false)
    elseif now - IslandPointsTime > 180 and not IslandRebuilding then
        task.spawn(N.RebuildIslandPoints, true)
    end
    local bestName, bestDistSq = nil, math.huge
    for name, pts in pairs(IslandPoints) do
        for i = 1, #pts do
            local d = pos - pts[i]
            local dsq = d:Dot(d)
            if dsq < bestDistSq then
                bestDistSq = dsq
                bestName = name
            end
        end
    end
    IslandLastName = (bestName and bestDistSq <= 2800 * 2800) and bestName or nil
    IslandLastTime = now
    IslandLastPos = pos
    return IslandLastName
end

