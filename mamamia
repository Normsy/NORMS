local function IsPlayerAtTravelIsland(islandName)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local island = GetTravelIslandObject(islandName)
    if not island then return false end

    -- Prefer the island model/folder geometry instead of relying only on its pivot.
    local nearest = math.huge
    for _, part in ipairs(island:GetDescendants()) do
        if part:IsA("BasePart") then
            local d = (root.Position - part.Position).Magnitude
            if d < nearest then nearest = d end
            if d <= 1800 then return true end
        end
    end

    local ok, pivot = pcall(function()
        if island:IsA("Model") then return island:GetPivot() end
    end)
    if ok and pivot and (root.Position - pivot.Position).Magnitude <= 1800 then
        return true
    end
    return nearest <= 1800
end

local function FindOtherIslandHorse()
    local islands = Workspace:FindFirstChild("Islands")
    if not islands then return nil end

    local currentIsland = GetCurrentPlayerIsland()
    local found = nil
    local seen = {}

    local function scan(container, islandName)
        if found then return end
        for _, node in ipairs(container:GetChildren()) do
            if found then return end

            if (node:IsA("Folder") or node:IsA("Model")) and not isHorse(node) then
                scan(node, islandName)
            elseif isHorse(node) and not seen[node] and not isOwned(node) and not isInShop(node) then
                seen[node] = true
                local pivot = getHorsePivot(node)
                if pivot and islandName ~= currentIsland then
                    found = {
                        Model = node,
                        Island = islandName,
                        Position = pivot.Position,
                        Pivot = pivot,
                        Name = getHorseBreed(node)
                    }
                    return
                end
            end
        end
    end

    for _, island in ipairs(islands:GetChildren()) do
        if (island:IsA("Folder") or island:IsA("Model")) and island.Name ~= currentIsland then
            scan(island, island.Name)
            if found then break end
        end
    end

    return found
end

local function IsPlayerAtTargetHorseIsland(targetIsland, targetHorsePosition)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    -- The strongest check is the actual target horse's island position.
    -- This avoids falsely accepting a Function merely because the character moved.
    if targetHorsePosition then
        local distanceToHorse = (root.Position - targetHorsePosition).Magnitude
        if distanceToHorse <= 2000 then
            return true
        end
    end

    -- Secondary check: determine the nearest loaded island to the character.
    local islands = Workspace:FindFirstChild("Islands")
    if not islands then return false end

    local nearestIsland = nil
    local nearestDistance = math.huge

    for _, island in ipairs(islands:GetChildren()) do
        if (island:IsA("Folder") or island:IsA("Model")) then
            local islandNearest = math.huge
            for _, part in ipairs(island:GetDescendants()) do
                if part:IsA("BasePart") then
                    local d = (root.Position - part.Position).Magnitude
                    if d < islandNearest then
                        islandNearest = d
                    end
                end
            end
            if island:IsA("Model") then
                local ok, pivot = pcall(function() return island:GetPivot() end)
                if ok and pivot then
                    local d = (root.Position - pivot.Position).Magnitude
                    if d < islandNearest then islandNearest = d end
                end
            end
            if islandNearest < nearestDistance then
                nearestDistance = islandNearest
                nearestIsland = island.Name
            end
        end
    end

    return nearestIsland == targetIsland and nearestDistance <= 2500
end

local function DetectTravelRemote()
    if not AutoTravelButton then return end
    if AutoTravelButton:GetAttribute("Busy") then return end

    AutoTravelButton:SetAttribute("Busy", true)
    AutoTravelButton.Text = "FINDING TRAVEL REMOTE..."
    AutoTravelStatus.Text = "Preparing a real travel test..."
    AutoTravelStatus.TextColor3 = Color3.fromRGB(251, 191, 36)

    task.spawn(function()
        local originalIsland = GetCurrentPlayerIsland()
        if not originalIsland or originalIsland == "" then
            AutoTravelStatus.Text = "Could not detect your current island."
            AutoTravelStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
            AutoTravelButton.Text = "AUTO FIND TRAVEL REMOTE"
            AutoTravelButton:SetAttribute("Busy", false)
            return
        end

        -- IMPORTANT:
        -- Testing a Travel remote by sending the island the player is ALREADY on
        -- is unreliable because a working remote may correctly do nothing visible.
        -- Use a different known island for the detection test, then return the
        -- player to the island they started on after a remote is found.
        local testIsland = nil
        local loadedIslands = Workspace:FindFirstChild("Islands")
        if loadedIslands then
            for _, island in ipairs(loadedIslands:GetChildren()) do
                if (island:IsA("Folder") or island:IsA("Model")) and island.Name ~= originalIsland then
                    testIsland = island.Name
                    break
                end
            end
        end
        if not testIsland then
            for _, islandName in ipairs(AutoTravelIslandNames) do
                if islandName ~= originalIsland then
                    testIsland = islandName
                    break
                end
            end
        end

        if not testIsland then
            AutoTravelStatus.Text = "No different island available for testing."
            AutoTravelStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
            AutoTravelButton.Text = "AUTO FIND TRAVEL REMOTE"
            AutoTravelButton:SetAttribute("Busy", false)
            return
        end

        AutoTravelStatus.Text = "Testing travel to: " .. tostring(testIsland)
        AutoTravelStatus.TextColor3 = Color3.fromRGB(251, 191, 36)
        task.wait(0.25)

        local function waitForIsland(targetIsland, timeout)
            local deadline = tick() + timeout
            while tick() < deadline do
                local nowIsland = GetCurrentPlayerIsland()
                if nowIsland == targetIsland then
                    return true
                end
                task.wait(0.15)
            end
            return false
        end

        local foundName = nil

        for i = 1, 90 do
            local remote = FindRemoteFunction(i)
            local name = "Function" .. tostring(i)

            if remote then
                AutoTravelButton.Text = "TESTING " .. name
                AutoTravelStatus.Text = name .. " -> " .. tostring(testIsland)

                -- Always capture the current character before the test.
                local charBefore = LocalPlayer.Character
                local rootBefore = charBefore and charBefore:FindFirstChild("HumanoidRootPart")
                local beforePosition = rootBefore and rootBefore.Position

                local invokeOK, invokeResult = pcall(function()
                    return remote:InvokeServer("Travel", testIsland, 1)
                end)
                if not invokeOK then
                    invokeOK, invokeResult = pcall(function()
                        return remote:InvokeServer("Travel", testIsland)
                    end)
                end

                if invokeOK then
                    -- Give the game enough time for the teleport/travel to finish.
                    local arrived = waitForIsland(testIsland, 5)

                    if arrived then
                        foundName = name
                        TravelRemoteBox.Text = name
                        TravelDropdown.Text = name
                        AutoTravelStatus.Text = "FOUND: " .. name .. " | Travel works"
                        AutoTravelStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
                        AutoTravelButton.Text = "TRAVEL REMOTE FOUND"
                        break
                    end

                    -- Some implementations move the character first and update
                    -- island bookkeeping slightly later, so also accept a large
                    -- character displacement as supporting evidence only when the
                    -- destination island was actually different.
                    local charAfter = LocalPlayer.Character
                    local rootAfter = charAfter and charAfter:FindFirstChild("HumanoidRootPart")
                    if rootAfter and beforePosition then
                        local displacement = (rootAfter.Position - beforePosition).Magnitude
                        if displacement > 1000 then
                            local confirmedIsland = GetCurrentPlayerIsland()
                            if confirmedIsland == testIsland then
                                foundName = name
                                TravelRemoteBox.Text = name
                                TravelDropdown.Text = name
                                AutoTravelStatus.Text = "FOUND: " .. name .. " | Travel works"
                                AutoTravelStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
                                AutoTravelButton.Text = "TRAVEL REMOTE FOUND"
                                break
                            end
                        end
                    end

                    AutoTravelStatus.Text = name .. " did not reach " .. tostring(testIsland) .. "; testing next..."
                else
                    AutoTravelStatus.Text = name .. " errored; testing next..."
                end

                -- Keep the requested one-second spacing between remote tests.
                task.wait(1)
            else
                AutoTravelStatus.Text = name .. " not available; testing next..."
                task.wait(0.15)
            end
        end

        if not foundName then
            -- We may still be on the original island because no function worked.
            -- Do not change the selected remote.
            AutoTravelStatus.Text = "No working Travel Remote found in Function1-Function90."
            AutoTravelStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
            AutoTravelButton.Text = "AUTO FIND TRAVEL REMOTE"
            AutoTravelButton:SetAttribute("Busy", false)
            return
        end

        -- Restore the island the player was on before detection.
        if GetCurrentPlayerIsland() ~= originalIsland then
            AutoTravelStatus.Text = "Remote found. Returning to " .. tostring(originalIsland) .. "..."
            AutoTravelStatus.TextColor3 = Color3.fromRGB(251, 191, 36)

            local selectedRemote = Functions:FindFirstChild(foundName)
            if selectedRemote and selectedRemote:IsA("RemoteFunction") then
                local restoreOK = pcall(function()
                    selectedRemote:InvokeServer("Travel", originalIsland, 1)
                end)
                if not restoreOK then
                    pcall(function()
                        selectedRemote:InvokeServer("Travel", originalIsland)
                    end)
                end
                waitForIsland(originalIsland, 8)
            end
        end

        if GetCurrentPlayerIsland() == originalIsland then
            AutoTravelStatus.Text = "FOUND: " .. tostring(foundName) .. " | Ready"
            AutoTravelStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
        else
            AutoTravelStatus.Text = "FOUND: " .. tostring(foundName) .. " | Return travel timed out"
            AutoTravelStatus.TextColor3 = Color3.fromRGB(255, 190, 100)
        end

        AutoTravelButton.Text = "TRAVEL REMOTE FOUND"
        AutoTravelButton:SetAttribute("Busy", false)
    end)
end

local function InventoryHasUID(inv, uid)
    return type(inv) == "table" and inv[uid] ~= nil
end

local function DetectSellRemote()
    if not AutoSellRemoteButton then return end
    if AutoSellRemoteButton:GetAttribute("Busy") then return end
    AutoSellRemoteButton:SetAttribute("Busy", true)
    AutoSellRemoteButton.Text = "FINDING SELL REMOTE..."
    AutoSellRemoteStatus.Text = "Getting one Normal Horse to use as the test target..."
    AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(251, 191, 36)

    task.spawn(function()
        -- Get one fresh inventory snapshot only when the detector starts.
        local testUID
        for attempt = 1, 40 do
            local inv = ReadLocalInventory()
            if type(inv) == "table" then
                SellingInventory = inv
                SellingInventoryLoaded = true
                testUID = FindNormalHorseUID(inv)
                if testUID then break end
            end
            AutoSellRemoteStatus.Text = "Looking for Normal Horse... " .. tostring(attempt) .. "/40"
            task.wait(0.5)
        end

        if not testUID then
            AutoSellRemoteStatus.Text = "No Normal Horse available for testing."
            AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(255, 190, 100)
            AutoSellRemoteButton.Text = "AUTO FIND SELL REMOTE"
            AutoSellRemoteButton:SetAttribute("Busy", false)
            return
        end

        AutoSellRemoteStatus.Text = "Target UID: " .. tostring(testUID) .. " | Testing Event1-90"

        for i = 1, 90 do
            local event = FindRemoteEvent(i)
            local eventName = "Event" .. tostring(i)

            if IsValidSellRemoteName(eventName) and event then
                -- IMPORTANT: each Event test uses the SAME target Normal Horse UID.
                -- Do not spam inventory refreshes before the test.
                AutoSellRemoteStatus.Text = "Testing " .. eventName .. " with target Normal Horse..."

                -- Exact captured sell payload.
                local fireOK, fireErr = pcall(function()
                    event:FireServer("SellItems", {[testUID] = 1})
                end)

                -- AFTER EVERY TEST: wait briefly for the inventory state to
                -- replicate, then take ONE fresh inventory snapshot. Do not
                -- recalculate all inventory statistics during remote detection.
                task.wait(0.35)
                local refreshedInventory = ReadLocalInventory()
                local sold = false

                if type(refreshedInventory) == "table" then
                    SellingInventory = refreshedInventory
                    SellingInventoryLoaded = true
                    sold = not InventoryHasUID(refreshedInventory, testUID)
                end

                if fireOK and sold then
                    SelectedSellRemote = eventName
                    RemoteDrop.Text = "Remote: " .. eventName
                    SellStatus.Text = "Remote: " .. eventName .. " | Filter: " .. SelectedSellCategory
                    AutoSellRemoteStatus.Text = "FOUND: " .. eventName .. " | Target UID is gone"
                    AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
                    AutoSellRemoteButton.Text = "SELL REMOTE FOUND"
                    AutoSellRemoteButton:SetAttribute("Busy", false)
                    return
                elseif not fireOK then
                    AutoSellRemoteStatus.Text = eventName .. " failed: " .. tostring(fireErr)
                elseif type(refreshedInventory) ~= "table" then
                    AutoSellRemoteStatus.Text = eventName .. " tested | inventory refresh failed"
                else
                    AutoSellRemoteStatus.Text = eventName .. " tested | target still in inventory"
                end
            end

            -- Keep the existing interval between Event tests.
            task.wait(0.5)
        end

        AutoSellRemoteStatus.Text = "No working Sell Remote in Event1-90."
        AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
        AutoSellRemoteButton.Text = "AUTO FIND SELL REMOTE"
        AutoSellRemoteButton:SetAttribute("Busy", false)
    end)
end

