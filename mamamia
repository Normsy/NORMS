local function IsPlayerAtTravelIsland(islandName)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local island = GetTravelIslandObject(islandName)
    if not island then return false end

    local nearest = math.huge
    for _, part in ipairs(island:GetDescendants()) do
        if part:IsA("BasePart") then
            local d = (root.Position - part.Position).Magnitude
            if d < nearest then nearest = d end
            if d <= 1800 then return true end
        end
    end

    local ok, pivot = pcall(function()
        if island:IsA("Model") then return island:GetPivot() end
    end)
    if ok and pivot and (root.Position - pivot.Position).Magnitude <= 1800 then
        return true
    end
    return nearest <= 1800
end

local function FindOtherIslandHorse()
    local islands = Workspace:FindFirstChild("Islands")
    if not islands then return nil end

    local currentIsland = GetCurrentPlayerIsland()
    local found = nil
    local seen = {}

    local function scan(container, islandName)
        if found then return end
        for _, node in ipairs(container:GetChildren()) do
            if found then return end

            if (node:IsA("Folder") or node:IsA("Model")) and not isHorse(node) then
                scan(node, islandName)
            elseif isHorse(node) and not seen[node] and not isOwned(node) and not isInShop(node) then
                seen[node] = true
                local pivot = getHorsePivot(node)
                if pivot and islandName ~= currentIsland then
                    found = {
                        Model = node,
                        Island = islandName,
                        Position = pivot.Position,
                        Pivot = pivot,
                        Name = getHorseBreed(node)
                    }
                    return
                end
            end
        end
    end

    for _, island in ipairs(islands:GetChildren()) do
        if (island:IsA("Folder") or island:IsA("Model")) and island.Name ~= currentIsland then
            scan(island, island.Name)
            if found then break end
        end
    end

    return found
end

local function IsPlayerAtTargetHorseIsland(targetIsland, targetHorsePosition)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    if targetHorsePosition then
        local distanceToHorse = (root.Position - targetHorsePosition).Magnitude
        if distanceToHorse <= 2000 then
            return true
        end
    end

    local islands = Workspace:FindFirstChild("Islands")
    if not islands then return false end

    local nearestIsland = nil
    local nearestDistance = math.huge

    for _, island in ipairs(islands:GetChildren()) do
        if (island:IsA("Folder") or island:IsA("Model")) then
            local islandNearest = math.huge
            for _, part in ipairs(island:GetDescendants()) do
                if part:IsA("BasePart") then
                    local d = (root.Position - part.Position).Magnitude
                    if d < islandNearest then
                        islandNearest = d
                    end
                end
            end
            if island:IsA("Model") then
                local ok, pivot = pcall(function() return island:GetPivot() end)
                if ok and pivot then
                    local d = (root.Position - pivot.Position).Magnitude
                    if d < islandNearest then islandNearest = d end
                end
            end
            if islandNearest < nearestDistance then
                nearestDistance = islandNearest
                nearestIsland = island.Name
            end
        end
    end

    return nearestIsland == targetIsland and nearestDistance <= 2500
end

local function DetectTravelRemote()
    if not AutoTravelButton then return end
    if AutoTravelButton:GetAttribute("Busy") then return end
    AutoTravelButton:SetAttribute("Busy", true)
    AutoTravelButton.Text = "FINDING TRAVEL REMOTE..."
    AutoTravelStatus.Text = "Detecting your current island..."
    AutoTravelStatus.TextColor3 = Color3.fromRGB(251, 191, 36)

    task.spawn(function()
        local currentIsland = GetCurrentPlayerIsland()

        if not currentIsland or currentIsland == "" then
            AutoTravelStatus.Text = "Could not detect your current island."
            AutoTravelStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
            AutoTravelButton.Text = "AUTO FIND TRAVEL REMOTE"
            AutoTravelButton:SetAttribute("Busy", false)
            return
        end

        AutoTravelStatus.Text = "Testing Travel on: " .. tostring(currentIsland)
        AutoTravelStatus.TextColor3 = Color3.fromRGB(251, 191, 36)
        task.wait(0.25)

        for i = 1, 36 do
            local remote = FindRemoteFunction(i)
            local name = "Function" .. tostring(i)

            if remote then
                AutoTravelButton.Text = "TESTING " .. name
                AutoTravelStatus.Text = name .. " -> Travel / " .. tostring(currentIsland)

                local beforeRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local beforeCFrame = beforeRoot and beforeRoot.CFrame
                local beforePosition = beforeRoot and beforeRoot.Position

                local invokeOK = pcall(function()
                    remote:InvokeServer("Travel", currentIsland, 1)
                end)

                local moved = false
                local elapsed = 0

                while elapsed < 1 do
                    task.wait(0.05)
                    elapsed += 0.05

                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root and beforePosition and beforeCFrame then
                        local positionChanged = (root.Position - beforePosition).Magnitude > 0.05
                        local orientationChanged = (root.CFrame.LookVector - beforeCFrame.LookVector).Magnitude > 0.001
                            or (root.CFrame.UpVector - beforeCFrame.UpVector).Magnitude > 0.001
                        if positionChanged or orientationChanged then
                            moved = true
                            break
                        end
                    end
                end

                if invokeOK and moved then
                    TravelRemoteBox.Text = name
                    AutoTravelStatus.Text = "FOUND: " .. name .. " | Character moved on " .. tostring(currentIsland)
                    AutoTravelStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
                    AutoTravelButton.Text = "TRAVEL REMOTE FOUND"
                    AutoTravelButton:SetAttribute("Busy", false)
                    return
                end

                if not invokeOK then
                    AutoTravelStatus.Text = name .. " errored; testing next..."
                else
                    AutoTravelStatus.Text = name .. " did not move the character; testing next..."
                end
            else
                AutoTravelStatus.Text = name .. " not available; testing next..."
                task.wait(1)
            end
        end

        AutoTravelStatus.Text = "No Travel Remote found in Function1-Function36."
        AutoTravelStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
        AutoTravelButton.Text = "AUTO FIND TRAVEL REMOTE"
        AutoTravelButton:SetAttribute("Busy", false)
    end)
end

