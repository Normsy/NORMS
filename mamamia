function N.SellFiltered(isAuto)
    if isAuto and SelectedSellCategory == "All" then
        -- safety: never auto-sell everything (would include priority horses)
        SellStatus.Text = "Auto sell skipped: filter is All"
        SellStatus.TextColor3 = Color3.fromRGB(255, 190, 100)
        return
    end
    if isAuto then
        local okA, freshInv = pcall(function()
            local refs = require(ReplicatedStorage:WaitForChild("References"))
            local data = require(refs.PlayerScripts.Priority.Data)
            return data.GetLocal({"inventory"})
        end)
        if okA and type(freshInv) == "table" then
            SellingInventory = freshInv
            SellingInventoryLoaded = true
        end
    end
    local remote, err = N.GetSelectedSellRemote()
    if not remote then
        SellStatus.Text = err
        SellStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
        return
    end

    if not SellingInventoryLoaded or type(SellingInventory) ~= "table" then
        SellStatus.Text = "Inventory unavailable"
        SellStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
        return
    end

    local itemsToSell = {}
    local count = 0
    for uid, item in pairs(SellingInventory) do
        if type(item) == "table" then
            local info = N.SellingGetItemInfo(item)
            if N.SellingGetBreed(item, info) and N.SellingItemMatchesCategory(item, info) then
                itemsToSell[tostring(uid)] = 1
                count += 1
            end
        end
    end

    if count == 0 then
        SellStatus.Text = "Nothing matches: " .. SelectedSellCategory
        SellStatus.TextColor3 = Color3.fromRGB(255, 190, 100)
        return
    end

    local ok, sendErr = pcall(function()
        remote:FireServer("SellItems", itemsToSell)
    end)
    if not ok then
        SellStatus.Text = "Sell failed: " .. tostring(sendErr)
        SellStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
        return
    end

    SellStatus.Text = "Sent sell request: " .. tostring(count) .. " horse(s) | " .. SelectedSellCategory .. " | " .. SelectedSellRemote
    SellStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
    task.delay(0.75, function()
        local ok2, newInv = pcall(function()
            local refs = require(ReplicatedStorage:WaitForChild("References"))
            local data = require(refs.PlayerScripts.Priority.Data)
            return data.GetLocal({"inventory"})
        end)
        if ok2 and type(newInv) == "table" then
            SellingInventory = newInv
            SellingInventoryLoaded = true
            if ActiveTab == "Selling" and not minimized then
                RefreshSellingStats()
            end
        end
    end)
end

