--// SAFE REMOTE DISCOVERY
--// Blank RemoteFunctions become Function1, Function2, ... and blank RemoteEvents become Event1, Event2, ...
local Communication = ReplicatedStorage:FindFirstChild("Communication")
local Functions = Communication and Communication:FindFirstChild("Functions")
local Events = Communication and Communication:FindFirstChild("Events")

local functionIndex = 0
local eventIndex = 0
if Functions then
    for _, obj in ipairs(Functions:GetChildren()) do
        if obj:IsA("RemoteFunction") and obj.Name == "" then
            functionIndex += 1
            obj.Name = "Function" .. functionIndex
        end
    end
end
if Events then
    for _, obj in ipairs(Events:GetChildren()) do
        if obj:IsA("RemoteEvent") and obj.Name == "" then
            eventIndex += 1
            obj.Name = "Event" .. eventIndex
        end
    end
end

print("[NORMS] Remote rename complete. Functions:", functionIndex, "Events:", eventIndex)
if not Communication or not Functions or not Events then
    warn("[NORMS] Communication remotes are not ready. Main UI will still load.")
end

