                        AutoToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
                        ToggleSwitch.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
                        SwitchCircle.Position = UDim2.new(0, 1, 0.5, -3)
                        SwitchCircle.BackgroundColor3 = Color3.fromRGB(150, 150, 170)
