function N.isHorse(node)
    if not node or not node.Parent then return false end
    if not node:IsA("Model") and not node:IsA("BasePart") then return false end

    local tagged = CollectionService:HasTag(node, "Animal")
    local behaviour = node:GetAttribute("behaviour")
    if tagged or behaviour == "WanderingAnimal" then
        return true
    end

    -- Fallbacks for servers where the Animal tag/behaviour is not present.
    if node:IsA("Model") then
        local overheadPart = node:FindFirstChild("OverheadPart")
        local overhead = overheadPart and overheadPart:FindFirstChild("Overhead")
        local breedLabel = overhead and overhead:FindFirstChild("BreedLabel")
        if breedLabel and breedLabel:IsA("TextLabel") and tostring(breedLabel.Text) ~= "" then
            return true
        end
        local lower = node.Name:lower()
        for breedName in pairs(N.RarityData) do
            local b = tostring(breedName):lower()
            if lower == b or lower:find(b, 1, true) then
                return true
            end
        end
    end
    return false
end

