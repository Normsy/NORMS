    local function fmtArg(v)
        local t = typeof(v)
        if t == "string" then
            return '"' .. (#v > 14 and (v:sub(1, 14) .. "..") or v) .. '"'
        elseif t == "Instance" then
            return "<" .. v.Name .. ">"
        elseif t == "table" then
            return "{table}"
        end
        local str = tostring(v)
        return #str > 14 and (str:sub(1, 14) .. "..") or str
    end

    local function SpyLog(remote, method, ...)
        if typeof(remote) ~= "Instance" then return end
        local args = table.pack(...)
        local name = remote.Name
        local parts = {}
        for i = 1, math.min(args.n, 4) do parts[i] = fmtArg(args[i]) end
        local text = name .. "(" .. table.concat(parts, ", ") .. (args.n > 4 and ", .." or "") .. ")"
        local entry = SpyData[name]
        if not entry then
            entry = {count = 0}
            SpyData[name] = entry
        else
            for i, n in ipairs(SpyOrder) do
                if n == name then table.remove(SpyOrder, i) break end
            end
        end
        entry.count += 1
        entry.text = text
        table.insert(SpyOrder, 1, name)
        while #SpyOrder > SPY_MAX do
            local old = table.remove(SpyOrder)
            SpyData[old] = nil
        end
        SpyDirty = true

        -- catch pattern: (lassoUID, "Activate", horse)
        if DetectCatch and args[2] == "Activate" and typeof(args[3]) == "Instance" then
            DetectCatch = false
            local uid = args[1]
            task.spawn(function()
                CatchBox.Text = name
                CatchRemoteName = name
                if type(uid) == "string" or type(uid) == "number" then
                    ConfiguredLassoUID = tostring(uid)
                    UidLabel.Text = "Lasso UID: " .. tostring(uid)
                    UidLabel.TextColor3 = Color3.fromRGB(100, 255, 130)
                end
                Save()
                DetectBtn.Text = "CATCH REMOTE FOUND: " .. name
                DetectBtn.TextColor3 = Color3.fromRGB(100, 255, 130)
            end)
        end
    end

    local function InstallSpyHook()
        if SpyHooked then return true end
        if not (hookmetamethod and getnamecallmethod and checkcaller) then return false end
        local ok = pcall(function()
            local old
            local function hook(self, ...)
                if SpyActive then
                    local method = getnamecallmethod()
                    if (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
                        pcall(SpyLog, self, method, ...)
                    end
                end
                return old(self, ...)
            end
            old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
        end)
        SpyHooked = ok
        return ok
    end

    local function RenderSpy()
        if #SpyOrder == 0 then
            SpyLogLabel.Text = SpyActive and "Listening... do the action in game now." or "Remote spy is off."
            return
        end
        local lines = {}
        for _, n in ipairs(SpyOrder) do
            local e = SpyData[n]
            lines[#lines + 1] = (e.count > 1 and ("x" .. e.count .. " ") or "") .. e.text
        end
        SpyLogLabel.Text = table.concat(lines, "\n")
    end

    task.spawn(function()
        while gui.Parent do
            task.wait(0.4)
            if SpyDirty then SpyDirty = false; pcall(RenderSpy) end
        end
    end)

    local function SetSpy(on)
        if on and not InstallSpyHook() then
            SpyLogLabel.Text = "Your executor does not support remote spy (needs hookmetamethod)."
            SpyActive = false
