--// 40-SECOND CATCH WATCHDOG
-- One watchdog is created for each catch cycle. tick() measures real elapsed time.
local function StartCatchWatchdog()
    if CatchWatchdogRunning then return end

    CatchWatchdogToken += 1
    local myToken = CatchWatchdogToken
    local startedAt = tick()
    CatchWatchdogRunning = true
    CatchCountdownRemaining = CATCH_TIMEOUT_SECONDS

    task.spawn(function()
        while myToken == CatchWatchdogToken and AutoFarmEnabled and CatchWatchdogRunning do
            local elapsed = tick() - startedAt
            local remaining = CATCH_TIMEOUT_SECONDS - elapsed
            local seconds = math.max(0, math.ceil(remaining))
            CatchCountdownRemaining = seconds

            if remaining <= 0 then
                -- Force the recovery even if the horse disappeared at the exact timeout.
                CatchWatchdogToken += 1
                CatchWatchdogRunning = false
                CatchCountdownRemaining = nil

                AutoFarmEnabled = false
                AutoToggleBtn.Text = " Auto OFF"
                AutoToggleBtn.TextColor3 = Color3.fromRGB(160, 166, 186)
                ToggleSwitch.BackgroundColor3 = Color3.fromRGB(55, 59, 76)
                SwitchCircle.Position = UDim2.new(0, 2, 0.5, -7)
                SwitchCircle.BackgroundColor3 = Color3.fromRGB(139, 146, 165)
                ActiveWalkTarget = nil
                ActiveTargetIsland = nil
                TargetUID = nil
                SavePersistentConfig()

                task.wait(0.5)

                if ScreenGui and ScreenGui.Parent then
                    AutoFarmEnabled = true
                    AutoToggleBtn.Text = " Auto ON"
                    AutoToggleBtn.TextColor3 = Color3.fromRGB(52, 211, 153)
                    ToggleSwitch.BackgroundColor3 = Color3.fromRGB(52, 211, 153)
