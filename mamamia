    -- UID is intentionally NOT included.
    return GetDiscordRarityCircles(horse).." **"..tostring(breed).."** - "..detail
end

local function BuildHorseWebhookData()
    local totalUniqueHair = 0
    local totalUniqueCoat = 0
    local totalMismatchedHair = 0
    local totalNaturalDyedHair = 0
    local totalHorned = 0

    local linesOut = {}

    -- Sort webhook horses by rarity group, then alphabetically by breed/name.
table.sort(HorseList, function(a, b)
    local function GetWebhookGroup(horse)
        local main, mane, tail = GetColours(horse.item)

        if IsUniqueHair(mane) or IsUniqueHair(tail) then
            return 1 -- Island Unique Hair
        elseif IsOrangeMainColour(main) then
            return 2 -- Island Unique Coat
        elseif not ColoursMatch(mane, tail) then
            return 3 -- Mismatched Hair
        elseif horse.item.isNatDyed ~= nil then
            return 4 -- Natural Dyed
        elseif horse.item.variants
            and horse.item.variants.hornColour ~= nil
            and tostring(horse.item.variants.hornColour) ~= "" then
            return 5 -- Horned
        end

        return 6 -- Normal
    end

    local groupA = GetWebhookGroup(a)
    local groupB = GetWebhookGroup(b)

    if groupA ~= groupB then
        return groupA < groupB
    end

    local nameA = tostring(a.breed or GetBreed(a.item, a.info) or "")
    local nameB = tostring(b.breed or GetBreed(b.item, b.info) or "")

    if nameA:lower() ~= nameB:lower() then
        return nameA:lower() < nameB:lower()
    end

    return nameA < nameB
end)

for _, horse in ipairs(HorseList) do
        local main, mane, tail = GetColours(horse.item)
        local variants = horse.item.variants or horse.item.Variants or {}

        if IsUniqueHair(mane) or IsUniqueHair(tail) then
            totalUniqueHair += 1
        end

        if IsOrangeMainColour(main) then
            totalUniqueCoat += 1
        end

        if not ColoursMatch(mane, tail) then
            totalMismatchedHair += 1
        end

        if horse.item.isNatDyed ~= nil then
            totalNaturalDyedHair += 1
        end

        if variants.hornColour ~= nil and tostring(variants.hornColour) ~= "" then
            totalHorned += 1
        end

        table.insert(linesOut, GetHorseWebhookLine(horse))
    end

    return linesOut, totalUniqueHair, totalUniqueCoat,
        totalMismatchedHair, totalNaturalDyedHair, totalHorned
end

local function SendHorseInventoryToDiscord()
    if DiscordWebhookURL == ""
        or DiscordWebhookURL == "PASTE_YOUR_DISCORD_WEBHOOK_URL_HERE" then
        return false, "Set DiscordWebhookURL first."
    end

    -- Seconds to wait between each Discord batch.
    local SendInterval = 1.5

    -- Keep batches safely below Discord's embed description limit.
    local MaxBatchCharacters = 3500

    local linesOut, uniqueHair, uniqueCoat, mismatched,
        naturalDyed, horned = BuildHorseWebhookData()

    if #linesOut == 0 then
        local ok, err = pcall(function()
            SendMessageEMBED(DiscordWebhookURL, {
                title = "Horse Inventory",
                description = "No horses were found in the inventory.",
                color = 5793266,
                footer = {
                    text = "Horse Scanner"
                }
            })
        end)

        if not ok then
            return false, tostring(err)
        end

        return true
    end

    -- Build every batch first so we know the total batch count.
    local batches = {}
    local currentBatch = {}
    local currentLength = 0

    for _, line in ipairs(linesOut) do
        local lineLength = #line + 1

        if #currentBatch > 0
            and currentLength + lineLength > MaxBatchCharacters then

            table.insert(batches, currentBatch)
            currentBatch = {}
            currentLength = 0
        end

        table.insert(currentBatch, line)
        currentLength += lineLength
    end

    if #currentBatch > 0 then
        table.insert(batches, currentBatch)
    end

    -- Send EVERY inventory batch first.
    for batchNumber, batch in ipairs(batches) do
        local sent, sendErr = pcall(function()
            SendMessageEMBED(DiscordWebhookURL, {
                title = "Inventory â¢ Batch "
                    ..tostring(batchNumber)
                    .."/"
                    ..tostring(#batches),

                description = table.concat(batch, "\n"),

                color = 5793266,

                footer = {
                    text = "Horse Scanner â¢ Batch "
                        ..tostring(batchNumber)
                        .."/"
                        ..tostring(#batches)
                }
            })
        end)

        if not sent then
            return false,
                "Batch "
                ..tostring(batchNumber)
                .." failed: "
                ..tostring(sendErr)
        end

        -- Wait BEFORE sending the next batch.
        if batchNumber < #batches then
            task.wait(SendInterval)
        end
    end

    -- Only after ALL inventory batches have been sent, send totals.
    task.wait(SendInterval)

    local totalsDescription =
        "Total Horse: "..tostring(#HorseList)
        .."\nTotal Island Unique Hair: "..tostring(uniqueHair)
        .."\nTotal Island Unique Coat: "..tostring(uniqueCoat)
        .."\nTotal Mismatched Hair: "..tostring(mismatched)
        .."\nTotal Natural Dyed Hair: "..tostring(naturalDyed)
        .."\nTotal Horned: "..tostring(horned)

    local totalsSent, totalsErr = pcall(function()
        SendMessageEMBED(DiscordWebhookURL, {
            title = "Inventory â¢ Totals",
            description = totalsDescription,
            color = 5793266,
            footer = {
                text = "Horse Scanner â¢ All batches sent"
            }
        })
    end)

    if not totalsSent then
        return false, "Totals failed: "..tostring(totalsErr)
    end

    return true
end

