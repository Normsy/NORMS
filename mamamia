-- Delta Executor Anti-AFK Script (Integrated with PlayerAdded & Custom Handler)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local VirtualUser = game:GetService("VirtualUser")

-- Global reference for cross-scope access
_G.AFKHandlerInstance = nil

-- Handle native Roblox 20-minute inactivity kick
local function setupIdled(player)
    if player == LocalPlayer then
        player.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
            
            -- Trigger custom AFK state reset instantly on idle signal
            if _G.AFKHandlerInstance then
                pcall(function()
                    _G.AFKHandlerInstance.Reset()
                    _G.AFKHandlerInstance.isAfk = false
                    _G.AFKHandlerInstance.isHardAfk = false
                end)
            end
        end)
    end
end

Players.PlayerAdded:Connect(setupIdled)
if LocalPlayer then
    setupIdled(LocalPlayer)
end

-- Bypass the game's custom AFKHandler module
task.spawn(function()
