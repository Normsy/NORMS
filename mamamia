                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                if decoded.AutoFarmEnabled ~= nil then
                    AutoFarmEnabled = decoded.AutoFarmEnabled
                    if AutoFarmEnabled then
                        AutoToggleBtn.Text = " Auto ON"
