function A.sell(isAuto)
    local st = S.SellStatus
    if isAuto and S.Category == "All" then
        setStatus(st, "Auto sell skipped: filter is All", C.amber)
        return
    end
    if isAuto then
        local inv = A.readInv()
        if inv then
            S.Inventory = inv
            S.Loaded = true
        end
    end
    if not S.Loaded or type(S.Inventory) ~= "table" then
        setStatus(st, "Inventory unavailable - press Refresh", C.red)
        return
    end
    local remote = Events:FindFirstChild(S.Remote)
    if not remote or not remote:IsA("RemoteEvent") then
        setStatus(st, S.Remote .. " is not a RemoteEvent. Use Auto Find Sell Remote.", C.red)
        return
    end
    local items, count = {}, 0
    for uid, item in pairs(S.Inventory) do
        if type(item) == "table" and A.isHorse(item) then
            local u, co, m, d, h = A.itemTraits(item)
            if A.matches(S.Category, u, co, m, d, h) then
                items[tostring(uid)] = 1
                count += 1
            end
        end
    end
    if count == 0 then
        setStatus(st, "Nothing matches: " .. S.Category, C.amber)
        return
    end
    local ok, err = pcall(function() remote:FireServer("SellItems", items) end)
    if not ok then
        setStatus(st, "Sell failed: " .. tostring(err), C.red)
        return
    end
    setStatus(st, "Sent sell request: " .. count .. " horse(s) | " .. S.Category .. " | " .. S.Remote, C.green)
    task.delay(0.75, function()
        local inv = A.readInv()
        if inv then
            S.Inventory = inv
            S.Loaded = true
            A.refreshCounts()
        end
    end)
end

