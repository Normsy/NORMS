-- catch remote detection (RemoteSpy style): hooks FireServer and waits for YOUR manual catch
function A.installHook()
    if A.hooked then return true end
    if not (hookmetamethod and getnamecallmethod) then return false end
    local ok = pcall(function()
        local old
        local function hook(self, ...)
            local method = getnamecallmethod()
            if A.detecting and method == "FireServer"
                and (not checkcaller or not checkcaller())
                and typeof(self) == "Instance" and self:IsA("RemoteEvent") then
                local args = table.pack(...)
                local isCatch = false
                for i = 1, args.n do
                    if args[i] == "Activate" then isCatch = true break end
                end
                if isCatch then
                    A.seen = {name = self.Name, uid = args[1], n = args.n}
                end
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
    end)
    A.hooked = ok
    return ok
end

-- Generate (Catch): tween to the NEAREST horse (any rarity). If it is on another island,
-- use the Travel remote first. Then anchor on it -> 20s countdown -> you catch it manually
-- -> the remote used is printed, typed into the box and auto saved.
function A.findCatch()
    if A.catchBusy then return end
    if AutoFarmEnabled then
        setStatus(A.CatchStatus, "Turn Auto OFF first.", C.red)
        return
    end
    if not A.installHook() then
        setStatus(A.CatchStatus, "Executor has no hookmetamethod.", C.red)
        return
    end
    A.catchBusy = true
    A.seen = nil
    A.CatchBtn.Text = "..."

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local weld, tween

    local function finish(msg, color)
        A.detecting = false
        if tween then pcall(function() tween:Cancel() end) end
        if weld then pcall(function() weld:Destroy() end) end
        pcall(function()
            if root then
                root.Anchored = false
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
            if hum then hum.PlatformStand = false end
        end)
        DisableNoClip(char)
        setStatus(A.CatchStatus, msg, color)
        A.CatchBtn.Text = "Generate"
        A.catchBusy = false
    end

    task.spawn(function()
        local ok, msg, color = pcall(function()
            if not (root and hum) or hum.Health <= 0 then
                return "Character not ready.", C.red
            end

            -- 1) nearest horse, whatever its rarity
            setStatus(A.CatchStatus, "Finding nearest horse...", C.amber)
            ClearCache()
            local here = GetCurrentPlayerIsland()
            local best, bestDist = nil, math.huge
            for _, h in ipairs(GetWorldHorses()) do
                local m = h.Model
                if m and m.Parent then
                    local okP, pivot = pcall(function() return m:GetPivot() end)
                    if okP and pivot then
                        local d = (root.Position - pivot.Position).Magnitude
                        if d < bestDist then
                            bestDist = d
                            best = h
                        end
                    end
                end
            end
            if not best then return "No horse found (check island/filters).", C.amber end
            local horse = best.Model

            -- 1b) horse is on another island -> Travel first
            if best.Island and best.Island ~= here then
                local travelName = TravelRemoteBox.Text
                local travelFunc = travelName ~= "" and Functions:FindFirstChild(travelName)
                if not travelFunc then
                    return "Horse is on " .. best.Island .. ". Generate Travel Remote first.", C.red
                end
                setStatus(A.CatchStatus, "Traveling to " .. best.Island .. "...", C.amber)
                local okT = pcall(function()
                    return travelFunc:InvokeServer("Travel", best.Island, 1)
                end)
                if not okT then return "Travel failed.", C.red end
                local t0 = tick()
                while tick() - t0 < 15 do
                    if not horse.Parent then return "Horse disappeared. Try again.", C.amber end
                    if GetCurrentPlayerIsland() == best.Island or tick() - t0 > 3 then break end
                    task.wait(0.2)
                end
                char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                root = char:WaitForChild("HumanoidRootPart")
                hum = char:WaitForChild("Humanoid")
            end
            if not horse.Parent then return "Horse disappeared. Try again.", C.amber end

            local part = horse:IsA("Model") and (horse.PrimaryPart or horse:FindFirstChildWhichIsA("BasePart")) or horse
            if not part then return "Horse has no usable part.", C.red end

            -- 2) tween to it
            setStatus(A.CatchStatus, "Tweening to " .. best.Name .. " (" .. best.Rarity .. ")...", C.amber)
            EnableNoClip(char)
            hum.PlatformStand = true
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            root.Anchored = true

            local targetCF = part.CFrame * CFrame.new(0, 3, 0)
            local dist = (root.Position - targetCF.Position).Magnitude
            tween = TweenService:Create(root,
                TweenInfo.new(math.max(dist / TWEEN_SPEED, 0.1), Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
                {CFrame = targetCF})
            tween:Play()
            while tween.PlaybackState == Enum.PlaybackState.Playing do
                if not horse.Parent or hum.Health <= 0 then
                    return "Horse disappeared. Try again.", C.amber
                end
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                task.wait(0.03)
            end
            if not horse.Parent then return "Horse disappeared. Try again.", C.amber end

            -- 3) anchor on it
            root.CFrame = part.CFrame * CFrame.new(0, 3, 0)
            weld = Instance.new("WeldConstraint")
            weld.Name = "HorseTrackerWeld"
            weld.Part0 = root
            weld.Part1 = part
            weld.Parent = root
            root.Anchored = true

            -- 4) 20s countdown: catch it MANUALLY, the hook records the remote
            A.detecting = true
            local DURATION = 20
            local startedAt = tick()
            local found = nil
            while tick() - startedAt < DURATION do
                if A.seen then found = A.seen break end
                if not horse.Parent then return "Horse disappeared. Try again.", C.amber end
                if hum.Health <= 0 then return "Character died.", C.red end
                local left = math.ceil(DURATION - (tick() - startedAt))
                setStatus(A.CatchStatus, "Catch it NOW! " .. left .. "s", C.amber)
                A.CatchBtn.Text = left .. "s"
                task.wait(0.1)
            end
            A.detecting = false

            if found then
                print("================================")
                print("[CATCH REMOTE] Remote used:", found.name)
                print("[CATCH REMOTE] First arg (lasso UID):", tostring(found.uid))
                print("[CATCH REMOTE] Arg count:", found.n)
                print("================================")
                CatchRemoteBox.Text = found.name
                SavePersistentConfig()
                return "Saved: " .. found.name, C.green
            end
            print("[CATCH REMOTE] Nothing detected in 20s.")
            return "Nothing detected. Press Generate and catch again.", C.red
        end)
        if not ok then
            finish("Error: " .. tostring(msg), C.red)
        else
            finish(msg, color)
        end
    end)
end

