--// CURRENT ISLAND
GetCurrentPlayerIsland = function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local islands = Workspace:FindFirstChild("Islands")
    if not root or not islands then return nil end

    local closestName, closestDistance = nil, math.huge
    for _, island in ipairs(islands:GetChildren()) do
        if island:IsA("Folder") or island:IsA("Model") then
            for _, obj in ipairs(island:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local d = (root.Position - obj.Position).Magnitude
                    if d < closestDistance then
                        closestDistance = d
                        closestName = island.Name
                    end
                end
            end
            if island:IsA("Model") then
                local ok, pivot = pcall(function() return island:GetPivot() end)
                if ok and pivot then
                    local d = (root.Position - pivot.Position).Magnitude
                    if d < closestDistance then
                        closestDistance = d
                        closestName = island.Name
                    end
                end
            end
        end
    end
    return closestName
end

--// SCREEN CLICK INPUT
--// The player manually equips the lasso. This script does not search for, equip,
--// or activate a Tool. It only sends a primary screen/mouse click at 0.5s intervals.
local VirtualInputManager = game:GetService("VirtualInputManager")

local function ScreenClick()
    local x, y = GetSightScreenPosition()

    return pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.03)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

local function SetCharacterAnchored(anchored)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not root then return end

    pcall(function()
        if not anchored then
            if activeWeld then
                activeWeld:Destroy()
                activeWeld = nil
            end
            root.Anchored = false
            if humanoid then
                humanoid.PlatformStand = false
                humanoid.AutoRotate = true
            end
            CharacterAnchored = false
            return
        end

        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        root.Anchored = true
        CharacterAnchored = true
    end)
end

local function stopFarm()
    Farming = false
    SetNoClip(false)
    SetCharacterAnchored(false)
    FarmGeneration += 1
    CurrentTarget = nil
    CurrentTargetUID = nil
    CurrentTargetIsland = nil
    button.Text = "START"
    button.BackgroundColor3 = Color3.fromRGB(57,255,20)
    button.TextColor3 = Color3.fromRGB(10,10,10)
    status.Text = "Idle"
    status.TextColor3 = Color3.fromRGB(150,155,165)
end


local function startFarm()
    if Farming then return end
    Farming = true
    SetNoClip(true)
    FarmGeneration += 1
    local myGeneration = FarmGeneration
    button.Text = "STOP"
    button.BackgroundColor3 = Color3.fromRGB(239,68,68)
    button.TextColor3 = Color3.fromRGB(255,255,255)

    task.spawn(function()
        while Farming and myGeneration == FarmGeneration and gui.Parent do
            local island = GetCurrentPlayerIsland()
            islandText.Text = "Island: " .. tostring(island or "?")

            if not island then
                status.Text = "No island detected"
                status.TextColor3 = Color3.fromRGB(239,68,68)
                task.wait(0.5)
                continue
            end

            -- ScanHorses() already scans every island loaded in the current server.
            -- Do not restrict candidates to the current island: the old tracker would
            -- select a horse from another island and use the Travel Remote to reach it.
            local candidates = {}
            for _, horse in ipairs(ScanHorses()) do
                if horse.Model and horse.Model.Parent then
                    table.insert(candidates, horse)
                end
            end

            table.sort(candidates, function(a,b)
                -- Selling..txt priority: Unique Hair > Island Unique Coat > Mismatched > Natural Dyed > Horned.
                if a.Priority ~= b.Priority then return a.Priority > b.Priority end
                if a.PriorityCount ~= b.PriorityCount then return a.PriorityCount > b.PriorityCount end
                local pa = RarityPriority[a.Rarity] or 0
                local pb = RarityPriority[b.Rarity] or 0
                if pa ~= pb then return pa > pb end
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not root then return false end
                return (root.Position-a.Position).Magnitude < (root.Position-b.Position).Magnitude
            end)

            local target = candidates[1]
            if not target then
                CurrentTarget = nil
                status.Text = "Scanning this island..."
                status.TextColor3 = Color3.fromRGB(150,155,165)
                task.wait(0.25)
                continue
            end

            CurrentTarget = target.Model
            CurrentTargetUID = target.UID
            CurrentTargetIsland = target.Island
            status.Text = "Target: " .. target.Name .. (target.Priority > 0 and (" [P" .. tostring(target.Priority) .. "]") or "")
            status.TextColor3 = Color3.fromRGB(57,255,20)

            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local targetPart = target.Model:IsA("Model") and (target.Model.PrimaryPart or target.Model:FindFirstChildWhichIsA("BasePart")) or target.Model

            if root and humanoid and humanoid.Health > 0 and targetPart and target.Model.Parent then
                -- Old-script behavior: if the selected horse is on another island,
                -- use the configured Travel Remote to travel there before tweening to it.
                if GetCurrentPlayerIsland() ~= target.Island then
                    local remoteName = tostring(TravelRemoteBox.Text or ""):match("^%s*(.-)%s*$")
                    if remoteName == "" then
                        status.Text = "Set Travel Remote in Settings"
                        status.TextColor3 = Color3.fromRGB(239, 68, 68)
                        CurrentTarget = nil
                        task.wait(0.5)
                        continue
                    end

                    local travelFunc = Functions:FindFirstChild(remoteName)
                    if not travelFunc or not travelFunc:IsA("RemoteFunction") then
                        status.Text = "Travel Remote not found: " .. remoteName
                        status.TextColor3 = Color3.fromRGB(239, 68, 68)
                        CurrentTarget = nil
                        task.wait(0.5)
                        continue
                    end

                    status.Text = "Traveling to " .. tostring(target.Island) .. "..."
                    status.TextColor3 = Color3.fromRGB(251, 191, 36)
                    local travelOk = pcall(function()
                        travelFunc:InvokeServer("Travel", target.Island, 1)
                    end)
                    if not travelOk then
                        status.Text = "Travel Failed"
                        status.TextColor3 = Color3.fromRGB(239, 68, 68)
                        CurrentTarget = nil
                        task.wait(0.5)
                        continue
                    end

                    local arrivalDeadline = tick() + 15
                    local arrived = false
                    while Farming and myGeneration == FarmGeneration and tick() < arrivalDeadline do
                        local nowIsland = GetCurrentPlayerIsland()
                        islandText.Text = "Island: " .. tostring(nowIsland or "?")
                        if nowIsland == target.Island then
                            arrived = true
                            break
                        end
                        task.wait(0.2)
                    end

                    if not arrived then
                        status.Text = "Travel Timeout"
                        status.TextColor3 = Color3.fromRGB(239, 68, 68)
                        CurrentTarget = nil
                        task.wait(0.5)
                        continue
                    end

                    char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    root = char:WaitForChild("HumanoidRootPart")
                    humanoid = char:WaitForChild("Humanoid")
                    targetPart = target.Model and target.Model.Parent and (target.Model:IsA("Model") and (target.Model.PrimaryPart or target.Model:FindFirstChildWhichIsA("BasePart")) or target.Model)
                    if not targetPart then
                        CurrentTarget = nil
                        task.wait(0.1)
                        continue
                    end
                end

                -- Copy the old tracker movement behavior: anchor the character BEFORE
                -- tweening. This prevents physics/collision correction from making the
                -- character shake when the route passes below terrain.
                -- Old script movement order: NoClip + PlatformStand + anchored root,
                -- then a pure TweenService CFrame tween. Do not repeatedly write CFrame
                -- during the tween; that was the source of the shaky motion.
                SetNoClip(true)
                humanoid.PlatformStand = true
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                root.Anchored = true
                CharacterAnchored = true

                local targetCFrame = targetPart.CFrame * HORSE_OFFSET
                local distance = (root.Position - targetCFrame.Position).Magnitude
                local tweenTime = distance / TWEEN_SPEED
                local tween = TweenService:Create(root, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {CFrame=targetCFrame})
                tween:Play()

                while tween.PlaybackState == Enum.PlaybackState.Playing and Farming and myGeneration == FarmGeneration do
                    if not target.Model.Parent or GetCurrentPlayerIsland() ~= target.Island or humanoid.Health <= 0 then
                        tween:Cancel()
                        break
                    end
                    -- Same velocity reset cadence as the old script, without touching CFrame.
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    task.wait(0.03)
                end

                if Farming and myGeneration == FarmGeneration and target.Model.Parent and GetCurrentPlayerIsland() == target.Island then
                    -- The tween is finished. Snap once to the exact position above the
                    -- horse, weld there, and keep the character anchored. No follow loop.
                    pcall(function()
                        root.CFrame = targetPart.CFrame * HORSE_OFFSET
                        if activeWeld then
                            activeWeld:Destroy()
                            activeWeld = nil
                        end
                        activeWeld = Instance.new("WeldConstraint")
                        activeWeld.Name = "HorseTrackerWeld"
                        activeWeld.Part0 = root
                        activeWeld.Part1 = targetPart
                        activeWeld.Parent = root
                    end)
                    root.Anchored = true
                    CharacterAnchored = true
                    status.Text = "Locked on: " .. target.Name
                    status.TextColor3 = Color3.fromRGB(57,255,20)
                    task.wait(0.08)

                    local caught = false
                    local catchDeadline = tick() + 8
                    while Farming and myGeneration == FarmGeneration and target.Model.Parent and tick() < catchDeadline do
                        if GetCurrentPlayerIsland() ~= target.Island then break end

                        -- Character stays anchored; no CFrame follow loop is needed.
                        ScreenClick()
                        status.Text = "Catching: " .. target.Name
                        status.TextColor3 = Color3.fromRGB(57,255,20)

                        -- Horse disappearance/ownership change is treated as success.
                        if not target.Model.Parent or isOwned(target.Model) then
                            caught = true
                            break
                        end

                        task.wait(CATCH_INTERVAL)
                    end
                                    -- After a successful catch, stay exactly where the last horse was.
                    -- Do not reset, respawn, teleport away, or move to another island.
                    if caught and root and root.Parent then
                        local lastStandCFrame = root.CFrame
                        SetCharacterAnchored(false)
                        pcall(function()
                            root.CFrame = lastStandCFrame
                            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end)
                        status.Text = "Caught: " .. target.Name .. " | Waiting for new horse..."
                        status.TextColor3 = Color3.fromRGB(57,255,20)
                    else
                        SetCharacterAnchored(false)
                    end
                    invalidate()
                end
            end

            -- No horse available is NOT a reason to reset or respawn.
            -- The character simply stays at the last position and the background
            -- scanner keeps checking until a new horse appears on this island.
            if not CurrentTarget then
                status.Text = "Waiting for new horse..."
                status.TextColor3 = Color3.fromRGB(150,155,165)
            end
            CurrentTarget = nil
            CurrentTargetUID = nil
            CurrentTargetIsland = nil
            task.wait(0.08)
        end
    end)
end

