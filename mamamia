local function DetectSellRemote()
    if not AutoSellRemoteButton then return end
    if AutoSellRemoteButton:GetAttribute("Busy") then return end
    AutoSellRemoteButton:SetAttribute("Busy", true)
    AutoSellRemoteButton.Text = "TESTING EVENT1-90..."
    AutoSellRemoteStatus.Text = "Scanning inventory continuously for a Normal Horse..."
    AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(251, 191, 36)

    task.spawn(function()
        local testUID

        -- Always pull a fresh inventory snapshot before selecting the test horse.
        for attempt = 1, 40 do
            local inv = ReadLocalInventory()
            if type(inv) == "table" then
                SellingInventory = inv
                SellingInventoryLoaded = true
                RefreshSellingStats()
                testUID = FindNormalHorseUID(inv)
                if testUID then break end
            end
            AutoSellRemoteStatus.Text = "Scanning inventory... " .. tostring(attempt) .. "/40"
            task.wait(0.5)
        end

        if not testUID then
            AutoSellRemoteStatus.Text = "No Normal Horse available for testing."
            AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(255, 190, 100)
            AutoSellRemoteButton.Text = "AUTO FIND SELL REMOTE"
            AutoSellRemoteButton:SetAttribute("Busy", false)
            return
        end

        AutoSellRemoteStatus.Text = "Test UID: " .. tostring(testUID) .. " | Event1-90"

        for i = 1, 90 do
            local event = FindRemoteEvent(i)
            local eventName = "Event" .. tostring(i)

            if event then
                -- Fresh snapshot immediately before every event test.
                local before = ReadLocalInventory()
                if type(before) ~= "table" then
                    AutoSellRemoteStatus.Text = "Inventory scan failed; retrying " .. eventName
                    task.wait(0.5)
                    continue
                end

                SellingInventory = before
                SellingInventoryLoaded = true
                RefreshSellingStats()

                -- If the chosen test UID has disappeared for any reason, choose
                -- another Normal Horse from the latest inventory snapshot.
                if not InventoryHasUID(before, testUID) then
                    testUID = FindNormalHorseUID(before)
                    if not testUID then
                        AutoSellRemoteStatus.Text = "Test horse disappeared and no replacement Normal Horse exists."
                        break
                    end
                    AutoSellRemoteStatus.Text = "New test UID: " .. tostring(testUID)
                end

                AutoSellRemoteStatus.Text = "Testing " .. eventName .. " with Normal Horse..."

                -- EXACT captured sell payload:
                -- EventX:FireServer("SellItems", {[testUID] = 1})
                local fireOK, fireErr = pcall(function()
                    event:FireServer("SellItems", {[testUID] = 1})
                end)

                -- Scan the inventory AFTER every event test. There is no
                -- background inventory scan; only this detector performs a
                -- scan when checking whether the test UID disappeared.
                task.wait(0.1)
                local after = ReadLocalInventory()
                local sold = type(after) == "table" and not InventoryHasUID(after, testUID)
                if type(after) == "table" then
                    SellingInventory = after
                    SellingInventoryLoaded = true
                end

                if fireOK and sold then
                    SelectedSellRemote = eventName
                    RemoteDrop.Text = "Remote: " .. eventName
                    SellStatus.Text = "Remote: " .. eventName .. " | Rarity: " .. SelectedSellRarity
                    AutoSellRemoteStatus.Text = "FOUND: " .. eventName .. " | UID left inventory"
                    AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
                    AutoSellRemoteButton.Text = "SELL REMOTE FOUND"
                    AutoSellRemoteButton:SetAttribute("Busy", false)
                    return
                elseif not fireOK then
                    AutoSellRemoteStatus.Text = eventName .. " failed: " .. tostring(fireErr)
                else
                    AutoSellRemoteStatus.Text = eventName .. " tested | horse still in inventory"
                end
            end

            -- Requested 0.5-second interval between Event tests.
            task.wait(0.5)
        end

        AutoSellRemoteStatus.Text = "No working Sell Remote in Event1-90."
        AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
        AutoSellRemoteButton.Text = "AUTO FIND SELL REMOTE"
        AutoSellRemoteButton:SetAttribute("Busy", false)
    end)
end

