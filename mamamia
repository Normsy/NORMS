local function GetDiscordRarityCircles(horse)
    local main, mane, tail = GetColours(horse.item)
    local variants = horse.item.variants or horse.item.Variants or {}

    local unique = IsUniqueHair(mane) or IsUniqueHair(tail)
    local uniqueCoat = IsOrangeMainColour(main)
    local mismatch = not ColoursMatch(mane, tail)
    local natdyed = horse.item.isNatDyed ~= nil
    local horn = variants.hornColour ~= nil
        and tostring(variants.hornColour) ~= ""

    local circles = {}

    if unique then table.insert(circles, "🔴") end
    if uniqueCoat then table.insert(circles, "🟠") end
    if mismatch then table.insert(circles, "🔵") end
    if natdyed then table.insert(circles, "🟢") end
    if horn then table.insert(circles, "🟣") end

    if #circles == 0 then
        table.insert(circles, "⚪")
    end

    return table.concat(circles, " ")
end

local function GetHorseWebhookLine(horse)
