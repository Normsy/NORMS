local function GetHttpRequest()
    if typeof(request) == "function" then
        return function(url)
            local response = request({
                Url = url,
                Method = "GET"
            })
            return response.Body
        end
    end

    if syn and typeof(syn.request) == "function" then
        return function(url)
            local response = syn.request({
                Url = url,
                Method = "GET"
            })
            return response.Body
        end
    end

    if http and typeof(http.request) == "function" then
        return function(url)
            local response = http.request({
                Url = url,
                Method = "GET"
            })
            return response.Body
        end
    end

    return function(url)
        return game:HttpGet(url)
    end
end

local function FindHopServer()
    local httpGet = GetHttpRequest()
    local placeId = game.PlaceId
    local cursor = ""

    for _ = 1, 3 do
        local url = "https://games.roblox.com/v1/games/" .. tostring(placeId)
            .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local ok, body = pcall(httpGet, url)
        if ok and body then
            local decodedOk, data = pcall(function()
                return HttpService:JSONDecode(body)
            end)

            if decodedOk and data and data.data then
                for _, server in ipairs(data.data) do
                    if server.id
                        and server.id ~= game.JobId
                        and tonumber(server.playing or 0) < tonumber(server.maxPlayers or 0) then
                        return server.id
                    end
                end

                cursor = data.nextPageCursor or ""
                if cursor == "" then
                    break
                end
            else
                break
            end
        else
            break
        end
    end

    return nil
end

