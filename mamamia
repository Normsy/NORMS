function N.DetectTravelRemote()
    if not AutoTravelButton then return end
    if AutoTravelButton:GetAttribute("Busy") then return end
    AutoTravelButton:SetAttribute("Busy", true)
    AutoTravelButton.Text = "FINDING TRAVEL REMOTE..."
    AutoTravelStatus.Text = "Detecting your current island..."
    AutoTravelStatus.TextColor3 = Color3.fromRGB(251, 191, 36)

    task.spawn(function()
        local currentIsland = GetCurrentPlayerIsland()

        if not currentIsland or currentIsland == "" then
            AutoTravelStatus.Text = "Could not detect your current island."
            AutoTravelStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
            AutoTravelButton.Text = "AUTO FIND TRAVEL REMOTE"
            AutoTravelButton:SetAttribute("Busy", false)
            return
        end

        AutoTravelStatus.Text = "Testing Travel on: " .. tostring(currentIsland)
        AutoTravelStatus.TextColor3 = Color3.fromRGB(251, 191, 36)
        task.wait(0.25)

        for i = 1, 36 do
            local remote = N.FindRemoteFunction(i)
            local name = "Function" .. tostring(i)

            if remote then
                AutoTravelButton.Text = "TESTING " .. name
                AutoTravelStatus.Text = name .. " -> Travel / " .. tostring(currentIsland)

                local beforeRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local beforeCFrame = beforeRoot and beforeRoot.CFrame
                local beforePosition = beforeRoot and beforeRoot.Position

                local invokeOK = pcall(function()
                    remote:InvokeServer("Travel", currentIsland, 1)
                end)

                local moved = false
                local elapsed = 0

                while elapsed < 1 do
                    task.wait(0.05)
                    elapsed += 0.05

                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root and beforePosition and beforeCFrame then
                        local positionChanged = (root.Position - beforePosition).Magnitude > 0.05
                        local orientationChanged = (root.CFrame.LookVector - beforeCFrame.LookVector).Magnitude > 0.001
                            or (root.CFrame.UpVector - beforeCFrame.UpVector).Magnitude > 0.001
                        if positionChanged or orientationChanged then
                            moved = true
                            break
                        end
                    end
                end

                if invokeOK and moved then
                    TravelRemoteBox.Text = name
                    AutoTravelStatus.Text = "FOUND: " .. name .. " | Character moved on " .. tostring(currentIsland)
                    AutoTravelStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
                    AutoTravelButton.Text = "TRAVEL REMOTE FOUND"
                    AutoTravelButton:SetAttribute("Busy", false)
                    return
                end

                if not invokeOK then
                    AutoTravelStatus.Text = name .. " errored; testing next..."
                else
                    AutoTravelStatus.Text = name .. " did not move the character; testing next..."
                end
            else
                AutoTravelStatus.Text = name .. " not available; testing next..."
                task.wait(1)
            end
        end

        AutoTravelStatus.Text = "No Travel Remote found in Function1-Function36."
        AutoTravelStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
        AutoTravelButton.Text = "AUTO FIND TRAVEL REMOTE"
        AutoTravelButton:SetAttribute("Busy", false)
    end)
end

