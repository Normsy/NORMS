--// ============================================================================
--// 3) BETTER CURRENT-ISLAND DETECTION (nearest cached point)
--// ============================================================================
local IP = {points = {}, time = 0, rebuilding = false, lastName = nil, lastTime = 0, lastPos = nil}
local CELL = 48

local function rebuildIslands(async)
    if IP.rebuilding then return end
    IP.rebuilding = true
    pcall(function()
        local cache = {}
        local islands = Workspace:FindFirstChild("Islands")
        if islands then
            local walked = 0
            for _, island in ipairs(islands:GetChildren()) do
                if island:IsA("Folder") or island:IsA("Model") then
                    local pts, seen = {}, {}
                    local stack = {island}
                    while #stack > 0 do
                        local node = table.remove(stack)
                        for _, obj in ipairs(node:GetChildren()) do
                            walked += 1
                            if async and walked % 1500 == 0 then task.wait() end
                            if obj:IsA("BasePart") then
                                local pos = obj.Position
                                local key = (math.floor(pos.X / CELL) + 4000)
                                    + (math.floor(pos.Y / CELL) + 4000) * 8001
                                    + (math.floor(pos.Z / CELL) + 4000) * 64016001
                                if not seen[key] then
                                    seen[key] = true
                                    pts[#pts + 1] = pos
                                end
                            end
                            if #obj:GetChildren() > 0 then stack[#stack + 1] = obj end
                        end
                    end
                    if island:IsA("Model") then
                        local ok, pivot = pcall(function() return island:GetPivot() end)
                        if ok and pivot then pts[#pts + 1] = pivot.Position end
                    end
                    cache[island.Name] = pts
                end
            end
        end
        IP.points = cache
        IP.time = tick()
    end)
    IP.rebuilding = false
end

GetCurrentPlayerIsland = function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.Position
    local now = tick()
    if IP.lastPos and now - IP.lastTime < 0.4 and (pos - IP.lastPos).Magnitude < 40 then
        return IP.lastName
    end
    if next(IP.points) == nil then
        rebuildIslands(false)
    elseif now - IP.time > 180 and not IP.rebuilding then
        task.spawn(rebuildIslands, true)
    end
    local bestName, bestSq = nil, math.huge
    for name, pts in pairs(IP.points) do
        for i = 1, #pts do
            local d = pos - pts[i]
            local dsq = d:Dot(d)
            if dsq < bestSq then
                bestSq = dsq
                bestName = name
            end
        end
    end
    IP.lastName = (bestName and bestSq <= 2800 * 2800) and bestName or nil
    IP.lastTime = now
    IP.lastPos = pos
    return IP.lastName
end

