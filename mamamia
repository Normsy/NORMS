local LassoGenBtn, LassoStatus = CreateActionRow(LassoConfigCard, 52)

LassoGenBtn.MouseButton1Click:Connect(function()
    LassoStatus.Text = "Scanning..."
    LassoStatus.TextColor3 = Color3.fromRGB(251, 191, 36)
    local targetName = LassoNameBox.Text
    local foundUID = nil

    local success = pcall(function()
        local References = require(ReplicatedStorage:WaitForChild("References"))
        local Data = require(References.PlayerScripts.Priority.Data)
        local inventory = Data.GetLocal({"inventory"})
        for uid, item in pairs(inventory or {}) do
            if type(item) == "table" then
                local infoSuccess, info = pcall(function()
                    return References.Items.GetInfo(item.id)
                end)
                if infoSuccess and info and info.name:lower() == targetName:lower() then
                    foundUID = tostring(uid)
                    break
                end
            end
        end
    end)

    if not foundUID then
        local searchSpaces = {LocalPlayer, ReplicatedStorage}
        for _, space in ipairs(searchSpaces) do
            for _, obj in ipairs(space:GetDescendants()) do
                if obj.Name:lower() == targetName:lower() or (obj:IsA("StringValue") and obj.Value:lower() == targetName:lower()) then
                    local possibleUID = obj:GetAttribute("UID") or obj:GetAttribute("ID") or obj:GetAttribute("Id")
                    if possibleUID then
                        foundUID = tostring(possibleUID)
                        break
                    end
                    local idChild = obj:FindFirstChild("UID") or obj:FindFirstChild("ID")
                    if idChild and (idChild:IsA("StringValue") or idChild:IsA("NumberValue")) then
                        foundUID = tostring(idChild.Value)
                        break
                    end
                end
            end
            if foundUID then break end
        end
    end

    if foundUID then
        ConfiguredLassoUID = foundUID
        UidTextBox.Text = foundUID
        LassoStatus.Text = "UID Found"
        LassoStatus.TextColor3 = Color3.fromRGB(57, 255, 20)
        local lassoUI = findUIElement(LocalPlayer:WaitForChild("PlayerGui"), "Lasso Read Only")
        if lassoUI and (lassoUI:IsA("TextBox") or lassoUI:IsA("TextLabel")) then
            lassoUI.Text = foundUID
        end
        SavePersistentConfig()
    else
        LassoStatus.Text = "UID not found"
        LassoStatus.TextColor3 = Color3.fromRGB(239, 68, 68)
    end
end)

