local function isHorse(node)
    if not node or not node.Parent then return false end
    local tagged = CollectionService:HasTag(node, "Animal")
    local behaviour = node:GetAttribute("behaviour")
    return tagged or behaviour == "WanderingAnimal"
end

local function isOwned(node)
    for attrKey, attrVal in pairs(node:GetAttributes()) do
        if attrKey:lower() == "owner" and attrVal ~= nil and tostring(attrVal) ~= "" then
            return true
        end
    end
    return false
end

local function isInShop(node)
    local current = node
    while current and current ~= Workspace do
        local n = current.Name:lower()
        if n:find("shop", 1, true) or n:find("stable", 1, true) then
            return true
        end
        current = current.Parent
    end
    return false
end

--// BACKGROUND SCANNER
local function ScanHorses()
    local now = tick()
    if now - LastScan < SCAN_INTERVAL and #ScanCache > 0 then
        return ScanCache
    end

    local results = {}
    local islands = Workspace:FindFirstChild("Islands")
    if not islands then
        ScanCache = results
        LastScan = now
        return results
    end

    local function scanContainer(container, islandName)
        for _, node in ipairs(container:GetChildren()) do
            if isHorse(node) and not isOwned(node) and not isInShop(node) then
                local pivot = getHorsePivot(node)
                if pivot then
                    local breed, rarity = getHorseBreed(node)
                    local unique = checkUniqueHair(node)
                    local priorityStats = GetHorsePriorityStats(node)
                    table.insert(results, {
                        Model=node,
                        Island=islandName,
                        Name=breed,
                        Rarity=rarity,
                        Unique=unique,
                        UniqueCoat=priorityStats.UniqueCoat,
                        Mismatched=priorityStats.Mismatched,
                        NaturalDyed=priorityStats.NaturalDyed,
                        Horned=priorityStats.Horned,
                        Priority=priorityStats.Priority,
                        PriorityCount=priorityStats.Count,
                        Position=pivot.Position,
                        Pivot=pivot,
                        UID=(function()
                        local ok, id = pcall(function() return node:GetDebugId() end)
                        if ok and id then return id end
                        return node:GetFullName() .. "_" .. math.floor(pivot.Position.X) .. "_" .. math.floor(pivot.Position.Z)
                    end)()
                    })
                end
            elseif node:IsA("Folder") or node:IsA("Model") then
                scanContainer(node, islandName)
            end
        end
    end

    for _, island in ipairs(islands:GetChildren()) do
        if island:IsA("Folder") or island:IsA("Model") then
            scanContainer(island, island.Name)
        end
    end

    ScanCache = results
    LastScan = now
    return results
end

local function invalidate()
    ScanCache = {}
    LastScan = 0
end

