    local Joining = false
    local function JoinServer(id, playing, max)
        if Joining then return false end
        Joining = true
        HopStatus.Text = ("Joining %d/%d players..."):format(playing, max)
        TriedServers[id] = true
        local failed = false
        local conn = TeleportService.TeleportInitFailed:Connect(function() failed = true end)
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, id, LocalPlayer)
        end)
        task.wait(6)
        conn:Disconnect()
        if failed then HopStatus.Text = "Teleport failed (server full?)." end
