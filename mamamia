local function SellingNormalizeText(value)
    if value == nil then return "" end
    local text = tostring(value):lower():gsub("_", " "):gsub("-", " "):gsub("%s+", " ")
    return text:match("^%s*(.-)%s*$")
end

local function SellingFindBreedKeyword(value)
    local text = SellingNormalizeText(value)
    if text == "" then return nil end
    for _, keyword in ipairs(BreedKeywords) do
        local nk = SellingNormalizeText(keyword)
        if text == nk or text:find(nk, 1, true) then return BreedDisplayNames[keyword] end
    end
    return nil
end

local BreedFields = {"breed","Breed","breedName","BreedName","horseBreed","HorseBreed","breedType","BreedType","horseType","HorseType","animalType","AnimalType","species","Species","type","Type","name","Name","itemName","ItemName","displayName","DisplayName","Display","display"}

local function SellingSearchBreedData(tbl, depth, visited)
    if type(tbl) ~= "table" then return nil end
    depth = depth or 0; visited = visited or {}
    if depth > 10 or visited[tbl] then return nil end
    visited[tbl] = true
    for _, field in ipairs(BreedFields) do
        local value = tbl[field]
        if value ~= nil then
            local breed = SellingFindBreedKeyword(value)
            if breed then return breed end
        end
    end
    for key, value in pairs(tbl) do
        if type(value) == "table" then
            local breed = SellingSearchBreedData(value, depth + 1, visited)
            if breed then return breed end
        elseif type(value) == "string" then
            local k = SellingNormalizeText(key)
            if k:find("breed",1,true) or k:find("horse",1,true) or k:find("animal",1,true) or k:find("species",1,true) or k:find("type",1,true) or k:find("name",1,true) or k:find("item",1,true) then
                local breed = SellingFindBreedKeyword(value)
                if breed then return breed end
            end
        end
    end
    return nil
end

local function SellingGetItemInfo(item)
    if type(item) ~= "table" or not SellingReferences or not SellingReferences.Items then return nil end
    local itemId = item.id or item.ID or item.Id
    if not itemId then return nil end
    local ok, result = pcall(function() return SellingReferences.Items.GetInfo(itemId) end)
    return ok and type(result) == "table" and result or nil
end

local function SellingGetBreed(item, info)
    local breed = SellingSearchBreedData(item) or SellingSearchBreedData(info)
    if breed then return breed end
    local pId = type(item) == "table" and (item.pId or item.PId or item.pid) or nil
    if type(info) == "table" then pId = pId or info.pId or info.PId or info.pid end
    if pId and SellingReferences and SellingReferences.Items and type(SellingReferences.Items.GetInfo) == "function" then
        local ok, result = pcall(function() return SellingReferences.Items.GetInfo(pId) end)
        if ok and type(result) == "table" then return SellingSearchBreedData(result) end
    end
    return nil
end

local function SellingGetColours(item)
    if type(item) ~= "table" then return "Unknown","Unknown","Unknown" end
    local variants = item.variants or item.Variants
    if type(variants) ~= "table" then return "Unknown","Unknown","Unknown" end
    return variants.colour or variants.mainColour or variants.MainColour or "Unknown", variants.maneColour or variants.ManeColour or "Unknown", variants.tailColour or variants.TailColour or "Unknown"
end

local function SellingColoursMatch(a,b)
    if a == b then return true end
    if type(a) == "table" and type(b) == "table" then
        local function norm(t)
            local keys = {}; for k in pairs(t) do table.insert(keys,k) end
            table.sort(keys,function(x,y) return tostring(x)<tostring(y) end)
            local parts={}; for _,k in ipairs(keys) do local v=t[k]; if type(v)=="table" then v=norm(v) end; table.insert(parts,tostring(k).."="..tostring(v)) end
            return "{"..table.concat(parts,";").."}"
        end
        return norm(a)==norm(b)
    end
    return tostring(a or ""):lower():gsub("^%s+",""):gsub("%s+$","") == tostring(b or ""):lower():gsub("^%s+",""):gsub("%s+$","")
end

RefreshSellingStats = function()
    local stats = {normal=0, uniqueHair=0, uniqueCoat=0, mismatched=0, naturalDyed=0, horned=0, total=0}
    if not SellingInventoryLoaded or type(SellingInventory) ~= "table" then
        SellingStatus.Text = "Inventory unavailable"
        for _, label in pairs(SellingLabels) do label.Text = "0" end
        return stats
    end

    for _, item in pairs(SellingInventory) do
        if type(item) == "table" then
            local info = SellingGetItemInfo(item)
            if SellingGetBreed(item, info) then
                stats.total += 1
                local main, mane, tail = SellingGetColours(item)
                local variants = item.variants or item.Variants or {}
                if UniqueHairValues[NormalizePriorityValue(mane)] or UniqueHairValues[NormalizePriorityValue(tail)] then stats.uniqueHair += 1 end
                if IsOrangeMainColour(main) then stats.uniqueCoat += 1 end
                if not SellingColoursMatch(mane, tail) then stats.mismatched += 1 end
                if item.isNatDyed ~= nil then stats.naturalDyed += 1 end
                if variants.hornColour ~= nil and tostring(variants.hornColour) ~= "" then stats.horned += 1 end
                if not (UniqueHairValues[NormalizePriorityValue(mane)] or UniqueHairValues[NormalizePriorityValue(tail)])
                    and not IsOrangeMainColour(main)
                    and SellingColoursMatch(mane, tail)
                    and item.isNatDyed == nil
                    and (variants.hornColour == nil or tostring(variants.hornColour) == "") then
                    stats.normal += 1
                end
            end
        end
    end

    SellingLabels["Normal Horse"].Text = tostring(stats.normal)
    SellingLabels["Island Unique Hair"].Text = tostring(stats.uniqueHair)
    SellingLabels["Island Unique Coat"].Text = tostring(stats.uniqueCoat)
    SellingLabels["Mismatched Hair"].Text = tostring(stats.mismatched)
    SellingLabels["Natural Dyed Hair"].Text = tostring(stats.naturalDyed)
    SellingLabels["Horned"].Text = tostring(stats.horned)
    SellingLabels["Total Horse"].Text = tostring(stats.total)
    SellingStatus.Text = "Inventory counts"
    SellStatus.Text = "Remote: " .. SelectedSellRemote .. " | Filter: " .. SelectedSellCategory
    return stats
end

local function SellingItemMatchesCategory(item, info)
    if type(item) ~= "table" then return false end

    local breed = SellingGetBreed(item, info)
    if not breed then return false end

    local main, mane, tail = SellingGetColours(item)
    local variants = item.variants or item.Variants or {}
    local uniqueHair = UniqueHairValues[NormalizePriorityValue(mane)] or UniqueHairValues[NormalizePriorityValue(tail)]
    local uniqueCoat = IsOrangeMainColour(main)
    local mismatched = not SellingColoursMatch(mane, tail)
    local naturalDyed = item.isNatDyed ~= nil
    local horned = variants.hornColour ~= nil and tostring(variants.hornColour) ~= ""

    if SelectedSellCategory == "All" then return true end
    if SelectedSellCategory == "Normal Horse" then
        return not uniqueHair and not uniqueCoat and not mismatched and not naturalDyed and not horned
    end
    if SelectedSellCategory == "Natural Dyed Hair" then return naturalDyed end
    if SelectedSellCategory == "Island Unique Hair" then return uniqueHair == true end
    if SelectedSellCategory == "Island Unique Coat" then return uniqueCoat == true end
    if SelectedSellCategory == "Mismatched Hair" then return mismatched == true end
    if SelectedSellCategory == "Horned" then return horned == true end
    return false
end

