local function RefreshList()
    local horses = GetWorldHorses()
    TrackerTextLabel.Text = "Live Horse Tracker (" .. tostring(#horses) .. ")"

    table.sort(horses, function(a, b)
        local uniqueA = (a.UniqueHairText == "â")
        local uniqueB = (b.UniqueHairText == "â")
        if uniqueA ~= uniqueB then
            return uniqueA
        end
        local weightA = RarityPriority[a.Rarity] or 0
        local weightB = RarityPriority[b.Rarity] or 0
        if weightA ~= weightB then
            return weightA > weightB
        end
        return a.Distance < b.Distance
    end)

    local currentHorses = {}
    for index, horseData in ipairs(horses) do
        local uid = tostring(horseData.UID)
        currentHorses[uid] = horseData

        local entry = ScrollFrame:FindFirstChild(uid)
        if not entry then
            entry = CreateHorseEntry(horseData)
            entry.Parent = ScrollFrame
        end

        entry.LayoutOrder = index
        entry.Visible = true
        entry.RarityLabel.Text = horseData.Rarity
        entry.RarityLabel.TextColor3 = horseData.RarityColor
        entry.NameLabel.Text = horseData.Name
        entry.IslandLabel.Text = horseData.Island
        entry.UniqueHairLabel.Text = horseData.UniqueHairText
        entry.UniqueHairLabel.TextColor3 = (horseData.UniqueHairText == "â") and Color3.fromRGB(57, 255, 20) or Color3.fromRGB(239, 68, 68)

        local isTargeting = (ActiveWalkTarget == horseData.Model)
        local themeColor = Color3.fromRGB(57, 255, 20)
        entry.WalkBtn.BackgroundColor3 = isTargeting and Color3.fromRGB(225, 29, 72) or themeColor
        entry.WalkBtn.TextColor3 = isTargeting and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
        entry.WalkBtn.Text = isTargeting and "Stop" or "Catch"
    end

    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") then
            local uid = child.Name
            if not currentHorses[uid] then
                child:Destroy()
            end
        end
    end
end

--// HELPER FUNCTION: GET PLAYER'S CURRENT ISLAND NAME
local function GetCurrentPlayerIsland()
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local islandsFolder = Workspace:FindFirstChild("Islands")
    if not islandsFolder then return nil end

    for _, islandObj in ipairs(islandsFolder:GetChildren()) do
        if islandObj:IsA("Model") or islandObj:IsA("Folder") then
            local pPart = islandObj:IsA("Model") and islandObj.PrimaryPart or islandObj:FindFirstChildWhichIsA("BasePart", true)
            if pPart then
                local dist = (rootPart.Position - pPart.Position).Magnitude
                if dist < 2000 then
                    return islandObj.Name
                end
            end
        end
    end
    return nil
end

