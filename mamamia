--==================================================
-- GET BREED
--==================================================

local function GetBreed(
    item,
    info
)

    -- Search inventory item
    local breed =
        SearchBreedData(item)

    if breed then
        return breed
    end

    -- Search item definition
    breed =
        SearchBreedData(info)

    if breed then
        return breed
    end

    --==============================================
    -- pId LOOKUP
    --==============================================

    local pId

    if type(item) == "table" then

        pId =
            item.pId
            or item.PId
            or item.pid

    end

    if type(info) == "table" then

        pId =
            pId
            or info.pId
            or info.PId
            or info.pid

    end

    if pId
        and References
        and References.Items
        and type(
            References.Items.GetInfo
        ) == "function" then

        local ok, result =
            pcall(function()

                return References.Items.GetInfo(
                    pId
                )

            end)

        if ok and type(result) == "table" then

            breed =
                SearchBreedData(result)

            if breed then
                return breed
            end

        end

    end

    return nil
end

