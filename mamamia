    local function MakeRow(i, h)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -6, 0, 30)
        row.BackgroundColor3 = Color3.fromRGB(33, 33, 39)
        row.BorderSizePixel = 0
        row.LayoutOrder = i
        row.Parent = list
        local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0, 6); rc.Parent = row

        local name = Instance.new("TextLabel")
        name.BackgroundTransparency = 1
        name.Position = UDim2.fromOffset(8, 1)
        name.Size = UDim2.new(1, -60, 0, 15)
        name.Font = Enum.Font.GothamBold
        name.TextSize = 10
        name.TextColor3 = Color3.fromRGB(236, 236, 241)
        name.TextXAlignment = Enum.TextXAlignment.Left
        name.Text = tostring(h.Name)
        name.Parent = row

        local tag = PriorityTags[h.Priority]
        local isl = Instance.new("TextLabel")
        isl.BackgroundTransparency = 1
        isl.Position = UDim2.fromOffset(8, 15)
        isl.Size = UDim2.new(1, -16, 0, 13)
        isl.Font = Enum.Font.Gotham
        isl.TextSize = 9
        isl.TextColor3 = Color3.fromRGB(150, 155, 165)
        isl.TextXAlignment = Enum.TextXAlignment.Left
        isl.Text = tostring(h.Island) .. (tag and ("  |  " .. tag) or "")
        isl.Parent = row

        local rar = Instance.new("TextLabel")
        rar.BackgroundTransparency = 1
        rar.Position = UDim2.new(1, -54, 0, 1)
        rar.Size = UDim2.fromOffset(48, 15)
        rar.Font = Enum.Font.GothamBold
        rar.TextSize = 10
        rar.TextXAlignment = Enum.TextXAlignment.Right
        rar.TextColor3 = RarityColors[h.Rarity] or RarityColors.Low
        rar.Text = string.upper(tostring(h.Rarity))
        rar.Parent = row
    end

    local function RefreshDashboard()
        local horses = {}
        for _, h in ipairs(ScanHorses()) do
            if h.Model and h.Model.Parent then table.insert(horses, h) end
        end
        table.sort(horses, function(a, b)
            local ra, rb = RarityOrder[a.Rarity] or 0, RarityOrder[b.Rarity] or 0
            if ra ~= rb then return ra > rb end
            if a.Name ~= b.Name then return tostring(a.Name) < tostring(b.Name) end
            return tostring(a.Island) < tostring(b.Island)
        end)

        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end

        local islandSet, islandCount = {}, 0
        for i, h in ipairs(horses) do
            if not islandSet[h.Island] then
                islandSet[h.Island] = true
                islandCount += 1
            end
            if i <= 80 then MakeRow(i, h) end
        end
        header.Text = "SCANNED HORSES  |  " .. #horses .. " on " .. islandCount .. " islands"
    end

    task.spawn(function()
        while gui.Parent do
            if dash.Visible then pcall(RefreshDashboard) end
            task.wait(1.5)
        end
    end)

    -- Only show the dashboard on the Main tab and when not minimized
    local baseSetTab, baseSetMinimized = SetTab, SetMinimized
    SetTab = function(n)
        baseSetTab(n)
        dash.Visible = (n == "Main") and not minimized
    end
    SetMinimized = function(v)
        baseSetMinimized(v)
        dash.Visible = (not v) and ActiveTab == "Main"
    end

    -- Auto-fit the whole window to the screen (small phone screens)
    local uiScale = frame:FindFirstChildOfClass("UIScale")
    local function Fit()
        local cam = Workspace.CurrentCamera
        if not cam or not uiScale then return end
        local vs = cam.ViewportSize
        uiScale.Scale = math.clamp(math.min((vs.Y - 20) / 270, (vs.X - 20) / 270), 0.5, 1)
    end
    task.delay(0.4, Fit)
    if Workspace.CurrentCamera then
        Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(Fit)
    end
end

