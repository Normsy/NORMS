local RovingIslandOrder = {"Volcano Island", "Lunar Island", "Jungle Island"}

local function GetRovingIslandName(name)
    if name == "Lunar Islands" then return "Lunar Island" end
    return name
end

local function GetRovingRoute(name)
    name = GetRovingIslandName(name)
    return RovingRoutes[name]
end

local function GetBestRovingHorse(horses)
    table.sort(horses, function(a, b)
        local uniqueA = a.UniqueHairText ~= nil and a.UniqueHairText ~= ""
        local uniqueB = b.UniqueHairText ~= nil and b.UniqueHairText ~= ""
        if uniqueA ~= uniqueB then return uniqueA end
        local weightA = RarityPriority[a.Rarity] or 0
        local weightB = RarityPriority[b.Rarity] or 0
        if weightA ~= weightB then return weightA > weightB end
        return a.Distance < b.Distance
    end)
    return horses[1]
end

local function CancelRoving()
    RovingGeneration += 1
    if RovingTween then
        pcall(function() RovingTween:Cancel() end)
        RovingTween = nil
    end
    RovingActive = false
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
    if hum then hum.PlatformStand = false end
    if char then pcall(function() DisableNoClip(char) end) end
end

local function TravelToRovingIsland(islandName)
    local canonicalName = GetRovingIslandName(islandName)
    local islands = Workspace:FindFirstChild("Islands")
    local islandFolder = islands and (islands:FindFirstChild(canonicalName) or islands:FindFirstChild(islandName))
    if not islandFolder then return false end

    local remoteName = TravelRemoteBox and TravelRemoteBox.Text or ""
    if remoteName == "" then
        if StatusText then StatusText.Text = "STATUS: Enter Travel Remote first" end
        return false
    end

    local travelFunc = Functions:FindFirstChild(remoteName)
    if not travelFunc then return false end

    if StatusText then
        StatusText.Text = "STATUS: Traveling to " .. canonicalName .. "..."
        StatusText.TextColor3 = Color3.fromRGB(251, 191, 36)
    end

    local ok = pcall(function()
        travelFunc:InvokeServer("Travel", canonicalName, 1)
    end)
    if not ok then return false end

    local start = tick()
    while tick() - start < 15 do
        if not RovingEnabled then return false end
        local horses = GetWorldHorses()
        if #horses > 0 then return true end
        if GetCurrentPlayerIsland() == canonicalName then return true end
        task.wait(0.2)
    end
    return GetCurrentPlayerIsland() == canonicalName
end

local function TweenRovingCheckpoint(checkpoint, generation)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return false end

    local distance = (root.Position - checkpoint.Position).Magnitude
    local tweenTime = math.max(distance / TWEEN_SPEED, 0.05)

    pcall(function() EnableNoClip(char) end)
    hum.PlatformStand = true
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    root.Anchored = true

    local tween = TweenService:Create(root, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {CFrame = checkpoint})
    RovingTween = tween
    tween:Play()

    while tween.PlaybackState == Enum.PlaybackState.Playing do
        if generation ~= RovingGeneration or not RovingEnabled or not AutoFarmEnabled then
            tween:Cancel()
            return false
        end
        local horses = GetWorldHorses()
        if #horses > 0 then
            tween:Cancel()
            local horse = GetBestRovingHorse(horses)
            ActiveWalkTarget = horse.Model
            ActiveTargetIsland = horse.Island
            TargetUID = horse.UID
            return false
        end
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        task.wait(0.05)
    end

    return generation == RovingGeneration and RovingEnabled and AutoFarmEnabled
end

local function StartRoving()
    if RovingActive or not RovingEnabled or not AutoFarmEnabled then return end
    RovingActive = true
    local generation = RovingGeneration + 1
    RovingGeneration = generation

    task.spawn(function()
        local success, err = pcall(function()
            local orderIndex = 1
            local currentIsland = GetRovingIslandName(GetCurrentPlayerIsland())
            for i, name in ipairs(RovingIslandOrder) do
                if name == currentIsland then
                    orderIndex = i
                    break
                end
            end

            while RovingEnabled and AutoFarmEnabled and generation == RovingGeneration and not ActiveWalkTarget do
                local routeIsland = RovingIslandOrder[orderIndex]
                local route = GetRovingRoute(routeIsland)
                if route then
                    if GetRovingIslandName(GetCurrentPlayerIsland()) ~= routeIsland then
                        if not TravelToRovingIsland(routeIsland) then
                            break
                        end
                    end

                    for _, checkpoint in ipairs(route) do
                        if not RovingEnabled or not AutoFarmEnabled or generation ~= RovingGeneration or ActiveWalkTarget then break end
                        local horses = GetWorldHorses()
                        if #horses > 0 then
                            local horse = GetBestRovingHorse(horses)
                            ActiveWalkTarget = horse.Model
                            ActiveTargetIsland = horse.Island
                            TargetUID = horse.UID
                            break
                        end
                        TweenRovingCheckpoint(checkpoint, generation)
                    end
                end

                if ActiveWalkTarget then break end
                orderIndex = (orderIndex % #RovingIslandOrder) + 1
                if not TravelToRovingIsland(RovingIslandOrder[orderIndex]) then break end
            end
        end)

        if not success then warn("[ROVING ERROR]", err) end
        if generation == RovingGeneration then RovingActive = false end
    end)
end
