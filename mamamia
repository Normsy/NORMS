local function RebuildDropdownOptions()
    for _, child in ipairs(SortDropdownList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local options = {"All Islands"}
    local seen = {["All Islands"] = true}
    
    local islands = Workspace:FindFirstChild("Islands")
    if islands then
        for _, folder in ipairs(islands:GetChildren()) do
            if (folder:IsA("Folder") or folder:IsA("Model")) and not seen[folder.Name] then
                seen[folder.Name] = true
                table.insert(options, folder.Name)
            end
        end
    end
    
    for _, islandName in ipairs(ManualIslandList) do
        if not seen[islandName] then
            seen[islandName] = true
            table.insert(options, islandName)
        end
    end

    for _, mode in ipairs(options) do
        local sOptBtn = Instance.new("TextButton")
        sOptBtn.Name = mode
        sOptBtn.Size = UDim2.new(1, 0, 0, 16)
        sOptBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
        sOptBtn.BorderSizePixel = 0
        sOptBtn.ZIndex = 26
        sOptBtn.Text = mode
        sOptBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
        sOptBtn.TextSize = 6
        sOptBtn.Font = Enum.Font.Gotham
        sOptBtn.Parent = SortDropdownList

        sOptBtn.MouseButton1Click:Connect(function()
            SelectedMainIsland = mode
            SortBtn.Text = "Island: " .. mode .. " v"
            IsSortDropdownOpen = false
            SortDropdownList.Visible = false
            ClearCache()
            SavePersistentConfig()
        end)
    end
end
