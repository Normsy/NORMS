local function DetectSellRemote()
    if not AutoSellRemoteButton then return end
    if AutoSellRemoteButton:GetAttribute("Busy") then return end
    AutoSellRemoteButton:SetAttribute("Busy", true)
    AutoSellRemoteButton.Text = "FINDING SELL REMOTE..."
    AutoSellRemoteStatus.Text = "Getting one Normal Horse to use as the test target..."
    AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(251, 191, 36)

    task.spawn(function()
        -- Get one fresh inventory snapshot only when the detector starts.
        local testUID
        for attempt = 1, 40 do
            local inv = ReadLocalInventory()
            if type(inv) == "table" then
                SellingInventory = inv
                SellingInventoryLoaded = true
                testUID = FindNormalHorseUID(inv)
                if testUID then break end
            end
            AutoSellRemoteStatus.Text = "Looking for Normal Horse... " .. tostring(attempt) .. "/40"
            task.wait(0.5)
        end

        if not testUID then
            AutoSellRemoteStatus.Text = "No Normal Horse available for testing."
            AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(255, 190, 100)
            AutoSellRemoteButton.Text = "AUTO FIND SELL REMOTE"
            AutoSellRemoteButton:SetAttribute("Busy", false)
            return
        end

        AutoSellRemoteStatus.Text = "Target UID: " .. tostring(testUID) .. " | Testing Event1-90"

        for i = 1, 90 do
            local event = FindRemoteEvent(i)
            local eventName = "Event" .. tostring(i)

            if event then
                -- IMPORTANT: each Event test uses the SAME target Normal Horse UID.
                -- Do not spam inventory refreshes before the test.
                AutoSellRemoteStatus.Text = "Testing " .. eventName .. " with target Normal Horse..."

                -- Exact captured sell payload.
                local fireOK, fireErr = pcall(function()
                    event:FireServer("SellItems", {[testUID] = 1})
                end)

                -- AFTER EVERY TEST: wait briefly for the inventory state to
                -- replicate, then take ONE fresh inventory snapshot. Do not
                -- recalculate all inventory statistics during remote detection.
                task.wait(0.35)
                local refreshedInventory = ReadLocalInventory()
                local sold = false

                if type(refreshedInventory) == "table" then
                    SellingInventory = refreshedInventory
                    SellingInventoryLoaded = true
                    sold = not InventoryHasUID(refreshedInventory, testUID)
                end

                if fireOK and sold then
                    SelectedSellRemote = eventName
                    RemoteDrop.Text = "Remote: " .. eventName
                    SellStatus.Text = "Remote: " .. eventName .. " | Filter: " .. SelectedSellCategory
                    AutoSellRemoteStatus.Text = "FOUND: " .. eventName .. " | Target UID is gone"
                    AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(100, 255, 130)
                    AutoSellRemoteButton.Text = "SELL REMOTE FOUND"
                    AutoSellRemoteButton:SetAttribute("Busy", false)
                    return
                elseif not fireOK then
                    AutoSellRemoteStatus.Text = eventName .. " failed: " .. tostring(fireErr)
                elseif type(refreshedInventory) ~= "table" then
                    AutoSellRemoteStatus.Text = eventName .. " tested | inventory refresh failed"
                else
                    AutoSellRemoteStatus.Text = eventName .. " tested | target still in inventory"
                end
            end

            -- Keep the existing interval between Event tests.
            task.wait(0.5)
        end

        AutoSellRemoteStatus.Text = "No working Sell Remote in Event1-90."
        AutoSellRemoteStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
        AutoSellRemoteButton.Text = "AUTO FIND SELL REMOTE"
        AutoSellRemoteButton:SetAttribute("Busy", false)
    end)
end

