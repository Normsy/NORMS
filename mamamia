local PATROL_HEIGHT_OFFSET = 3     -- studs above each spawn point
local SCAN_PAUSE = 0.7             -- seconds to wait at each point so horses can stream in/scan

local routeIdx, pointIdx = 1, 1
local patrolTween = nil

local function patrolStatus(text)
    if StatusText then
        StatusText.Text = text
        StatusText.TextColor3 = Color3.fromRGB(96, 165, 250)
    end
end

local function anyHorse()
    local ok, list = pcall(GetWorldHorses)
    return ok and type(list) == "table" and #list > 0
end

-- true when patrol must stop what it is doing
local function interrupted()
    return (not AutoFarmEnabled) or ActiveWalkTarget ~= nil or anyHorse()
end

local function getChar()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if root and hum and hum.Health > 0 then
        return char, root, hum
    end
    return nil
end

local function release()
    if patrolTween then
        pcall(function() patrolTween:Cancel() end)
        patrolTween = nil
    end
    local char, root, hum = getChar()
    pcall(function()
        if root then
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        if hum then hum.PlatformStand = false end
    end)
    DisableNoClip(char or LocalPlayer.Character)
end

-- returns true if we are on the island (or got there), false if interrupted / failed
local function ensureIsland(island)
    if GetCurrentPlayerIsland() == island then return true end

    local travelName = TravelRemoteBox.Text
    local travelFunc = travelName ~= "" and Functions:FindFirstChild(travelName)
    if not travelFunc then
        patrolStatus("PATROL: Generate Travel Remote first")
        task.wait(2)
        return false
    end

    patrolStatus("PATROL: Traveling to " .. island .. "...")
    local ok = pcall(function()
        return travelFunc:InvokeServer("Travel", island, 1)
    end)
    if not ok then
        patrolStatus("PATROL: Travel failed")
        task.wait(2)
        return false
    end

    local t0 = tick()
    while tick() - t0 < 15 do
        if interrupted() then return false end
        if GetCurrentPlayerIsland() == island or tick() - t0 > 3 then break end
        task.wait(0.2)
    end
    return true
end

-- returns true if we reached the point, false if interrupted
local function tweenToPoint(pos, label)
    local char, root, hum = getChar()
    if not root then task.wait(1) return false end

    EnableNoClip(char)
    hum.PlatformStand = true
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    root.Anchored = true

    local targetCF = CFrame.new(pos + Vector3.new(0, PATROL_HEIGHT_OFFSET, 0))
    local dist = (root.Position - targetCF.Position).Magnitude
    patrolTween = TweenService:Create(
        root,
        TweenInfo.new(math.max(dist / TWEEN_SPEED, 0.1), Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = targetCF}
    )
    patrolTween:Play()
    patrolStatus("PATROL: " .. label)

    local lastScan = 0
    while patrolTween and patrolTween.PlaybackState == Enum.PlaybackState.Playing do
        if not AutoFarmEnabled or ActiveWalkTarget or hum.Health <= 0 then
            return false
        end
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        if tick() - lastScan > 0.25 then
            lastScan = tick()
            if anyHorse() then return false end
        end
        task.wait(0.03)
    end
    patrolTween = nil

    -- short pause so nearby horses can load and get scanned
    local t0 = tick()
    while tick() - t0 < SCAN_PAUSE do
        if interrupted() then return false end
        task.wait(0.1)
    end
    return true
end

local function advance()
    pointIdx += 1
    if pointIdx > #Route[routeIdx].Points then
        pointIdx = 1
        routeIdx = routeIdx % #Route + 1
        -- Jungle -> Lunar -> Volcano -> back to Jungle
    end
end

task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.25)

        if AutoFarmEnabled and not ActiveWalkTarget and getChar() and not anyHorse() then
            pcall(function()
                local stop = Route[routeIdx]
                local pos = stop.Points[pointIdx]
                local label = string.format("%s point %d/%d", stop.Island, pointIdx, #stop.Points)

                if not ensureIsland(stop.Island) then return end
                if interrupted() then return end

                if tweenToPoint(pos, label) then
                    advance()          -- reached it, nothing found -> next spawn point
                end
                -- if interrupted, pointIdx is NOT advanced: the patrol resumes at this
                -- same point once the horse is caught and nothing else is scanned
            end)

            -- if the main engine took over a horse, leave movement/noclip to it
            if not interrupted() or not AutoFarmEnabled then
                release()
            else
                task.wait(0.2)
                if not ActiveWalkTarget then release() end
            end
        end
    end
end)

