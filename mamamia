local function DecodeHorseData(horse)
    local data = horse:GetAttribute("Data")
    if type(data) == "string" then
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(data)
        end)
        if ok then data = decoded end
    end
    if type(data) ~= "table" then
        return nil
    end
    return data
end

local function NormalizePriorityValue(value)
    return tostring(value or ""):lower():gsub("[%s_%-]", "")
end

local function ColoursMatchPriority(a, b)
    if a == b then return true end
    if type(a) == "table" and type(b) == "table" then
        local function NormalizeTable(t)
            local keys = {}
            for k in pairs(t) do table.insert(keys, k) end
            table.sort(keys, function(x,y) return tostring(x) < tostring(y) end)
            local parts = {}
            for _, k in ipairs(keys) do
                local v = t[k]
                if type(v) == "table" then v = NormalizeTable(v) end
                table.insert(parts, tostring(k).."="..tostring(v))
            end
            return "{"..table.concat(parts, ";").."}"
        end
        return NormalizeTable(a) == NormalizeTable(b)
    end
    local function NormalizeColour(v)
        return tostring(v or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
    end
    return NormalizeColour(a) == NormalizeColour(b)
end

local function GetHorsePriorityStats(horse)
    local data = DecodeHorseData(horse)
    if not data then
        return {UniqueHair=false, UniqueCoat=false, Mismatched=false, NaturalDyed=false, Horned=false, Priority=6, Count=0}
    end

    local variants = data.variants
    if type(variants) ~= "table" then
        return {UniqueHair=false, UniqueCoat=false, Mismatched=false, NaturalDyed=false, Horned=false, Priority=6, Count=0}
    end

    local main = variants.colour or variants.mainColour or variants.MainColour
    local mane = variants.maneColour or variants.ManeColour
    local tail = variants.tailColour or variants.TailColour
    local unique = UniqueHairValues[NormalizePriorityValue(mane)] or UniqueHairValues[NormalizePriorityValue(tail)] or false
    local uniqueCoat = IsOrangeMainColour(main)
    local mismatch = not ColoursMatchPriority(mane, tail)
    local naturalDyed = data.isNatDyed ~= nil
    local hornColour = variants.hornColour
    local horned = hornColour ~= nil and tostring(hornColour) ~= ""

    -- Lower number = higher catch priority.
    local priority = 6
    if unique then priority = 1
    elseif mismatch then priority = 2
    elseif uniqueCoat then priority = 3
    elseif naturalDyed then priority = 4
    elseif horned then priority = 5
    end

    local count = 0
    if unique then count += 1 end
    if uniqueCoat then count += 1 end
    if mismatch then count += 1 end
    if naturalDyed then count += 1 end
    if horned then count += 1 end

    return {
        UniqueHair=unique,
        UniqueCoat=uniqueCoat,
        Mismatched=mismatch,
        NaturalDyed=naturalDyed,
        Horned=horned,
        Priority=priority,
        Count=count
    }
end

