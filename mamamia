--==================================================
-- SEARCH TABLE FOR BREED
--==================================================

local function SearchBreedData(
    tbl,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end

    depth = depth or 0
    visited = visited or {}

    if depth > 10 then
        return nil
    end

    if visited[tbl] then
        return nil
    end

    visited[tbl] = true

    --==============================================
    -- CHECK EXPLICIT BREED FIELDS FIRST
    --==============================================

    for _, field in ipairs(
        BreedFields
    ) do

        local value =
            tbl[field]

        if value ~= nil then

            local breed =
                FindBreedKeyword(value)

            if breed then
                return breed
            end

        end

    end

    --==============================================
    -- SEARCH ALL NESTED DATA
    --==============================================

    for key, value in pairs(tbl) do

        if type(value) == "table" then

            local breed =
                SearchBreedData(
                    value,
                    depth + 1,
                    visited
                )

            if breed then
                return breed
            end

        elseif type(value) == "string" then

            local normalizedKey =
                NormalizeText(key)

            local relevant =
                normalizedKey:find(
                    "breed",
                    1,
                    true
                )

                or normalizedKey:find(
                    "horse",
                    1,
                    true
                )

                or normalizedKey:find(
                    "animal",
                    1,
                    true
                )

                or normalizedKey:find(
                    "species",
                    1,
                    true
                )

                or normalizedKey:find(
                    "type",
                    1,
                    true
                )

                or normalizedKey:find(
                    "name",
                    1,
                    true
                )

                or normalizedKey:find(
                    "item",
                    1,
                    true
                )

            if relevant then

                local breed =
                    FindBreedKeyword(value)

                if breed then
                    return breed
                end

            end

        end

    end

    return nil
end

