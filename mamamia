local function GetHorseWebhookLine(horse)
    local main, mane, tail = GetColours(horse.item)
    local variants = horse.item.variants or horse.item.Variants or {}
    local breed = horse.breed or GetBreed(horse.item, horse.info) or "Unknown"

    local detail = "Main: "..tostring(main)
        .." â¢ Mane: "..tostring(mane)
        .." â¢ Tail: "..tostring(tail)

    if variants.hornColour ~= nil and tostring(variants.hornColour) ~= "" then
        detail = detail.." â¢ Horn: "..tostring(variants.hornColour)
    end

    if horse.item.isNatDyed ~= nil then
