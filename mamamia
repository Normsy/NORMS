function N.FindNormalHorseUID(inv)
    if type(inv) ~= "table" then return nil end
    for uid, item in pairs(inv) do
        if type(item) == "table" then
            local info = N.SellingGetItemInfo(item)
            if N.SellingGetBreed(item, info) then
                local main, mane, tail = N.SellingGetColours(item)
                local variants = item.variants or item.Variants or {}
                local unique = N.UniqueHairValues[N.NormalizePriorityValue(mane)] or N.UniqueHairValues[N.NormalizePriorityValue(tail)]
                local coat = N.IsOrangeMainColour(main)
                local mismatch = not N.SellingColoursMatch(mane, tail)
                local nat = item.isNatDyed ~= nil
                local horn = variants.hornColour ~= nil and tostring(variants.hornColour) ~= ""
                if not unique and not coat and not mismatch and not nat and not horn then
                    return tostring(uid)
                end
            end
        end
    end
    return nil
end


function N.FindRemoteFunction(index)
