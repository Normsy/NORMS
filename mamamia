local function ToggleMinimize()
    if IsAnimating then return end
    IsAnimating = true

    if not IsMinimized then
        TabBar.Visible = false
        LeftPanel.Visible = false
        RightPanel.Visible = false
        local tween1 = TweenService:Create(
            Frame,
            TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
            { Size = UDim2.fromOffset(2, 220), Position = UDim2.new(0.5, -1, 0.5, -110) }
        )
        tween1:Play()
        tween1.Completed:Wait()
        local tween2 = TweenService:Create(
            Frame,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0.5, -30, 0.5, -30) }
        )
        tween2:Play()
        tween2.Completed:Wait()
        TitleBar.Visible = false
        MinimizedSquare.Visible = true
        IsMinimized = true
    else
        MinimizedSquare.Visible = false
        local tween1 = TweenService:Create(
            Frame,
            TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
            { Size = UDim2.fromOffset(2, 220), Position = UDim2.new(0.5, -1, 0.5, -110) }
        )
        tween1:Play()
        tween1.Completed:Wait()
        local tween2 = TweenService:Create(
            Frame,
            TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
            { Size = UDim2.fromOffset(450, 220), Position = UDim2.new(0.5, -225, 0.5, -110) }
        )
        tween2:Play()
        tween2.Completed:Wait()
        TitleBar.Visible = true
        TabBar.Visible = true
        LeftPanel.Visible = true
        RightPanel.Visible = true
        IsMinimized = false
    end
    IsAnimating = false
end

