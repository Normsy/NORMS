function A.refreshCounts()
    local c = {u = 0, co = 0, m = 0, d = 0, h = 0, n = 0, t = 0}
    if S.Loaded and type(S.Inventory) == "table" then
        for _, item in pairs(S.Inventory) do
            if type(item) == "table" and A.isHorse(item) then
                c.t += 1
                local u, co, m, d, h = A.itemTraits(item)
                if u then c.u += 1 end
                if co then c.co += 1 end
                if m then c.m += 1 end
                if d then c.d += 1 end
                if h then c.h += 1 end
                if not (u or co or m or d or h) then c.n += 1 end
            end
        end
    end
    local L = S.CountLabels
    L["Island Unique Hair"].Text = tostring(c.u)
    L["Island Unique Coat"].Text = tostring(c.co)
    L["Mismatched Hair"].Text = tostring(c.m)
    L["Natural Dyed Hair"].Text = tostring(c.d)
    L["Horned"].Text = tostring(c.h)
    L["Normal Horse"].Text = tostring(c.n)
    L["Total Horse"].Text = tostring(c.t)
end

function A.refreshInv()
    if S.Busy then return end
    S.Busy = true
    S.RefreshBtn.Text = "..."
    task.spawn(function()
