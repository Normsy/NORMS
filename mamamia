--// REMOTE CATCHING
-- Catching no longer uses simulated screen/mouse clicks. The selected RemoteEvent
-- is fired directly with the configured lasso UID and current horse model.
function FireCatchRemote(horseModel)
    local remoteName = tostring(CatchConfig.SelectedCatchRemote or (CatchConfig.CatchRemoteBox and CatchConfig.CatchRemoteBox.Text) or ""):match("^%s*(.-)%s*$")
    if remoteName == "" then
        return false, "Select a Catch Remote in Settings"
    end
    if tostring(CatchConfig.ConfiguredLassoUID or "") == "" then
        return false, "Generate Lasso UID in Settings"
    end

    local comm = ReplicatedStorage:FindFirstChild("Communication")
    local eventsFolder = comm and comm:FindFirstChild("Events")
    local catchEvent = eventsFolder and eventsFolder:FindFirstChild(remoteName)
    if not catchEvent or not catchEvent:IsA("RemoteEvent") then
        return false, "Catch Remote not found: " .. remoteName
    end

    local ok, err = pcall(function()
        catchEvent:FireServer(CatchConfig.ConfiguredLassoUID, "Activate", horseModel)
    end)
    if not ok then
        return false, tostring(err)
    end
    return true
end

