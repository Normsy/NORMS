    return
        mainColour or "Unknown",
        maneColour or "Unknown",
        tailColour or "Unknown"
end

-- Compare Mane and Tail only. Main Colour is intentionally NOT part of mismatch detection.
-- This prevents identical colour tables/values from being marked blue
-- just because tostring(table) produces different memory addresses.
local function ColoursMatch(a, b)

    if a == b then
        return true
    end

    if type(a) == "table" and type(b) == "table" then

        local function NormalizeTable(t)
            local keys = {}

            for k in pairs(t) do
                table.insert(keys, k)
            end

            table.sort(keys, function(x, y)
                return tostring(x) < tostring(y)
            end)

            local parts = {}

            for _, k in ipairs(keys) do
                local v = t[k]

                if type(v) == "table" then
                    v = NormalizeTable(v)
                end

                table.insert(parts, tostring(k) .. "=" .. tostring(v))
            end

            return "{" .. table.concat(parts, ";") .. "}"
        end

        return NormalizeTable(a) == NormalizeTable(b)
    end

    local function NormalizeColour(value)
        return tostring(value or "")
            :lower()
            :gsub("^%s+", "")
            :gsub("%s+$", "")
    end

    return NormalizeColour(a) == NormalizeColour(b)
end

