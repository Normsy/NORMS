local Dragging, DragStart, StartPos
local minDragStart = nil
local hasMoved = false

TitleBar.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not IsMinimized then
        Dragging = true
        DragStart = input.Position
        StartPos = Frame.Position
    end
end)

MinimizedSquare.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and IsMinimized then
        Dragging = true
        minDragStart = input.Position
        StartPos = Frame.Position
        hasMoved = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        if IsMinimized and minDragStart then
            local delta = input.Position - minDragStart
            if delta.Magnitude > 5 then
                hasMoved = true
            end
            Frame.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
        elseif not IsMinimized and DragStart then
            local delta = input.Position - DragStart
            Frame.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if Dragging then
            if IsMinimized and not hasMoved then
                ToggleMinimize()
            end
            Dragging = false
            minDragStart = nil
        end
    end
end)

local function IsInShop(node)
    local current = node
    while current and current ~= Workspace do
        local nameLower = string.lower(current.Name)
        if nameLower:find("shop") or nameLower:find("barn") or nameLower:find("store") then
            return true
        end
        current = current.Parent
    end
    return false
end

--// RECURSIVE HORSE SCAN ENGINE
local function GetWorldHorses()
    local currentTime = tick()
    if currentTime - LastScanTick < 0.03 and next(HorseCache) ~= nil then
        return HorseCache
    end

    local horses = {}
    local islands = Workspace:FindFirstChild("Islands")
    if not islands then return horses end

    local foldersToScan = {}
    if SelectedMainIsland == "All Islands" then
        for _, folder in ipairs(islands:GetChildren()) do
            if folder:IsA("Folder") or folder:IsA("Model") then
                table.insert(foldersToScan, folder)
            end
        end
    else
        local targetFolder = islands:FindFirstChild(SelectedMainIsland)
        if targetFolder then
            table.insert(foldersToScan, targetFolder)
        end
    end

    local function ScanContainer(container, islandName)
        for _, node in ipairs(container:GetChildren()) do
            if node:IsA("Folder") or (node:IsA("Model") and not CollectionService:HasTag(node, "Animal")) then
                ScanContainer(node, islandName)
            else
                local isAnimal = CollectionService:HasTag(node, "Animal")
                local behaviourAttr = node:GetAttribute("behaviour")
                if isAnimal or behaviourAttr == "WanderingAnimal" then
                    local hasOwner = false
                    for attrKey, attrVal in pairs(node:GetAttributes()) do
                        if attrKey:lower() == "owner" and attrVal ~= nil and attrVal ~= "" then
                            hasOwner = true
                            break
                        end
                    end
                    if not hasOwner and not IsInShop(node) then
                        if node.Parent then
                            local pivot = node:IsA("Model") and node:GetPivot() or (node:IsA("BasePart") and node.CFrame)
                            if pivot then
                                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                local dist = hrp and math.floor((hrp.Position - pivot.Position).Magnitude) or 0
                                local displayBreedName = node.Name
                                pcall(function()
                                    local overheadPart = node:FindFirstChild("OverheadPart")
                                    if overheadPart then
                                        local overhead = overheadPart:FindFirstChild("Overhead")
                                        if overhead then
                                            local breedLabel = overhead:FindFirstChild("BreedLabel")
                                            if breedLabel and breedLabel:IsA("TextLabel") and breedLabel.Text ~= "" then
                                                displayBreedName = breedLabel.Text
                                            end
                                        end
                                    end
                                end)
                                local finalBreedName, rarityName, rarityColor = GetHorseInfo(displayBreedName)
                                local hasUniqueHair, uniqueHairText = checkUniqueHair(node)
                                if RarityFilters[rarityName] then
                                    table.insert(horses, {
                                        Model = node,
                                        UID = node.Name .. "_" .. tostring(math.floor(pivot.Position.X)) .. "_" .. tostring(math.floor(pivot.Position.Z)),
                                        Name = finalBreedName,
                                        Rarity = rarityName,
                                        RarityColor = rarityColor,
                                        Island = islandName,
                                        UniqueHairText = uniqueHairText,
                                        Position = pivot.Position,
                                        Pivot = pivot,
                                        Distance = dist
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    for _, islandFolder in ipairs(foldersToScan) do
        ScanContainer(islandFolder, islandFolder.Name)
    end

    HorseCache = horses
    LastScanTick = currentTime
    return horses
end

--// LIVE SCAN INVALIDATION
-- Invalidate the cached horse list whenever the world changes.
-- This keeps the Tracker responsive to newly spawned/removed horses without
-- forcing the Auto engine to be toggled off and on again.
local function HookIslandFolderForLiveRefresh(islandsFolder)
    if not islandsFolder then return end

    local function hook(container)
        if not container then return end
        container.ChildAdded:Connect(function()
            ClearCache()
        end)
        container.ChildRemoved:Connect(function()
            ClearCache()
        end)
    end

    hook(islandsFolder)
    for _, island in ipairs(islandsFolder:GetChildren()) do
        if island:IsA("Folder") or island:IsA("Model") then
            hook(island)
        end
    end

    islandsFolder.ChildAdded:Connect(function(island)
        ClearCache()
        if island:IsA("Folder") or island:IsA("Model") then
            hook(island)
        end
    end)
    islandsFolder.ChildRemoved:Connect(function()
        ClearCache()
    end)
end

local IslandsForLiveRefresh = Workspace:FindFirstChild("Islands")
if IslandsForLiveRefresh then
    HookIslandFolderForLiveRefresh(IslandsForLiveRefresh)
else
    task.spawn(function()
        local islands = Workspace:WaitForChild("Islands", 10)
        if islands then
            HookIslandFolderForLiveRefresh(islands)
        end
    end)
end

