--// FIXED SELL FUNCTION
--// Pass 1 sends EVERY matching horse in one request (same as the reference selling script).
--// Anything still in the inventory afterwards is retried in batches of 40; a batch that sells
--// nothing is split in half to find the horse the server refuses (locked / favorited).
--// A horse is only skipped after it was refused twice, so nothing is dropped by mistake.
function A.sell(isAuto)
    local st = S.SellStatus
    if S.Selling then
        setStatus(st, "Already selling, please wait...", C.amber)
        return
    end
    if isAuto and S.Category == "All" then
        setStatus(st, "Auto sell skipped: filter is All", C.amber)
        return
    end
    local remote = Events:FindFirstChild(S.Remote)
    if not remote or not remote:IsA("RemoteEvent") then
        setStatus(st, S.Remote .. " is not a RemoteEvent. Press Generate in Settings > Sell Remote.", C.red)
        return
    end

    S.Selling = true
    S.SellBtn.Text = "SELLING..."
    local category = S.Category

    task.spawn(function()
        local sold, skipped = 0, 0
        local BATCH = 40
        local batchSize = math.huge   -- first pass: ONE request with every match
        local failed = {}             -- uid -> true (refused twice)

        local function collect(inv)
            local list = {}
            for uid, item in pairs(inv) do
                if not failed[uid] and type(item) == "table" and A.isHorse(item) then
                    local u, co, m, d, h, a = A.itemTraits(item)
                    if A.matches(category, u, co, m, d, h, a) then
                        list[#list + 1] = uid
                    end
                end
            end
            return list
        end

        -- which of these uids are still in the inventory right now
        local function stillThere(list)
            local inv = A.readInv()
            if not inv then return list end
            S.Inventory = inv
            S.Loaded = true
            local out = {}
            for _, uid in ipairs(list) do
                if inv[uid] ~= nil then out[#out + 1] = uid end
            end
            return out
        end

        -- fire one sell request, then wait until those horses leave the inventory
        local function sendAndVerify(list)
            local payload = {}
            for _, uid in ipairs(list) do payload[tostring(uid)] = 1 end
            remote:FireServer("SellItems", payload)

            local deadline = tick() + math.clamp(2.5 + #list * 0.08, 2.5, 10)
            local stuck = list
            repeat
                task.wait(0.4)
                stuck = stillThere(list)
            until #stuck == 0 or tick() > deadline
            return stuck
        end

        -- sell a group; leftovers are retried, a group that sold nothing is split in half
        local function sellGroup(list)
            if #list == 0 then return end
            setStatus(st, "Selling " .. #list .. " | " .. category .. " | sold so far: " .. sold, C.amber)
            local stuck = sendAndVerify(list)

            -- the inventory data can lag behind the server: give it one more look before judging
            if #stuck == #list and #list > 1 then
                task.wait(2.5)
                stuck = stillThere(list)
            end

            sold += (#list - #stuck)
            A.refreshCounts()
            if #stuck == 0 then return end

            if #list == 1 then
                -- a single horse was refused: one more try, then skip it
                task.wait(1)
                local again = sendAndVerify(list)
                if #again == 0 then
                    sold += 1
                else
                    failed[list[1]] = true
                    skipped += 1
                end
                return
            end

            if #stuck < #list then
                sellGroup(stuck)                       -- some sold: retry only the leftovers
            else
                local mid = math.floor(#stuck / 2)     -- none sold: a bad horse is in here, split
                sellGroup(table.move(stuck, 1, mid, 1, {}))
                sellGroup(table.move(stuck, mid + 1, #stuck, 1, {}))
            end
        end

        local ok, err = pcall(function()
            for _ = 1, 200 do
                local inv = A.readInv()
                if not inv then error("inventory unavailable") end
                S.Inventory = inv
                S.Loaded = true

                local list = collect(inv)
                if #list == 0 then break end

                sellGroup(table.move(list, 1, math.min(batchSize, #list), 1, {}))
                batchSize = BATCH       -- leftovers are cleaned up in smaller batches
            end
        end)

        if not ok then
            setStatus(st, "Sell error: " .. tostring(err), C.red)
        elseif sold == 0 and skipped == 0 then
            setStatus(st, "Nothing matches: " .. category, C.amber)
        else
            local msg = "Sold " .. sold .. " horse(s) | " .. category
            if skipped > 0 then msg = msg .. " | skipped " .. skipped .. " (locked/rejected)" end
            setStatus(st, msg, C.green)
        end

        local inv = A.readInv()
        if inv then
            S.Inventory = inv
            S.Loaded = true
        end
        A.refreshCounts()
        S.SellBtn.Text = "SELL FILTERED"
        S.Selling = false
    end)
end

