    pcall(function()
        for _, mod in ipairs(getloadedmodules()) do
            if mod.Name == "AFKHandler" then
                afkHandler = require(mod)
                break
            end
        end
    end)
    
    if not afkHandler then
        pcall(function()
            local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts") or LocalPlayer:WaitForChild("PlayerScripts", 5)
            local secondary = playerScripts and playerScripts:FindFirstChild("Secondary")
            local mod = secondary and secondary:FindFirstChild("AFKHandler")
            if mod then
                afkHandler = require(mod)
            end
        end)
    end
    
    if afkHandler then
        _G.AFKHandlerInstance = afkHandler
        print("[Anti-AFK] Successfully hooked game AFKHandler!")
        while task.wait(15) do
            pcall(function()
                afkHandler.Reset()
                afkHandler.isAfk = false
                afkHandler.isHardAfk = false
            end)
        end
    else
        warn("[Anti-AFK] AFKHandler module not found automatically; native Idled bypass active.")
    end
end)

