local function GetHorseInfo(rawName)
    local name = tostring(rawName or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local lower = name:lower()

    for breed, info in pairs(RarityData) do
        if lower == breed:lower() then
            return breed, info.Rarity
        end
    end

    for breed, info in pairs(RarityData) do
        local b = breed:lower()
        if lower:find(b, 1, true) or b:find(lower, 1, true) then
            return breed, info.Rarity
        end
    end

    return name, "Low"
end

local function getHorsePivot(horse)
    if horse:IsA("Model") then
        local ok, pivot = pcall(function() return horse:GetPivot() end)
        if ok then return pivot end
    elseif horse:IsA("BasePart") then
        return horse.CFrame
    end
end

local function getHorseBreed(horse)
    local displayName = horse.Name
    pcall(function()
        local overheadPart = horse:FindFirstChild("OverheadPart")
        local overhead = overheadPart and overheadPart:FindFirstChild("Overhead")
        local label = overhead and overhead:FindFirstChild("BreedLabel")
        if label and label:IsA("TextLabel") and label.Text ~= "" then
            displayName = label.Text
        end
    end)
    return GetHorseInfo(displayName)
end

local function isHorse(node)
    if not node or not node.Parent then return false end
    if not node:IsA("Model") and not node:IsA("BasePart") then return false end

    local tagged = CollectionService:HasTag(node, "Animal")
    local behaviour = node:GetAttribute("behaviour")
    if tagged or behaviour == "WanderingAnimal" then
        return true
    end

    -- Fallbacks for servers where the Animal tag/behaviour is not present.
    if node:IsA("Model") then
        local overheadPart = node:FindFirstChild("OverheadPart")
        local overhead = overheadPart and overheadPart:FindFirstChild("Overhead")
        local breedLabel = overhead and overhead:FindFirstChild("BreedLabel")
        if breedLabel and breedLabel:IsA("TextLabel") and tostring(breedLabel.Text) ~= "" then
            return true
        end
        local lower = node.Name:lower()
        for breedName in pairs(RarityData) do
            local b = tostring(breedName):lower()
            if lower == b or lower:find(b, 1, true) then
                return true
            end
        end
    end
    return false
end

local function isOwned(node)
    for attrKey, attrVal in pairs(node:GetAttributes()) do
        if attrKey:lower() == "owner" and attrVal ~= nil and tostring(attrVal) ~= "" then
            return true
        end
    end
    return false
end

-- Only target horses whose lastPlayerToThrowLasso attribute exactly matches
-- the username running this script. Missing or different values are ignored.
local function isLassoedByLocalPlayer(node)
    if not node then return false end
    local lastPlayer = node:GetAttribute("lastPlayerToThrowLasso")
    return lastPlayer ~= nil and tostring(lastPlayer) == LocalPlayer.Name
end

local function isInShop(node)
    local current = node
    while current and current ~= Workspace do
        local n = current.Name:lower()
        if n:find("shop", 1, true) or n:find("stable", 1, true) or n:find("barn", 1, true) or n:find("store", 1, true) then
            return true
        end
        current = current.Parent
    end
    return false
end

--// BACKGROUND SCANNER
local function ScanHorses()
    local now = tick()
    if now - LastScan < SCAN_INTERVAL and #ScanCache > 0 then
        return ScanCache
    end

    local results = {}
    local seen = {}
    local islands = Workspace:FindFirstChild("Islands")
    if not islands then
        ScanCache = results
        LastScan = now
        return results
    end

    local function ScanContainer(container, islandName)
        for _, node in ipairs(container:GetChildren()) do
            if (node:IsA("Folder") or (node:IsA("Model") and not CollectionService:HasTag(node, "Animal"))) and not isHorse(node) then
                ScanContainer(node, islandName)
            elseif not seen[node] and isHorse(node) and isLassoedByLocalPlayer(node) and not isOwned(node) and not isInShop(node) then
                seen[node] = true
                local pivot = getHorsePivot(node)
                if pivot then
                    local breed, rarity = getHorseBreed(node)
                    local unique = checkUniqueHair(node)
                    local priorityStats = GetHorsePriorityStats(node)
                    table.insert(results, {
                        Model = node,
                        Island = islandName,
                        Name = breed,
                        Rarity = rarity,
                        Unique = unique,
                        UniqueCoat = priorityStats.UniqueCoat,
                        Mismatched = priorityStats.Mismatched,
                        NaturalDyed = priorityStats.NaturalDyed,
                        Horned = priorityStats.Horned,
                        Priority = priorityStats.Priority,
                        PriorityCount = priorityStats.Count,
                        Position = pivot.Position,
                        Pivot = pivot,
                        UID = node.Name .. "_" .. math.floor(pivot.Position.X) .. "_" .. math.floor(pivot.Position.Z)
                    })
                end
            end
        end
    end

    for _, island in ipairs(islands:GetChildren()) do
        if island:IsA("Folder") or island:IsA("Model") then
            ScanContainer(island, island.Name)
        end
    end

    ScanCache = results
    LastScan = now
    return results
end

