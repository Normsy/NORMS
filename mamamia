function GenerateLassoUID()
    CatchConfig.LassoStatus.Text = "Scanning inventory..."
    CatchConfig.LassoStatus.TextColor3 = Color3.fromRGB(251, 191, 36)
    local foundUID = nil
    local targetName = tostring(CatchConfig.LassoNameBox.Text or CatchConfig.SelectedLasso):lower()

    pcall(function()
        local References = require(ReplicatedStorage:WaitForChild("References"))
        local Data = require(References.PlayerScripts.Priority.Data)
        local inventory = Data.GetLocal({"inventory"})
        for uid, item in pairs(inventory or {}) do
            if type(item) == "table" then
                local ok, info = pcall(function() return References.Items.GetInfo(item.id) end)
                if ok and info and info.name and tostring(info.name):lower() == targetName then
                    foundUID = tostring(uid)
                    break
                end
            end
        end
    end)

    if not foundUID then
        local searchSpaces = {LocalPlayer, ReplicatedStorage}
        for _, space in ipairs(searchSpaces) do
            for _, obj in ipairs(space:GetDescendants()) do
                local objName = tostring(obj.Name):lower()
                if objName == targetName or (obj:IsA("StringValue") and tostring(obj.Value):lower() == targetName) then
                    local possibleUID = obj:GetAttribute("UID") or obj:GetAttribute("ID") or obj:GetAttribute("Id")
                    if possibleUID then
                        foundUID = tostring(possibleUID)
                        break
                    end
                    local idChild = obj:FindFirstChild("UID") or obj:FindFirstChild("ID")
                    if idChild and (idChild:IsA("StringValue") or idChild:IsA("NumberValue")) then
                        foundUID = tostring(idChild.Value)
                        break
                    end
                end
            end
            if foundUID then break end
        end
    end

    if foundUID then
        CatchConfig.ConfiguredLassoUID = foundUID
        CatchConfig.LassoUIDBox.Text = foundUID
        CatchConfig.LassoStatus.Text = "UID Found: " .. foundUID
        CatchConfig.LassoStatus.TextColor3 = Color3.fromRGB(57, 255, 20)
    else
        CatchConfig.LassoStatus.Text = "UID not found for " .. tostring(CatchConfig.SelectedLasso)
        CatchConfig.LassoStatus.TextColor3 = Color3.fromRGB(239, 68, 68)
    end
end
