-- catch remote detection: watches the game's own (lassoUID, "Activate", horse) call
function A.installHook()
    if A.hooked then return true end
    if not (hookmetamethod and getnamecallmethod and checkcaller) then return false end
    local ok = pcall(function()
        local old
        local function hook(self, ...)
            if A.detecting then
                local method = getnamecallmethod()
                if method == "FireServer" and not checkcaller() then
                    local args = table.pack(...)
                    if args[2] == "Activate" and typeof(args[3]) == "Instance" and typeof(self) == "Instance" then
                        A.seen = {name = self.Name, uid = args[1]}
                    end
                end
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
    end)
    A.hooked = ok
    return ok
end

A.CatchBtn.MouseButton1Click:Connect(function()
    if A.detecting then return end
    if not A.installHook() then
        setStatus(A.CatchStatus, "Your executor does not support hookmetamethod. Use the RemoteSpy toggle instead.", C.red)
        return
    end
    A.seen = nil
    A.detecting = true
    task.spawn(function()
        local found = nil
        for t = 20, 1, -1 do
            A.CatchBtn.Text = "NOW CATCH A HORSE... " .. t .. "s"
