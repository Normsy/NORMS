--// NOCLIP (from the original tracker behavior)
local NoClipEnabled = false
local NoClipConnection = nil
local NoClipStates = {}

local function SetNoClip(enabled)
    NoClipEnabled = enabled

    if enabled then
        if NoClipConnection then
            NoClipConnection:Disconnect()
        end

        -- Match the old script: every Stepped frame, disable collision on every
        -- character BasePart. This prevents terrain/parts from physically fighting
        -- the TweenService CFrame movement.
        NoClipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not NoClipEnabled or not char or not char.Parent then return end

            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    else
        if NoClipConnection then
            NoClipConnection:Disconnect()
            NoClipConnection = nil
        end

        -- Match the old script's cleanup behavior.
        local char = LocalPlayer.Character
        if char and char.Parent then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
        table.clear(NoClipStates)
    end
end

