--// ============================================================================
--// 2) SMART PRIORITY
--//    1 Unique Hair, 2 Mismatched Hair, 3 Island Unique Coat, 4 Natural Dyed,
--//    5 Horned, 6 Normal.   Main list tags: C=coat M=mismatch D=dyed H=horned
--// ============================================================================
local UNIQUE = UNIQUE_HAIR_VALUES
local ORANGE = {
    blowingSnow = true, motherOfPearl = true, royalDun = true, dustyBrindle = true,
    glacierChimera = true, mountainSunrise = true, jaguar = true, deepSpace = true, crackedLava = true,
}

local function norm(v)
    if v == nil then return "" end
    return (tostring(v):lower():gsub("[%s_%-]", ""))
end

local function tableSig(t)
    local keys = {}
    for k in pairs(t) do keys[#keys + 1] = k end
    table.sort(keys, function(x, y) return tostring(x) < tostring(y) end)
    local parts = {}
    for _, k in ipairs(keys) do
        local v = t[k]
        if type(v) == "table" then v = tableSig(v) end
        parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
    end
    return "{" .. table.concat(parts, ";") .. "}"
end

local function trimLower(v)
    return (tostring(v or ""):lower():gsub("^%s+", ""):gsub("%s+$", ""))
end

local function coloursMatch(a, b)
    if a == b then return true end
    if type(a) == "table" and type(b) == "table" then return tableSig(a) == tableSig(b) end
    return trimLower(a) == trimLower(b)
end

local function isOrange(main)
    return ORANGE[(tostring(main or ""):gsub("%s+", ""))] == true
end

-- returns unique, coat, mismatch, natDyed, horned
local function traitsFrom(variants, natDyed)
    if type(variants) ~= "table" then variants = {} end
    local main = variants.colour or variants.mainColour or variants.MainColour
    local mane = variants.maneColour or variants.ManeColour
    local tail = variants.tailColour or variants.TailColour
    local unique = (UNIQUE[norm(mane)] or UNIQUE[norm(tail)]) and true or false
    local coat = isOrange(main)
    local mismatch = not coloursMatch(mane, tail)
    local dyed = natDyed ~= nil
    local horned = variants.hornColour ~= nil and tostring(variants.hornColour) ~= ""
    return unique, coat, mismatch, dyed, horned
end

local function priorityOf(u, co, m, d, h)
    local p = 6
    if u then p = 1
    elseif m then p = 2
    elseif co then p = 3
    elseif d then p = 4
    elseif h then p = 5 end
    local n = 0
    for _, f in ipairs({u, co, m, d, h}) do
        if f then n += 1 end
    end
    return p, n
end

local statsCache = setmetatable({}, {__mode = "k"})
local function horseStats(model)
    local raw = model:GetAttribute("Data")
    local c = statsCache[model]
    if c and c.raw == raw then return c end
    local data = raw
    if type(raw) == "string" then
        local ok, dec = pcall(function() return HttpService:JSONDecode(raw) end)
        data = ok and dec or nil
    end
    local u, co, m, d, h = false, false, false, false, false
    if type(data) == "table" and type(data.variants) == "table" then
        u, co, m, d, h = traitsFrom(data.variants, data.isNatDyed)
    end
    local p, n = priorityOf(u, co, m, d, h)
    c = {raw = raw, Unique = u, Coat = co, Mismatch = m, Dyed = d, Horned = h, Priority = p, Count = n}
    statsCache[model] = c
    return c
end

-- The tracker sorts with:  unique-hair first -> RarityPriority -> Distance.
-- To get the full priority order WITHOUT touching that sort code we:
--   (a) flatten RarityPriority so rarity no longer decides the order, and
--   (b) fold priority / trait count / rarity into the "Distance" sort key
--       (real distance is kept in RealDistance).
local RANK = {}
for k, v in pairs(RarityPriority) do RANK[k] = v end
for k in pairs(RarityPriority) do RarityPriority[k] = 0 end

local origGetHorses = GetWorldHorses
local origClearCache = ClearCache
A.wrapCache = nil
A.lastWrap = 0

ClearCache = function()
    origClearCache()
    A.lastWrap = 0
end

-- also throttles the world scan to every 0.5s (the original rescanned every 0.03s = lag)
GetWorldHorses = function()
    local now = tick()
    if A.wrapCache and now - A.lastWrap < 0.5 then
        return A.wrapCache
    end
    local list = origGetHorses()
    for _, h in ipairs(list) do
        local st = horseStats(h.Model)
        h.Stats = st
        local real = h.RealDistance or h.Distance or 0
        h.RealDistance = real
        h.Distance = st.Priority * 1e9
            + (9 - st.Count) * 1e8
            + (5 - (RANK[h.Rarity] or 0)) * 1e7
            + math.min(real, 9e6)
    end
    A.wrapCache = table.move(list, 1, #list, 1, {})
    A.lastWrap = now
    return A.wrapCache
end

local origRefreshList = RefreshList
RefreshList = function()
    origRefreshList()
    local list = A.wrapCache
    if not list then return end
    for _, h in ipairs(list) do
        local st = h.Stats
        if st and st.Priority < 6 then
            local entry = ScrollFrame:FindFirstChild(tostring(h.UID))
            local nl = entry and entry:FindFirstChild("NameLabel")
            if nl then
                local tags = ""
                if st.Coat then tags = tags .. "C" end
                if st.Mismatch then tags = tags .. "M" end
                if st.Dyed then tags = tags .. "D" end
                if st.Horned then tags = tags .. "H" end
                if tags ~= "" then nl.Text = h.Name .. " [" .. tags .. "]" end
            end
        end
    end
end

