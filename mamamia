        sightDragging = true
        sightDragInput = input
        sightDragStart = input.Position
        sightStartPos = sight.Position
    end
end)

sight.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        sightDragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not sightDragging or input ~= sightDragInput then return end
    local delta = input.Position - sightDragStart
    sight.Position = UDim2.new(
        sightStartPos.X.Scale,
        sightStartPos.X.Offset + delta.X,
        sightStartPos.Y.Scale,
        sightStartPos.Y.Offset + delta.Y
    )
end)

UserInputService.InputEnded:Connect(function(input)
    if input == sightDragInput
        or input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        sightDragging = false
        sightDragInput = nil
    end
end)

local function GetSightScreenPosition()
    local pos = sight.AbsolutePosition
    local size = sight.AbsoluteSize
    return math.floor(pos.X + size.X * 0.5), math.floor(pos.Y + size.Y * 0.5)
end

