    -- Fetch public servers, fullest first
    local function FetchServers()
        local httpGet = N.GetHttpRequest()
        local list, cursor = {}, ""
        for _ = 1, 1 do
            local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId)
                .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=50"
            if cursor ~= "" then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
            local ok, body = pcall(httpGet, url)
            if not ok or not body then break end
            local okD, data = pcall(function() return HttpService:JSONDecode(body) end)
            if not okD or not data or not data.data then break end
            for _, s in ipairs(data.data) do
                local playing = tonumber(s.playing) or 0
                local maxP = tonumber(s.maxPlayers) or 0
                if s.id and s.id ~= game.JobId and playing < maxP then
                    table.insert(list, {id = s.id, playing = playing, max = maxP, ping = tonumber(s.ping)})
                end
            end
            cursor = data.nextPageCursor or ""
            if cursor == "" then break end
        end
        table.sort(list, function(a, b) return a.playing > b.playing end)
        return list
    end

