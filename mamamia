--// NEW: true if a strictly higher-priority horse exists than the current target
--// (1 Unique Hair > 2 Mismatched > 3 Unique Coat > 4 Natural Dyed > 5 Horned > 6 Normal)
function N.BetterTargetExists(target)
    if not target or target.Priority <= 1 then return false end
    for _, h in ipairs(N.ScanHorses()) do
        if h.Model ~= target.Model and h.Model and h.Model.Parent and h.Priority < target.Priority then
            return true
        end
    end
    return false
end

--// NEW: one-time low graphics pass when farming starts (anti-lag)
local LowGfxApplied = false
function N.ApplyLowGraphics()
    if LowGfxApplied then return end
    LowGfxApplied = true
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    pcall(function()
        local Lighting = game:GetService("Lighting")
        Lighting.GlobalShadows = false
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") or e:IsA("Clouds") then e.Enabled = false end
        end
    end)
    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
        end
    end)
    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then terrain.Decoration = false end
    end)
    task.spawn(function()
        pcall(function()
            -- chunked walk (a single Workspace:GetDescendants() call is a big memory spike)
            local stack, count = {Workspace}, 0
            while #stack > 0 do
                local node = table.remove(stack)
                for _, obj in ipairs(node:GetChildren()) do
                    count += 1
                    if count % 1500 == 0 then task.wait() end
                    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                        obj.Enabled = false
                    elseif #obj:GetChildren() > 0 and not obj:IsA("Terrain") then
                        stack[#stack + 1] = obj
                    end
                end
            end
        end)
    end)
end

function N.startFarm()
    if Farming then return end
    Farming = true
    N.SetNoClip(true)
    FarmGeneration += 1
    local myGeneration = FarmGeneration
    N.ApplyLowGraphics()
    button.Text = "STOP"
    button.BackgroundColor3 = Color3.fromRGB(239,68,68)
    button.TextColor3 = Color3.fromRGB(255,255,255)

    task.spawn(function()
        while Farming and myGeneration == FarmGeneration and gui.Parent do
            local island = GetCurrentPlayerIsland()
            islandText.Text = "Island: " .. tostring(island or "?")

            if not island then
                status.Text = "No island detected"
                status.TextColor3 = Color3.fromRGB(239,68,68)
                task.wait(0.5)
                continue
            end

            -- N.ScanHorses() already scans every island loaded in the current server.
            local candidates = {}
            for _, horse in ipairs(N.ScanHorses()) do
                if horse.Model and horse.Model.Parent then
                    table.insert(candidates, horse)
                end
            end

            table.sort(candidates, function(a,b)
                -- Catch priority: Unique Hair (1) > Mismatched Hair (2) > Island Unique Coat (3) > Natural Dyed Hair (4) > Horned (5) > Normal (6).
                if a.Priority ~= b.Priority then return a.Priority < b.Priority end
                if a.PriorityCount ~= b.PriorityCount then return a.PriorityCount > b.PriorityCount end
                local pa = N.RarityPriority[a.Rarity] or 0
                local pb = N.RarityPriority[b.Rarity] or 0
                if pa ~= pb then return pa > pb end
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not root then return false end
                return (root.Position-a.Position).Magnitude < (root.Position-b.Position).Magnitude
            end)

            local target = candidates[1]
            if not target then
                CurrentTarget = nil
                status.Text = "Scanning all islands..."
                status.TextColor3 = Color3.fromRGB(150,155,165)
                task.wait(0.25)
                continue
            end

            if not N.CanGoToHorse(target.Model) then
                CurrentTarget = nil
                status.Text = "Skipping horse: lasso owner is another player"
                status.TextColor3 = Color3.fromRGB(239, 68, 68)
                task.wait(0.1)
                continue
            end

            CurrentTarget = target.Model
            CurrentTargetUID = target.UID
            CurrentTargetIsland = target.Island
            status.Text = "Target: " .. target.Name .. (target.Priority > 0 and (" [P" .. tostring(target.Priority) .. "]") or "")
            status.TextColor3 = Color3.fromRGB(52,211,153)

            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local targetPart = target.Model:IsA("Model") and (target.Model.PrimaryPart or target.Model:FindFirstChildWhichIsA("BasePart")) or target.Model

            if root and humanoid and humanoid.Health > 0 and targetPart and target.Model.Parent then
                local currentIslandBeforeTravel = GetCurrentPlayerIsland()
                if currentIslandBeforeTravel ~= target.Island then
                    -- Horse is on a different island: travel first, then tween to it.
                    local remoteName = tostring(TravelRemoteBox.Text or ""):match("^%s*(.-)%s*$")
                    if remoteName == "" then
                        status.Text = "Set Travel Remote in Settings"
                        status.TextColor3 = Color3.fromRGB(239, 68, 68)
                        CurrentTarget = nil
                        task.wait(0.5)
                        continue
                    end

                    local travelFunc = Functions:FindFirstChild(remoteName)
                    if not travelFunc or not travelFunc:IsA("RemoteFunction") then
                        status.Text = "Travel Remote not found: " .. remoteName
                        status.TextColor3 = Color3.fromRGB(239, 68, 68)
                        CurrentTarget = nil
                        task.wait(0.5)
                        continue
                    end

                    status.Text = "Traveling to " .. tostring(target.Island) .. "..."
                    status.TextColor3 = Color3.fromRGB(251, 191, 36)
                    local travelOk = pcall(function()
                        travelFunc:InvokeServer("Travel", target.Island, 1)
                    end)
                    if not travelOk then
                        status.Text = "Travel Failed"
                        status.TextColor3 = Color3.fromRGB(239, 68, 68)
                        CurrentTarget = nil
                        task.wait(0.5)
                        continue
                    end

                    local arrivalDeadline = tick() + 15
                    local arrived = false
                    while Farming and myGeneration == FarmGeneration and tick() < arrivalDeadline do
                        local nowIsland = GetCurrentPlayerIsland()
                        islandText.Text = "Island: " .. tostring(nowIsland or "?")
                        if nowIsland == target.Island then
                            arrived = true
                            break
                        end
                        task.wait(0.2)
                    end

                    if not arrived then
                        status.Text = "Travel Timeout"
                        status.TextColor3 = Color3.fromRGB(239, 68, 68)
                        CurrentTarget = nil
                        task.wait(0.5)
                        continue
                    end

                    -- wait after traveling before heading to the horse
                    status.Text = "Arrived, waiting " .. tostring(TRAVEL_SETTLE_SECONDS) .. "s..."
                    status.TextColor3 = Color3.fromRGB(251, 191, 36)
                    local settleEnd = tick() + TRAVEL_SETTLE_SECONDS
                    while Farming and myGeneration == FarmGeneration and tick() < settleEnd do
                        task.wait(0.05)
                    end
                    if not (Farming and myGeneration == FarmGeneration) then
                        CurrentTarget = nil
                        continue
                    end

                    char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    root = char:WaitForChild("HumanoidRootPart")
                    humanoid = char:WaitForChild("Humanoid")
                    targetPart = target.Model and target.Model.Parent and (target.Model:IsA("Model") and (target.Model.PrimaryPart or target.Model:FindFirstChildWhichIsA("BasePart")) or target.Model)
                    if not targetPart then
                        CurrentTarget = nil
                        task.wait(0.1)
                        continue
                    end
                else
                    islandText.Text = "Island: " .. tostring(currentIslandBeforeTravel)
                end

                -- Anchor the character BEFORE tweening to avoid physics shake.
                N.SetNoClip(true)
                humanoid.PlatformStand = true
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                root.Anchored = true
                CharacterAnchored = true

                local targetCFrame = targetPart.CFrame * HORSE_OFFSET
                local distance = (root.Position - targetCFrame.Position).Magnitude
                local tweenTime = distance / TWEEN_SPEED
                local tween = TweenService:Create(root, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {CFrame=targetCFrame})
                local abandoned = false
                local lastBetterCheck = 0
                tween:Play()

                while tween.PlaybackState == Enum.PlaybackState.Playing and Farming and myGeneration == FarmGeneration do
                    -- NEW: drop this horse if a higher-priority one appeared
                    if tick() - lastBetterCheck > 0.25 then
                        lastBetterCheck = tick()
                        if N.BetterTargetExists(target) then
                            abandoned = true
                            tween:Cancel()
                            break
                        end
                    end
                    if not target.Model.Parent or humanoid.Health <= 0 then
                        tween:Cancel()
                        break
                    end
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    task.wait(0.03)
                end

                if abandoned then
                    status.Text = "Switching to higher priority horse..."
                    status.TextColor3 = Color3.fromRGB(251, 191, 36)
                    N.SetCharacterAnchored(false)
                    N.invalidate()
                elseif Farming and myGeneration == FarmGeneration and target.Model.Parent then
                    pcall(function()
                        root.CFrame = targetPart.CFrame * HORSE_OFFSET
                        if activeWeld then
                            activeWeld:Destroy()
                            activeWeld = nil
                        end
                        activeWeld = Instance.new("WeldConstraint")
                        activeWeld.Name = "HorseTrackerWeld"
                        activeWeld.Part0 = root
                        activeWeld.Part1 = targetPart
                        activeWeld.Parent = root
                    end)
                    root.Anchored = true
                    CharacterAnchored = true
                    status.Text = "Locked on: " .. target.Name
                    status.TextColor3 = Color3.fromRGB(52,211,153)
                    task.wait(0.08)

                    local caught = false
                    local catchDeadline = tick() + 8
                    local lastBetter2 = 0
                    while Farming and myGeneration == FarmGeneration and target.Model.Parent and tick() < catchDeadline do
                        -- NEW: drop this horse if a higher-priority one appeared
                        if tick() - lastBetter2 > 0.25 then
                            lastBetter2 = tick()
                            if N.BetterTargetExists(target) then
                                abandoned = true
                                status.Text = "Switching to higher priority horse..."
                                break
                            end
                        end

                        if CatchMode == "Remote" then
                            -- remote catch (needs Lasso UID + Catch Remote from Settings)
                            local catchEvent = (CatchRemoteName ~= "" and Events) and Events:FindFirstChild(CatchRemoteName) or nil
                            if not ConfiguredLassoUID or not catchEvent then
                                stopFarm()
                                SetMinimized(false)
                                status.Text = "Set Catch Remote & Lasso UID in Settings"
                                status.TextColor3 = Color3.fromRGB(239, 68, 68)
                                break
                            end
                            pcall(function()
                                catchEvent:FireServer(ConfiguredLassoUID, "Activate", target.Model)
                            end)
                            status.Text = "Catching (remote): " .. target.Name
                        else
                            -- N.ScreenClick() itself skips the click while the UI is open.
                            N.ScreenClick()
                            status.Text = (minimized and "Catching: " or "Click paused (UI open): ") .. target.Name
                            if not minimized then catchDeadline = tick() + 8 end
                        end
                        status.TextColor3 = Color3.fromRGB(52,211,153)

                        if not target.Model.Parent or N.isOwned(target.Model) then
                            caught = true
                            break
                        end

                        task.wait(CatchMode == "Remote" and 0.2 or CATCH_INTERVAL)
                    end
                    -- After a successful catch, stay exactly where the last horse was.
                    if caught and root and root.Parent then
                        local lastStandCFrame = root.CFrame
                        N.SetCharacterAnchored(false)
                        pcall(function()
                            root.CFrame = lastStandCFrame
                            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end)
                        status.Text = "Caught: " .. target.Name .. " | Waiting for new horse..."
                        status.TextColor3 = Color3.fromRGB(52,211,153)
                    else
                        N.SetCharacterAnchored(false)
                    end
                    N.invalidate()
                end
            end

            if not CurrentTarget then
                status.Text = "Waiting for new horse..."
                status.TextColor3 = Color3.fromRGB(150,155,165)
            end
            CurrentTarget = nil
            CurrentTargetUID = nil
            CurrentTargetIsland = nil
            task.wait(0.08)
        end
    end)
end

