local function normalizeValue(val)
    if type(val) ~= "string" then return "" end
    return string.lower(string.gsub(val, "%s+", ""))
end

local function checkUniqueHair(horseModel)
    local dataAttr = horseModel:GetAttribute("Data")
    if not dataAttr then return false, "X" end

    local data
    if type(dataAttr) == "string" then
        local success, decoded = pcall(HttpService.JSONDecode, HttpService, dataAttr)
        if success and type(decoded) == "table" then data = decoded else return false, "X" end
    elseif type(dataAttr) == "table" then
        data = dataAttr
    else
        return false, "X"
    end

    local variants = data and data.variants
    if type(variants) ~= "table" then return false, "X" end

    local maneColour = normalizeValue(variants.maneColour)
    local tailColour = normalizeValue(variants.tailColour)

    local hasUniqueHair = UNIQUE_HAIR_VALUES[maneColour] or UNIQUE_HAIR_VALUES[tailColour] or false
    local uniqueHairText = hasUniqueHair and "â" or "X"
    return hasUniqueHair, uniqueHairText
end

local function GetHorseInfo(rawName)
    local cleaned = rawName:gsub("^%s*", ""):gsub("%s*$", "")
    if RarityData[cleaned] then
        local info = RarityData[cleaned]
        local displayName = cleaned
        if not cleaned:lower():find("horse") and not cleaned:lower():find("donkey") and not cleaned:lower():find("mule") and not cleaned:lower():find("hinny") and not cleaned:lower():find("reindeer") then
            displayName = cleaned .. " Horse"
        end
        return displayName, info.Rarity, info.Color
    end
    local withHorse = cleaned .. " Horse"
    if RarityData[withHorse] then
        local info = RarityData[withHorse]
        return withHorse, info.Rarity, info.Color
    end
    for breed, info in pairs(RarityData) do
        if cleaned:lower():find(breed:lower()) then
            local displayName = breed
            if not breed:lower():find("horse") and not breed:lower():find("donkey") and not breed:lower():find("mule") and not breed:lower():find("hinny") and not breed:lower():find("reindeer") then
                displayName = breed .. " Horse"
            end
            return displayName, info.Rarity, info.Color
        end
    end
    return cleaned, "Low", Color3.fromRGB(57, 255, 20)
end

--// VOLCANO ISLAND - REMOVE LAVAPARTS ON EXECUTION
-- Removes Workspace.Islands["Volcano Island"].LavaParts when the script starts.
local function RemoveVolcanoLavaParts()
    pcall(function()
        local islands = Workspace:FindFirstChild("Islands")
        if not islands then return end

        local volcano = islands:FindFirstChild("Volcano Island")
        if not volcano then return end

        local lavaParts = volcano:FindFirstChild("LavaParts")
        if lavaParts then
            lavaParts:Destroy()
            print("[Volcano] LavaParts removed.")
        end
    end)
end

RemoveVolcanoLavaParts()

