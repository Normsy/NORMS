local function BuildIslandCenterCache(force)
    local islands = Workspace:FindFirstChild("Islands")
    if not islands then return end
    local now = tick()
    if not force and now - IslandCacheTime < ISLAND_CACHE_REFRESH and next(IslandCenterCache) then
        return
    end
    table.clear(IslandCenterCache)
    for _, island in ipairs(islands:GetChildren()) do
        if island:IsA("Model") then
            local ok, cf = pcall(function() return island:GetPivot() end)
            if ok and cf then IslandCenterCache[island.Name] = cf.Position end
        elseif island:IsA("Folder") then
            local sum = Vector3.new(0,0,0)
            local count = 0
            local minV = Vector3.new(math.huge, math.huge, math.huge)
            local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
            for _, obj in ipairs(island:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local pos = obj.Position
                    sum += pos; count += 1
                    minV = Vector3.new(math.min(minV.X,pos.X), math.min(minV.Y,pos.Y), math.min(minV.Z,pos.Z))
                    maxV = Vector3.new(math.max(maxV.X,pos.X), math.max(maxV.Y,pos.Y), math.max(maxV.Z,pos.Z))
                end
            end
            if count > 0 then
                IslandCenterCache[island.Name] = (minV + maxV) / 2
            end
        end
    end
    IslandCacheTime = now
end

GetCurrentPlayerIsland = function()
    local root = GetRootAndPosition and select(1, GetRootAndPosition()) or nil
    if not root then
        local char = LocalPlayer.Character
        root = char and char:FindFirstChild("HumanoidRootPart")
    end
    if not root then return nil end
    BuildIslandCenterCache(false)
    local best, bestDist = nil, math.huge
    for name, center in pairs(IslandCenterCache) do
        local d = (root.Position - center).Magnitude
        if d < bestDist then bestDist = d; best = name end
    end
    return best
end

