    task.spawn(function()
        local island = GetCurrentPlayerIsland()
        if not island then
            finish("Could not detect your current island.", C.red)
            return
        end
        setStatus(A.TravelStatus, "Testing Travel on: " .. island, C.amber)
        task.wait(0.25)
        for i = 1, 36 do
            local name = "Function" .. i
            local remote = Functions:FindFirstChild(name)
            if remote and remote:IsA("RemoteFunction") then
                A.TravelBtn.Text = "Testing " .. name
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local beforePos = root and root.Position
                local beforeCF = root and root.CFrame
                local invokeOK = pcall(function()
                    remote:InvokeServer("Travel", island, 1)
                end)
                local moved = false
                local elapsed = 0
                while elapsed < 1 do
                    task.wait(0.05)
                    elapsed += 0.05
                    local c2 = LocalPlayer.Character
                    local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
                    if r2 and beforePos and beforeCF then
                        local posChanged = (r2.Position - beforePos).Magnitude > 0.05
                        local rotChanged = (r2.CFrame.LookVector - beforeCF.LookVector).Magnitude > 0.001
                        if posChanged or rotChanged then
                            moved = true
                            break
                        end
                    end
                end
                if invokeOK and moved then
                    TravelRemoteBox.Text = name
                    SaveTravelBtn.Text = "Saved"
                    SaveTravelBtn.BackgroundColor3 = C.green
                    SaveTravelBtn.TextColor3 = C.black
                    SavePersistentConfig()
                    finish("FOUND: " .. name .. " (character moved on " .. island .. ")", C.green)
                    return
                end
                setStatus(A.TravelStatus, name .. (invokeOK and " did not move you; next..." or " errored; next..."), C.amber)
            else
                task.wait(0.3)
            end
        end
        finish("No travel remote found in Function1-Function36.", C.red)
    end)
end
