local BREED_KEYWORDS = {
    "tennessee walking horse", "tennessee walker", "dutch warmblood", "mammoth donkey", "standard donkey", "paint horse",
    "quarter horse", "akhal teke", "andalusian", "appaloosa", "arabian", "clydesdale", "connemara",
    "fjord", "friesian", "hinny", "icelandic", "marwari", "morgan", "mule", "mustang", "percheron",
    "reindeer", "shire", "standardbred", "thoroughbred", "welsh cob", "unicorn", "donkey",
}
local BREED_FIELDS = {
    "breed", "Breed", "breedName", "BreedName", "horseBreed", "HorseBreed", "breedType", "BreedType",
    "horseType", "HorseType", "animalType", "AnimalType", "species", "Species", "type", "Type",
    "name", "Name", "itemName", "ItemName", "displayName", "DisplayName", "Display", "display",
}
local KEY_HINTS = {"breed", "horse", "animal", "species", "type", "name", "item"}

local function normText(v)
    if v == nil then return "" end
    local t = tostring(v):lower():gsub("_", " "):gsub("%-", " "):gsub("%s+", " ")
    return (t:match("^%s*(.-)%s*$"))
end

local function hasKeyword(v)
    local text = normText(v)
    if text == "" then return false end
    for _, kw in ipairs(BREED_KEYWORDS) do
        if text == kw or text:find(kw, 1, true) then return true end
    end
    return false
end

local function searchBreed(tbl, depth, visited)
    if type(tbl) ~= "table" then return false end
    depth = depth or 0
    visited = visited or {}
    if depth > 10 or visited[tbl] then return false end
    visited[tbl] = true
    for _, f in ipairs(BREED_FIELDS) do
        local v = tbl[f]
        if v ~= nil and hasKeyword(v) then return true end
    end
    for key, value in pairs(tbl) do
        if type(value) == "table" then
            if searchBreed(value, depth + 1, visited) then return true end
        elseif type(value) == "string" then
            local k = normText(key)
            for _, hint in ipairs(KEY_HINTS) do
                if k:find(hint, 1, true) then
                    if hasKeyword(value) then return true end
                    break
                end
            end
        end
    end
    return false
end

function A.getInfo(id)
    if not (S.Refs and S.Refs.Items and type(S.Refs.Items.GetInfo) == "function") then return nil end
    local ok, r = pcall(function() return S.Refs.Items.GetInfo(id) end)
    if ok and type(r) == "table" then return r end
    return nil
end

function A.isHorse(item)
    if type(item) ~= "table" then return false end
    -- FIX: any inventory entry that has mane/tail colour variants is a horse,
    -- even when its breed name is not in BREED_KEYWORDS.
    local v = item.variants or item.Variants
    if type(v) == "table" and (v.maneColour or v.tailColour or v.ManeColour or v.TailColour) then
        return true
    end
    if searchBreed(item) then return true end
    local itemId = item.id or item.ID or item.Id
    local info = itemId and A.getInfo(itemId) or nil
    if info and searchBreed(info) then return true end
    local pId = item.pId or item.PId or item.pid
    if info then pId = pId or info.pId or info.PId or info.pid end
    if pId then
        local r = A.getInfo(pId)
        if r and searchBreed(r) then return true end
    end
    return false
end

function A.itemTraits(item)
    return traitsFrom(item.variants or item.Variants, item.isNatDyed)
end

function A.matches(cat, u, co, m, d, h, a)
    if cat == "All" then return true end
    if cat == "Normal Horse" then return not (u or co or m or d or h or a) end
    if cat == "Natural Dyed Hair" then return d end
    if cat == "Island Unique Hair" then return u end
    if cat == "Island Unique Coat" then return co end
    if cat == "Mismatched Hair" then return m end
    if cat == "Horned" then return h end
    if cat == "Autumn" then return a end
    return false
end

function A.readInv()
    local ok, inv = pcall(function()
        local refs = require(ReplicatedStorage:WaitForChild("References"))
        S.Refs = refs
        local data = require(refs.PlayerScripts.Priority.Data)
        return data.GetLocal({"inventory"})
    end)
    if ok and type(inv) == "table" then return inv end
    return nil
end

