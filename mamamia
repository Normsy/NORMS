function N.SellingNormalizeText(value)
    if value == nil then return "" end
    local text = tostring(value):lower():gsub("_", " "):gsub("-", " "):gsub("%s+", " ")
    return text:match("^%s*(.-)%s*$")
end

function N.SellingFindBreedKeyword(value)
    local text = N.SellingNormalizeText(value)
    if text == "" then return nil end
    for _, keyword in ipairs(N.BreedKeywords) do
        local nk = N.SellingNormalizeText(keyword)
        if text == nk or text:find(nk, 1, true) then return N.BreedDisplayNames[keyword] end
    end
    return nil
end

N.BreedFields = {"breed","Breed","breedName","BreedName","horseBreed","HorseBreed","breedType","BreedType","horseType","HorseType","animalType","AnimalType","species","Species","type","Type","name","Name","itemName","ItemName","displayName","DisplayName","Display","display"}

function N.SellingSearchBreedData(tbl, depth, visited)
    if type(tbl) ~= "table" then return nil end
    depth = depth or 0; visited = visited or {}
    if depth > 10 or visited[tbl] then return nil end
    visited[tbl] = true
    for _, field in ipairs(N.BreedFields) do
        local value = tbl[field]
        if value ~= nil then
            local breed = N.SellingFindBreedKeyword(value)
            if breed then return breed end
        end
    end
    for key, value in pairs(tbl) do
        if type(value) == "table" then
            local breed = N.SellingSearchBreedData(value, depth + 1, visited)
            if breed then return breed end
        elseif type(value) == "string" then
            local k = N.SellingNormalizeText(key)
            if k:find("breed",1,true) or k:find("horse",1,true) or k:find("animal",1,true) or k:find("species",1,true) or k:find("type",1,true) or k:find("name",1,true) or k:find("item",1,true) then
                local breed = N.SellingFindBreedKeyword(value)
                if breed then return breed end
            end
        end
    end
    return nil
end

function N.SellingGetItemInfo(item)
    if type(item) ~= "table" or not SellingReferences or not SellingReferences.Items then return nil end
