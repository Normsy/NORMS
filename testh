    Status.Text = text
    Status.TextColor3 = color or Color3.fromRGB(139, 146, 165)
end

local GREEN = Color3.fromRGB(52, 211, 153)
local AMBER = Color3.fromRGB(251, 191, 36)
local RED = Color3.fromRGB(239, 68, 68)

--// ---------------------------------------------------------------- scan islands
local scanning = false
ScanBtn.MouseButton1Click:Connect(function()
    if scanning then return end
    scanning = true
    status("Scanning islands...", AMBER)
    task.spawn(function()
        local islands = Workspace:FindFirstChild("Islands")
        if not islands then
            status("Workspace.Islands not found", RED)
            scanning = false
            return
        end

        local lines = {"ISLAND SCAN"}
        local data = {}
        for _, island in ipairs(islands:GetChildren()) do
            local b = islandBounds(island)
            if b then
                local cx, cy, cz = (b.minX + b.maxX) / 2, (b.minY + b.maxY) / 2, (b.minZ + b.maxZ) / 2
                lines[#lines + 1] = string.format(
                    "%s | center (%s, %s, %s) | size X=%s Y=%s Z=%s | X %s..%s | Y %s..%s | Z %s..%s | parts %d",
                    island.Name, fmt(cx), fmt(cy), fmt(cz),
                    fmt(b.maxX - b.minX), fmt(b.maxY - b.minY), fmt(b.maxZ - b.minZ),
                    fmt(b.minX), fmt(b.maxX), fmt(b.minY), fmt(b.maxY), fmt(b.minZ), fmt(b.maxZ), b.parts)
                data[island.Name] = {
                    center = {cx, cy, cz},
                    size = {b.maxX - b.minX, b.maxY - b.minY, b.maxZ - b.minZ},
                    min = {b.minX, b.minY, b.minZ},
                    max = {b.maxX, b.maxY, b.maxZ},
                    parts = b.parts,
                }
            end
            task.wait()
        end

        pcall(function()
            local t = Workspace:FindFirstChildOfClass("Terrain")
            if t then
                local e = t.MaxExtents
                lines[#lines + 1] = string.format("Terrain extents: min (%s, %s, %s) max (%s, %s, %s)",
                    fmt(e.Min.X), fmt(e.Min.Y), fmt(e.Min.Z), fmt(e.Max.X), fmt(e.Max.Y), fmt(e.Max.Z))
            end
        end)

        local text = table.concat(lines, "\n")
        print("================================")
        print(text)
        print("================================")
        save("IslandScan.json", HttpService:JSONEncode(data))
        local copied = copy(text)
        status(copied and "Done. Summary copied + printed (F9 console)." or "Done. Printed to console (F9). No clipboard support.", GREEN)
        scanning = false
    end)
end)

--// ---------------------------------------------------------------- scan ground
GroundBtn.MouseButton1Click:Connect(function()
    if scanning then return end
    scanning = true
    status("Scanning ground...", AMBER)
    task.spawn(function()
        local root = getRoot()
        local islands = Workspace:FindFirstChild("Islands")
        if not (root and islands) then
            status("Need character + Workspace.Islands", RED)
            scanning = false
            return
        end

        local island = currentIsland(islands, root.Position)
        local b = island and islandBounds(island)
        if not b then
            status("Could not find your island", RED)
            scanning = false
            return
        end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = {island}

        local top = b.maxY + 100
        local depth = (b.maxY - b.minY) + 200
        local rows, count = {}, 0
        local lowest, highest = math.huge, -math.huge
        local z = b.minZ
        while z <= b.maxZ do
            local row = {}
            local x = b.minX
            while x <= b.maxX do
                local hit = Workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -depth, 0), params)
                if hit then
                    row[#row + 1] = string.format("(%d,%d,%d)", math.floor(x + 0.5), math.floor(hit.Position.Y + 0.5), math.floor(z + 0.5))
                    lowest = math.min(lowest, hit.Position.Y)
                    highest = math.max(highest, hit.Position.Y)
                    count += 1
                end
                x += GRID_STEP
            end
            if #row > 0 then rows[#rows + 1] = table.concat(row, " ") end
            z += GRID_STEP
            task.wait()
        end

        local text = string.format("GROUND GRID %s | step %d | %d samples | ground Y %s..%s\nformat (x,y,z)\n%s",
            island.Name, GRID_STEP, count, fmt(lowest), fmt(highest), table.concat(rows, "\n"))
        print("================================")
        print(text)
        print("================================")
        save("GroundScan_" .. island.Name:gsub("%s+", "") .. ".txt", text)
        local copied = copy(text)
        status(string.format("%s: %d samples, ground Y %s..%s. %s", island.Name, count, fmt(lowest), fmt(highest),
            copied and "Copied." or "Printed to console."), GREEN)
        scanning = false
    end)
end)

--// ---------------------------------------------------------------- waypoint recorder
local points = {}

RecordBtn.MouseButton1Click:Connect(function()
    local root = getRoot()
    if not root then status("No character", RED) return end
    local p = root.Position
    points[#points + 1] = string.format("Vector3.new(%.3f, %.3f, %.3f),", p.X, p.Y, p.Z)
    print("[POINT " .. #points .. "] " .. points[#points])
    status("Recorded " .. #points .. " point(s)", GREEN)
end)

CopyBtn.MouseButton1Click:Connect(function()
    if #points == 0 then status("No points recorded", AMBER) return end
    local text = table.concat(points, "\n")
    print(text)
    save("RecordedPoints.txt", text)
    status(copy(text) and ("Copied " .. #points .. " points") or "Printed to console", GREEN)
end)

ClearBtn.MouseButton1Click:Connect(function()
    table.clear(points)
    status("Points cleared", GREEN)
end)
