--==================================================
-- SORT BEST TO NORMAL
--==================================================

local function GetHorseStats(horse)

    local item = horse.item

    local mainColour,
        maneColour,
        tailColour =
        GetColours(item)

    local variants =
        item.variants
        or item.Variants
        or {}

    local HasHorn =
        variants.hornColour ~= nil
        and tostring(variants.hornColour) ~= ""

    local HasNatDyed =
        item.isNatDyed ~= nil

    local HasUniqueHair =
        IsUniqueHair(maneColour)
        or IsUniqueHair(tailColour)

    local MainTailDifferent =
        not ColoursMatch(mainColour, tailColour)

    local priority = 0

    if HasUniqueHair then
        priority = 4
    elseif MainTailDifferent then
        priority = 3
    elseif HasNatDyed then
        priority = 2
    elseif HasHorn then
        priority = 1
    end

    local specialCount = 0

    if HasUniqueHair then specialCount += 1 end
    if MainTailDifferent then specialCount += 1 end
    if HasNatDyed then specialCount += 1 end
    if HasHorn then specialCount += 1 end

    return priority, specialCount
end

local function GetHorsePriority(horse)
    local priority = GetHorseStats(horse)
    return priority
end

table.sort(HorseList, function(a, b)

    local priorityA, countA = GetHorseStats(a)
    local priorityB, countB = GetHorseStats(b)

    -- Highest priority group always comes first.
    if priorityA ~= priorityB then
        return priorityA > priorityB
    end

    -- Within the same priority, horses with more special
    -- properties come first.
    if countA ~= countB then
        return countA > countB
    end

    return tostring(a.uid) < tostring(b.uid)
end)

-- HORSE LIST IS SORTED BEST -> NORMAL
-- 4 = Unique Hair
-- 3 = Main != Tail
-- 2 = Nat Dyed
-- 1 = Horn Colour
-- 0 = Normal
--==================================================
--==================================================
-- PRIORITY SORT
--==================================================

local function GetHorsePriority(horse)

    local item =
        horse.item

    local mainColour,
        maneColour,
        tailColour =
        GetColours(item)

    local variants =
        item.variants
        or item.Variants
        or {}

    local HasHorn =
        variants.hornColour ~= nil
        and tostring(variants.hornColour) ~= ""

    local HasNatDyed =
        item.isNatDyed ~= nil

    local HasUniqueHair =
        IsUniqueHair(maneColour)
        or IsUniqueHair(tailColour)

    local ManeTailDifferent =
        not ColoursMatch(mainColour, tailColour)

    -- 1 = RED / Unique Hair / BEST
    if HasUniqueHair then
        return 1
    end

    -- 2 = BLUE / Mane and Tail different
    if ManeTailDifferent then
        return 2
    end

    -- 3 = GREEN / Nat Dyed
    if HasNatDyed then
        return 3
    end

    -- 4 = PURPLE / Horn Colour
    if HasHorn then
        return 4
    end

    -- 5 = GREY / Normal
    return 5
end

local function SortHorsesByPriority()

    table.sort(
        HorseList,
        function(a, b)

            local pa =
                GetHorsePriority(a)

            local pb =
                GetHorsePriority(b)

            if pa ~= pb then
                return pa < pb
            end

            -- Keep a predictable order within the same priority.
            return tostring(a.uid) < tostring(b.uid)

        end
    )

end

