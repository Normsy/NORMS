--==================================================
-- FORMAT COLOUR
--==================================================

local function FormatValue(value)
    if value == nil or value == "" then
        return "Not Found"
    end

    value = tostring(value)

    -- glacierBlue -> Glacier Blue
    value = value:gsub("(%l)(%u)", "%1 %2")
    value = value:gsub("(%a)(%d)", "%1 %2")

    return value:gsub("^%l", string.upper)
end

--==================================================
-- CREATE PROFILE CARD
--==================================================

local function CreateProfile(horse)
    local Card = Instance.new("Frame")
    Card.Name = "HorseProfile"
    Card.Size = UDim2.new(1, -5, 0, 185)
    Card.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Card.BorderSizePixel = 0
    Card.Parent = Scroll

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Card

    local CardStroke = Instance.new("UIStroke")
    CardStroke.Color = Color3.fromRGB(50, 50, 50)
    CardStroke.Thickness = 1
    CardStroke.Parent = Card

    -- Header
    local Header = Instance.new("TextLabel")
    Header.Size = UDim2.new(1, -20, 0, 30)
    Header.Position = UDim2.fromOffset(10, 5)
    Header.BackgroundTransparency = 1
    Header.Text = "🐴  HORSE PROFILE"
    Header.TextColor3 = Color3.fromRGB(255, 255, 255)
    Header.TextSize = 14
    Header.Font = Enum.Font.GothamBold
    Header.TextXAlignment = Enum.TextXAlignment.Left
    Header.Parent = Card

    -- Divider
    local Divider = Instance.new("Frame")
    Divider.Size = UDim2.new(1, -20, 0, 1)
    Divider.Position = UDim2.fromOffset(10, 37)
    Divider.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    Divider.BorderSizePixel = 0
    Divider.Parent = Card

    -- Fields
    local fields = {
        {"UID", horse.UID},
        {"Breed", horse.Breed},
        {"Main Colour", horse.MainColour},
        {"Mane Colour", horse.ManeColour},
        {"Tail Colour", horse.TailColour}
    }

    for i, data in ipairs(fields) do
        local Label = Instance.new("TextLabel")

        Label.Size = UDim2.new(1, -20, 0, 25)
        Label.Position = UDim2.fromOffset(10, 40 + ((i - 1) * 27))
        Label.BackgroundTransparency = 1

        Label.Text =
            data[1] .. ": " .. FormatValue(data[2])

        Label.TextColor3 =
            i == 2
            and Color3.fromRGB(255, 220, 120)
            or Color3.fromRGB(220, 220, 220)

        Label.TextSize = 13
        Label.Font = Enum.Font.Gotham
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.TextTruncate = Enum.TextTruncate.AtEnd
        Label.Parent = Card
    end

    return Card
end

--==================================================
-- REFRESH PROFILES
--==================================================

local function RefreshProfiles()
    for _, child in ipairs(Scroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local search = string.lower(SearchBox.Text)

    local count = 0

    for _, horse in ipairs(HorseProfiles) do
        local uid = string.lower(tostring(horse.UID or ""))
        local breed = string.lower(tostring(horse.Breed or ""))

        if search == ""
            or string.find(uid, search, 1, true)
            or string.find(breed, search, 1, true)
        then
            CreateProfile(horse)
            count += 1
        end
    end

    Status.Text = "Profiles: " .. count
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(RefreshProfiles)

--==================================================
-- ADD HORSE
--==================================================

local function AddHorse(uid, breed, mainColour, maneColour, tailColour)
    table.insert(HorseProfiles, {
        UID = uid,
        Breed = breed,
        MainColour = mainColour,
        ManeColour = maneColour,
        TailColour = tailColour
    })

    RefreshProfiles()
end

