local function NormalizeUniqueHair(value)
    return tostring(value or ""):lower():gsub("[%s_%-]", "")
end

local function IsUniqueHair(value)
    return UniqueHair[NormalizeUniqueHair(value)] == true
end

local function ColoursMatch(a,b)
    if a == b then return true end
    if type(a) == "table" and type(b) == "table" then
        local function norm(v)
            if type(v) ~= "table" then return tostring(v) end
            local keys={}
            for k in pairs(v) do table.insert(keys,k) end
            table.sort(keys,function(x,y) return tostring(x)<tostring(y) end)
            local parts={}
            for _,k in ipairs(keys) do table.insert(parts,tostring(k).."="..norm(v[k])) end
            return "{"..table.concat(parts,";").."}"
        end
        return norm(a)==norm(b)
    end
    return tostring(a or ""):lower()==tostring(b or ""):lower()
end

