--==================================================
-- NORMALIZE BREED
--==================================================

local function NormalizeBreed(value)

    if value == nil then
        return nil
    end

    local text = tostring(value)

    if text == "" then
        return nil
    end

    local lower = text:lower()

    -- Exact known breed
    for key, displayName in pairs(BreedNames) do

        if lower == key then
            return displayName
        end

        if lower == displayName:lower() then
            return displayName
        end

    end

    -- Search inside a longer string
    for key, displayName in pairs(BreedNames) do

        if lower:find(key, 1, true) then
            return displayName
        end

    end

    -- If the game already gives a breed name
    if lower:find("horse", 1, true) then
        return text
    end

    return nil
end

--==================================================
-- GET FIELD
--==================================================

local function GetField(tbl, names)

    if type(tbl) ~= "table" then
        return nil
    end

    for _, key in ipairs(names) do

        if tbl[key] ~= nil then
            return tbl[key]
        end

    end

    return nil
end

--==================================================
-- BREED RESOLUTION
--==================================================

local function FindBreedInTable(tbl)

    if type(tbl) ~= "table" then
        return nil
    end

    local value = GetField(tbl, {

        "breed",
        "Breed",

        "breedName",
        "BreedName",

        "horseBreed",
        "HorseBreed",

        "breedId",
        "BreedId",

        "breedID",
        "BreedID"

    })

    local result =
        NormalizeBreed(value)

    if result then
        return result
    end

    return nil
end

--==================================================
-- TRY ITEM INFO
--==================================================

local function GetItemInfo(item)

    if type(item) ~= "table" then
        return nil
    end

    if not References then
        return nil
    end

    if not References.Items then
        return nil
    end

    local itemId =
        item.id
        or item.ID
        or item.Id

    if not itemId then
        return nil
    end

    local ok, result =
        pcall(function()

            return References.Items.GetInfo(itemId)

        end)

    if ok and type(result) == "table" then
        return result
    end

    return nil
end

--==================================================
-- SEARCH KNOWN BREED
--==================================================

local function SearchKnownBreed(tbl)

    if type(tbl) ~= "table" then
        return nil
    end

    -- First check direct breed fields
    local direct =
        FindBreedInTable(tbl)

    if direct then
        return direct
    end

    -- Search string values
    for _, value in pairs(tbl) do

        if type(value) == "string" then

            local result =
                NormalizeBreed(value)

            if result then
                return result
            end

        end

    end

    return nil
end

--==================================================
-- RESOLVE BREED
--==================================================

local function GetBreed(item, info)

    -- 1. Direct item breed
    local breed =
        FindBreedInTable(item)

    if breed then
        return breed
    end

    -- 2. Item info breed
    breed =
        FindBreedInTable(info)

    if breed then
        return breed
    end

    -- 3. Common nested data
    if type(item) == "table" then

        local nestedNames = {

            "data",
            "Data",

            "attributes",
            "Attributes",

            "horse",
            "Horse",

            "stats",
            "Stats",

            "variants",
            "Variants"

        }

        for _, key in ipairs(nestedNames) do

            if type(item[key]) == "table" then

                breed =
                    FindBreedInTable(
                        item[key]
                    )

                if breed then
                    return breed
                end

            end

        end

    end

    -- 4. Search known breed in item
    breed =
        SearchKnownBreed(item)

    if breed then
        return breed
    end

    -- 5. Search known breed in item info
    breed =
        SearchKnownBreed(info)

    if breed then
        return breed
    end

    -- 6. Try pId lookup
    local pId

    if type(item) == "table" then

        pId =
            item.pId
            or item.PId
            or item.pid
            or item.PID

    end

    if type(info) == "table" then

        pId =
            pId
            or info.pId
            or info.PId
            or info.pid
            or info.PID

    end

    if pId
        and References
        and References.Items then

        local attempts = {

            pId,
            tostring(pId)

        }

        for _, lookupId in ipairs(attempts) do

            local ok, result =
                pcall(function()

                    return References.Items.GetInfo(
                        lookupId
                    )

                end)

            if ok and type(result) == "table" then

                breed =
                    FindBreedInTable(result)

                if breed then
                    return breed
                end

                breed =
                    SearchKnownBreed(result)

                if breed then
                    return breed
                end

            end

        end

    end

    return "Breed Data Not Exposed"
end

--==================================================
-- COLOURS
--==================================================

local function GetColours(item)

    if type(item) ~= "table" then

        return
            "Colour Data Not Found",
            "Colour Data Not Found",
            "Colour Data Not Found"

    end

    local variants =
        item.variants

    if type(variants) ~= "table" then

        variants =
            item.Variants

    end

    if type(variants) ~= "table" then

        return
            "Colour Data Not Found",
            "Colour Data Not Found",
            "Colour Data Not Found"

    end

    local mainColour =
        variants.colour
        or variants.mainColour
        or variants.MainColour
        or variants.Color
        or variants.color

    local maneColour =
        variants.maneColour
        or variants.ManeColour
        or variants.maneColor
        or variants.ManeColor

    local tailColour =
        variants.tailColour
        or variants.TailColour
        or variants.tailColor
        or variants.TailColor

    return

        tostring(
            mainColour
            or "Colour Data Not Found"
        ),

        tostring(
            maneColour
            or "Colour Data Not Found"
        ),

        tostring(
            tailColour
            or "Colour Data Not Found"
        )

end

--==================================================
-- IS HORSE
--==================================================

local function IsHorse(item)

    if type(item) ~= "table" then
        return false
    end

    -- Horse variant data
    local variants =
        item.variants

    if type(variants) ~= "table" then
        variants = item.Variants
    end

    if type(variants) == "table" then

        if variants.colour
            or variants.mainColour
            or variants.MainColour
            or variants.maneColour
            or variants.ManeColour
            or variants.tailColour
            or variants.TailColour then

            return true
        end

    end

    -- Direct breed fields
    if item.breed
        or item.Breed
        or item.breedName
        or item.BreedName
        or item.horseBreed
        or item.HorseBreed then

        return true
    end

    return false
end

