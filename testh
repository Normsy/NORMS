local function getValue(obj, names)
    for _, name in ipairs(names) do
        local a = obj:GetAttribute(name)
        if a ~= nil and tostring(a) ~= "" then
            return tostring(a)
        end

        local child = obj:FindFirstChild(name, true)
        if child and child:IsA("ValueBase") and child.Value ~= nil then
            local v = tostring(child.Value)
            if v ~= "" then return v end
        end
    end
    return nil
end

local function looksLikeHorse(obj)
    local n = string.lower(obj.Name)
    if string.find(n, "horse") then return true end

    local breed = getValue(obj, {"Breed", "BreedName", "HorseBreed", "Species"})
    local uid = getValue(obj, {"UID", "Uid", "UniqueId", "UUID", "Id"})
    local color = getValue(obj, {"Color", "Colour", "Coat", "HorseColor", "HorseColour"})

    return breed ~= nil and (uid ~= nil or color ~= nil)
end

local function getHorseData(obj)
    local uid = getValue(obj, {"UID", "Uid", "UniqueId", "UUID", "Id"}) or obj:GetAttribute("UID") or "N/A"
    local breed = getValue(obj, {"Breed", "BreedName", "HorseBreed", "Species"}) or obj.Name
    local color = getValue(obj, {"Color", "Colour", "Coat", "HorseColor", "HorseColour"}) or "N/A"

    return tostring(uid), tostring(breed), tostring(color)
end

local function clearList()
    for _, child in ipairs(List:GetChildren()) do
        if not child:IsA("UIGridLayout") then
            child:Destroy()
        end
    end
end

local function addCard(uid, breed, color, index)
    local Card = Instance.new("TextButton")
    Card.Name = "HorseCard_" .. index
    Card.Size = UDim2.new(0,116,0,92)
    Card.BackgroundColor3 = Color3.fromRGB(29,29,35)
    Card.BorderSizePixel = 0
    Card.Text = ""
    Card.AutoButtonColor = false
    Card.LayoutOrder = index
    Card.Parent = List
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 6)

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(47,47,55)
    Stroke.Thickness = 1
    Stroke.Parent = Card

    local Info = Instance.new("TextLabel")
    Info.Size = UDim2.new(1,-12,1,-10)
    Info.Position = UDim2.new(0,6,0,5)
    Info.BackgroundTransparency = 1
    Info.Text = "uid: " .. uid .. "\nbreed name: " .. breed .. "\ncolor: " .. color
    Info.TextColor3 = Color3.fromRGB(225,225,230)
    Info.TextSize = 8
    Info.Font = Enum.Font.Gotham
    Info.TextWrapped = true
    Info.TextXAlignment = Enum.TextXAlignment.Left
    Info.TextYAlignment = Enum.TextYAlignment.Top
    Info.Parent = Card

    Card.MouseEnter:Connect(function()
        Card.BackgroundColor3 = Color3.fromRGB(37,37,44)
    end)
    Card.MouseLeave:Connect(function()
        Card.BackgroundColor3 = Color3.fromRGB(29,29,35)
    end)
    Card.MouseButton1Click:Connect(function()
        print("Selected horse:", uid, breed, color)
    end)
end

local function scanInventory()
    clearList()

    local roots = {
        LocalPlayer,
        LocalPlayer:FindFirstChild("Backpack"),
        LocalPlayer.Character,
        LocalPlayer:FindFirstChild("PlayerGui"),
    }

    local seen = {}
    local horses = {}

    for _, root in ipairs(roots) do
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                if not seen[obj] and looksLikeHorse(obj) then
                    seen[obj] = true
                    local uid, breed, color = getHorseData(obj)
                    table.insert(horses, {
                        uid = uid,
                        breed = breed,
                        color = color
                    })
                end
            end
        end
    end

    -- Also check direct children in case the horse entries themselves are roots.
    for _, root in ipairs(roots) do
        if root and looksLikeHorse(root) and not seen[root] then
            seen[root] = true
            local uid, breed, color = getHorseData(root)
            table.insert(horses, {uid=uid, breed=breed, color=color})
        end
    end

    table.sort(horses, function(a,b)
        return string.lower(a.breed) < string.lower(b.breed)
    end)

    for i, horse in ipairs(horses) do
        addCard(horse.uid, horse.breed, horse.color, i)
    end

    Count.Text = tostring(#horses) .. " horses"
end

Refresh.MouseButton1Click:Connect(scanInventory)

scanInventory()

-- Refresh automatically when inventory containers change.
local function hook(root)
    if not root then return end
    root.DescendantAdded:Connect(function()
        task.wait(0.15)
        scanInventory()
    end)
    root.DescendantRemoving:Connect(function()
        task.wait(0.15)
        scanInventory()
    end)
end

hook(LocalPlayer)
hook(LocalPlayer:FindFirstChild("Backpack"))
hook(LocalPlayer.Character)