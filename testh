-- HORSE LIST
--==================================================

local HorseList = {}

--==================================================
-- SCAN ENTIRE INVENTORY
--==================================================

local function ScanInventory()

    table.clear(HorseList)

    local totalEntries = 0

    for uid, item in pairs(Inventory) do

        totalEntries += 1

        if type(item) == "table" then

            local info =
                GetItemInfo(item)

            local isHorse, breed =
                IsBreedProfile(
                    item,
                    info
                )

            if isHorse then

                table.insert(
                    HorseList,
                    {
                        uid = uid,
                        item = item,
                        info = info,
                        breed = breed
                    }
                )

            end

        end

    end

    return totalEntries
end

--==================================================
-- CREATE PROFILE
--==================================================

local function CreateProfile(
    horse,
    order
)

    local uid =
        horse.uid

    local item =
        horse.item

    local info =
        horse.info

    local breed =
        horse.breed
        or GetBreed(
            item,
            info
        )
        or "Unknown"

    local mainColour,
        maneColour,
        tailColour =
        GetColours(item)

    local Card =
        Instance.new("Frame")

    Card.Size =
        UDim2.fromOffset(
            95,
            68
        )

    Card.BackgroundColor3 =
        Color3.fromRGB(
            24,
            24,
            32
        )

    Card.BorderSizePixel = 0

    Card.LayoutOrder =
        order

    Card.Parent =
        Results

    local Corner =
        Instance.new("UICorner")

    Corner.CornerRadius =
        UDim.new(
            0,
            5
        )

    Corner.Parent =
        Card

    local Stroke =
        Instance.new("UIStroke")

    local variants =
        item.variants
        or item.Variants
        or {}

    local HasHorn =
        variants.hornColour ~= nil
        and tostring(variants.hornColour) ~= ""

    local HasNatDyed =
        item.isNatDyed ~= nil

    local HasUniqueHair = IsUniqueHair(maneColour) or IsUniqueHair(tailColour)
    local HasOrangeMain = IsOrangeMainColour(mainColour)
    local MainTailDifferent = not ColoursMatch(mainColour, tailColour)

    -- RED = Unique Hair (BEST / highest priority)
    if HasUniqueHair then

        Stroke.Color =
            Color3.fromRGB(
                255,
                0,
                0
            )

        Stroke.Thickness = 2

    -- ORANGE = Special Main Colour (2nd best)
    elseif HasOrangeMain then
        Stroke.Color = Color3.fromRGB(255,140,0)
        Stroke.Thickness = 2

    -- BLUE = Main and Tail are different (3rd best)
    elseif MainTailDifferent then

        Stroke.Color =
            Color3.fromRGB(
                0,
                170,
                255
            )

        Stroke.Thickness = 2

    -- GREEN = Nat Dyed (3rd best)
    elseif HasNatDyed then

        Stroke.Color =
            Color3.fromRGB(
                0,
                255,
                0
            )

        Stroke.Thickness = 2

    -- PURPLE = Horn Colour (4th best)
    elseif HasHorn then

        Stroke.Color =
            Color3.fromRGB(
                170,
                0,
                255
            )

        Stroke.Thickness = 2

    else

        Stroke.Color =
            Color3.fromRGB(
                42,
                42,
                52
            )

        Stroke.Thickness = 1

    end

    Stroke.Parent =
        Card

    --==============================================
    -- SPECIAL INDICATOR CIRCLES
    -- Red = Unique Hair
    -- Blue = Main and Tail are different
    -- Green = Nat Dyed
    -- Purple = Horn Colour
    -- Every matching indicator is shown, even when
    -- another condition wins the main outline priority.
    --==============================================

    local IndicatorContainer =
        Instance.new("Frame")

    IndicatorContainer.Size =
        UDim2.fromOffset(40, 10)

    IndicatorContainer.Position =
        UDim2.new(1, -41, 0, 3)

    IndicatorContainer.BackgroundTransparency = 1
    IndicatorContainer.Parent = Card

    local function AddIndicator(color, x)

        local Circle =
            Instance.new("Frame")

        Circle.Size =
            UDim2.fromOffset(7, 7)

        Circle.Position =
            UDim2.fromOffset(x, 1)

        Circle.BackgroundColor3 = color
        Circle.BorderSizePixel = 0
        Circle.Parent = IndicatorContainer

        local CircleCorner =
            Instance.new("UICorner")

        CircleCorner.CornerRadius =
            UDim.new(1, 0)

        CircleCorner.Parent = Circle

        local CircleStroke =
            Instance.new("UIStroke")

        CircleStroke.Color =
            Color3.fromRGB(255, 255, 255)

        CircleStroke.Thickness = 1
        CircleStroke.Parent = Circle
    end

    local IndicatorX = 0

    -- Red = Unique Hair
    if HasUniqueHair then
        AddIndicator(
            Color3.fromRGB(255, 0, 0),
            IndicatorX
        )
        IndicatorX = IndicatorX + 8
    end

    -- Orange = Special Main Colour
    if HasOrangeMain then
        AddIndicator(Color3.fromRGB(255,140,0), IndicatorX)
        IndicatorX = IndicatorX + 8
    end

    -- Blue = Main and Tail are different
    if MainTailDifferent then
        AddIndicator(
            Color3.fromRGB(0, 170, 255),
            IndicatorX
        )
        IndicatorX = IndicatorX + 8
    end

    -- Green = Nat Dyed
    if HasNatDyed then
        AddIndicator(
            Color3.fromRGB(0, 255, 0),
            IndicatorX
        )
        IndicatorX = IndicatorX + 8
    end

    -- Purple = Horn Colour
    if HasHorn then
        AddIndicator(
            Color3.fromRGB(170, 0, 255),
            IndicatorX
        )
        IndicatorX = IndicatorX + 8
    end

    --==============================================
    -- PROFILE TITLE
    --==============================================

    --==============================================
    -- FIVE FIELDS
    --==============================================

    local BreedLabel =
        Instance.new("TextLabel")

    BreedLabel.Size =
        UDim2.new(1, -5, 0, 9)

    BreedLabel.Position =
        UDim2.fromOffset(3, 2)

    BreedLabel.BackgroundTransparency = 1
    BreedLabel.Text = tostring(breed)
    BreedLabel.TextColor3 =
        Color3.fromRGB(255, 215, 100)
    BreedLabel.TextSize = 5
    BreedLabel.Font = Enum.Font.GothamBold
    BreedLabel.TextXAlignment = Enum.TextXAlignment.Left
    BreedLabel.TextTruncate = Enum.TextTruncate.AtEnd
    BreedLabel.Parent = Card

    local Rows = {

        {
            "Main",
            tostring(mainColour)
        },

        {
            "Mane",
            tostring(maneColour)
        },

        {
            "Tail",
            tostring(tailColour)
        }

    }

    for i, row in ipairs(Rows) do

        local Label =
            Instance.new("TextLabel")

        Label.Size =
            UDim2.new(
                1,
                -5,
                0,
                8
            )

        Label.Position =
            UDim2.fromOffset(
                3,
                12
                    + ((i - 1) * 9)
            )

        Label.BackgroundTransparency = 1

        Label.Text =
            row[1]
            .. ": "
            .. row[2]

        Label.TextColor3 =
            Color3.fromRGB(
                215,
                215,
                225
            )

        Label.TextSize = 5

        Label.Font =
            Enum.Font.Gotham

        Label.TextXAlignment =
            Enum.TextXAlignment.Left

        Label.TextYAlignment =
            Enum.TextYAlignment.Center

        Label.TextTruncate =
            Enum.TextTruncate.AtEnd

        Label.Parent =
            Card

    end

    local UIDLabel =
        Instance.new("TextLabel")

    UIDLabel.Size =
        UDim2.new(1, -5, 0, 7)

    UIDLabel.Position =
        UDim2.fromOffset(3, 59)

    UIDLabel.BackgroundTransparency = 1
    UIDLabel.Text = "UID: " .. tostring(uid)
    UIDLabel.TextColor3 =
        Color3.fromRGB(105, 115, 135)
    UIDLabel.TextSize = 4
    UIDLabel.Font = Enum.Font.Gotham
    UIDLabel.TextXAlignment = Enum.TextXAlignment.Left
    UIDLabel.TextTruncate = Enum.TextTruncate.AtEnd
    UIDLabel.Parent = Card

end

--==================================================
-- SORT BEST TO NORMAL
--==================================================

local function GetHorseStats(horse)
    local mainColour,maneColour,tailColour=GetColours(horse.item)
    local variants=horse.item.variants or horse.item.Variants or {}
    local unique=IsUniqueHair(maneColour) or IsUniqueHair(tailColour)
    local orange=IsOrangeMainColour(mainColour)
    local mismatch=not ColoursMatch(mainColour,tailColour)
    local natdyed=horse.item.isNatDyed ~= nil
    local horn=variants.hornColour ~= nil and tostring(variants.hornColour) ~= ""
    local priority=0
    if unique then priority=5 elseif orange then priority=4 elseif mismatch then priority=3 elseif natdyed then priority=2 elseif horn then priority=1 end
    local count=0
    if unique then count+=1 end; if orange then count+=1 end; if mismatch then count+=1 end; if natdyed then count+=1 end; if horn then count+=1 end
    return priority,count
end

local function SortHorseList()
    table.sort(HorseList,function(a,b)
        local pa,ca=GetHorseStats(a); local pb,cb=GetHorseStats(b)
        if pa~=pb then return pa>pb end
        if ca~=cb then return ca>cb end
        return tostring(a.uid)<tostring(b.uid)
    end)
end

local function MatchesSelectedFilter(horse)
    if SelectedFilter=="All" then return true end
    local main,mane,tail=GetColours(horse.item)
    local variants=horse.item.variants or horse.item.Variants or {}
    local unique=IsUniqueHair(mane) or IsUniqueHair(tail)
    local orange=IsOrangeMainColour(main)
    local mismatch=not ColoursMatch(main,tail)
    local natdyed=horse.item.isNatDyed ~= nil
    local horn=variants.hornColour ~= nil and tostring(variants.hornColour) ~= ""
    if SelectedFilter=="Red - Unique Hair" then return unique end
    if SelectedFilter=="Orange - Special Main Colour" then return orange end
    if SelectedFilter=="Blue - Mismatched Hair" then return mismatch end
    if SelectedFilter=="Green - Nat Dyed" then return natdyed end
    if SelectedFilter=="Purple - Horn Colour" then return horn end
    if SelectedFilter=="Grey - Normal" then return not unique and not orange and not mismatch and not natdyed and not horn end
    return false
end

local function GetSellRemote()
    local name=tostring(RemoteNameBox.Text or ""):match("^%s*(.-)%s*$")
    if name=="" then return nil,"Enter the RemoteEvent name first." end
    local Events=ReplicatedStorage:WaitForChild("Communication"):WaitForChild("Events")
    local remote=Events:FindFirstChild(name)
    if not remote then return nil,"RemoteEvent not found: "..name end
    if not remote:IsA("RemoteEvent") then return nil,name.." is not a RemoteEvent." end
    return remote
end

DisplayHorses=function()
    for _,child in ipairs(Results:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    local searchText=Search.Text:lower(); local shown=0
    for _,horse in ipairs(HorseList) do
        local breed=horse.breed or GetBreed(horse.item,horse.info) or "Unknown"
        local searchable=tostring(horse.uid).." "..tostring(breed)
        if (searchText=="" or searchable:lower():find(searchText,1,true)) and MatchesSelectedFilter(horse) then
            shown+=1; CreateProfile(horse,shown)
        end
    end
    Status.Text="Horses: "..tostring(shown).." / "..tostring(#HorseList)
    task.defer(UpdateCanvas)
end

Search:GetPropertyChangedSignal("Text"):Connect(function()
    if DisplayHorses then DisplayHorses() end
end)

SellButton.MouseButton1Click:Connect(function()
    local remote,err=GetSellRemote()
    if not remote then SellStatus.Text=err; SellStatus.TextColor3=Color3.fromRGB(255,110,110); return end
    local ItemsToSell={}; local count=0
    for _,horse in ipairs(HorseList) do if MatchesSelectedFilter(horse) then ItemsToSell[tostring(horse.uid)]=1; count+=1 end end
    if count==0 then SellStatus.Text="Nothing matches: "..SelectedFilter; SellStatus.TextColor3=Color3.fromRGB(255,190,100); return end
    local ok,sendErr=pcall(function() remote:FireServer("SellItems",ItemsToSell) end)
    if not ok then SellStatus.Text="Sell failed: "..tostring(sendErr); SellStatus.TextColor3=Color3.fromRGB(255,110,110); return end
    SellStatus.Text="Sent sell request: "..tostring(count).." horse(s) ["..SelectedFilter.."]"; SellStatus.TextColor3=Color3.fromRGB(100,255,130)
    task.delay(0.5,function()
        local ok2,newInv=pcall(function() return Data.GetLocal({"inventory"}) end)
        if ok2 and type(newInv)=="table" then Inventory=newInv; ScanInventory(); SortHorseList(); DisplayHorses() end
    end)
end)

