TopBar.InputBegan:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        Dragging = true

        DragStart =
            input.Position

        StartPosition =
            Main.Position

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if not Dragging then
        return
    end

    if input.UserInputType ==
        Enum.UserInputType.MouseMovement
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        local Delta =
            input.Position
            - DragStart

        Main.Position =
            UDim2.new(

                StartPosition.X.Scale,
                StartPosition.X.Offset
                    + Delta.X,

                StartPosition.Y.Scale,
                StartPosition.Y.Offset
                    + Delta.Y

            )

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        Dragging = false

    end

end)

--==================================================
-- HORSE LIST
--==================================================

local HorseList = {}

--==================================================
-- SCAN ENTIRE INVENTORY
--==================================================

local function ScanInventory()

    table.clear(HorseList)

    local totalEntries = 0

    for uid, item in pairs(Inventory) do

        totalEntries += 1

        if type(item) == "table" then

            local info =
                GetItemInfo(item)

            local isHorse, breed =
                IsBreedProfile(
                    item,
                    info
                )

            if isHorse then

                table.insert(
                    HorseList,
                    {
                        uid = uid,
                        item = item,
                        info = info,
                        breed = breed
                    }
                )

            end

        end

    end

    return totalEntries
end

--==================================================
-- CREATE PROFILE
--==================================================

local function CreateProfile(horse, order)
    local uid = horse.uid
    local item = horse.item
    local info = horse.info
    local breed = horse.breed or GetBreed(item,info) or "Unknown"
    local mainColour,maneColour,tailColour = GetColours(item)

    local variants = item.variants or item.Variants or {}
    local HasHorn = variants.hornColour ~= nil and tostring(variants.hornColour) ~= ""
    local HasNatDyed = item.isNatDyed == true
    local HasUniqueHair = IsUniqueHair(maneColour) or IsUniqueHair(tailColour)
    local MainTailDifferent = not ColoursMatch(mainColour,tailColour)

    local priority = 0
    if HasUniqueHair then priority=4
    elseif MainTailDifferent then priority=3
    elseif HasNatDyed then priority=2
    elseif HasHorn then priority=1 end

    local Card = Instance.new("Frame")
    Card.Size = UDim2.fromOffset(82,78)
    Card.BackgroundColor3 = Color3.fromRGB(24,24,32)
    Card.BorderSizePixel = 0
    Card.LayoutOrder = order
    Card:SetAttribute("HorsePriority",priority)
    Card.Parent = Results

    local Corner=Instance.new("UICorner")
    Corner.CornerRadius=UDim.new(0,5)
    Corner.Parent=Card

    local Stroke=Instance.new("UIStroke")
    if priority==4 then Stroke.Color=Color3.fromRGB(255,0,0); Stroke.Thickness=2
    elseif priority==3 then Stroke.Color=Color3.fromRGB(0,170,255); Stroke.Thickness=2
    elseif priority==2 then Stroke.Color=Color3.fromRGB(0,255,0); Stroke.Thickness=2
    elseif priority==1 then Stroke.Color=Color3.fromRGB(170,0,255); Stroke.Thickness=2
    else Stroke.Color=Color3.fromRGB(42,42,52); Stroke.Thickness=1 end
    Stroke.Parent=Card

