--==================================================
-- NORMALIZE TEXT
--==================================================

local function NormalizeText(value)

    if value == nil then
        return ""
    end

    local text = tostring(value):lower()

    text = text:gsub(
        "_",
        " "
    )

    text = text:gsub(
        "-",
        " "
    )

    text = text:gsub(
        "%s+",
        " "
    )

    return text:match(
        "^%s*(.-)%s*$"
    )
end

--==================================================
-- FIND BREED KEYWORD
--==================================================

local function FindBreedKeyword(value)

    if value == nil then
        return nil
    end

    local text =
        NormalizeText(value)

    if text == "" then
        return nil
    end

    for _, keyword in ipairs(
        BreedKeywords
    ) do

        local normalizedKeyword =
            NormalizeText(keyword)

        if text == normalizedKeyword then

            return BreedDisplayNames[keyword]

        end

        if text:find(
            normalizedKeyword,
            1,
            true
        ) then

            return BreedDisplayNames[keyword]

        end

    end

    return nil
end

