--==================================================
-- NORMALIZE BREED
--==================================================

local function NormalizeBreed(value)

    if value == nil then
        return nil
    end

    local text =
        tostring(value)

    if text == "" then
        return nil
    end

    local lower =
        text:lower()

    -- Exact match
    for key, displayName in pairs(
        BreedNames
    ) do

        if lower == key then
            return displayName
        end

        if lower == displayName:lower() then
            return displayName
        end

    end

    -- Search inside text
    for key, displayName in pairs(
        BreedNames
    ) do

        if lower:find(
            key,
            1,
            true
        ) then

            return displayName

        end

    end

    -- Already contains Horse
    if lower:find(
        "horse",
        1,
        true
    ) then

        return text

    end

    return nil
end

--==================================================
-- GET FIELD
--==================================================

local function GetField(
    tbl,
    names
)

    if type(tbl) ~= "table" then
        return nil
    end

    for _, key in ipairs(names) do

        if tbl[key] ~= nil then
            return tbl[key]
        end

    end

    return nil
end

--==================================================
-- FIND BREED
--==================================================

local function FindBreedInTable(tbl)

    if type(tbl) ~= "table" then
        return nil
    end

    local value =
        GetField(
            tbl,
            {
                "breed",
                "Breed",

                "breedName",
                "BreedName",

                "horseBreed",
                "HorseBreed",

                "breedId",
                "BreedId",

                "breedID",
                "BreedID"
            }
        )

    return NormalizeBreed(value)
end

--==================================================
-- SEARCH TABLE FOR BREED
--==================================================

local function SearchKnownBreed(
    tbl,
    depth
)

    if type(tbl) ~= "table" then
        return nil
    end

    depth = depth or 0

    -- Prevent excessive recursion
    if depth > 4 then
        return nil
    end

    -- Direct fields first
    local direct =
        FindBreedInTable(tbl)

    if direct then
        return direct
    end

    for key, value in pairs(tbl) do

        if type(value) == "string" then

            local result =
                NormalizeBreed(value)

            if result then
                return result
            end

        elseif type(value) == "table" then

            local result =
                SearchKnownBreed(
                    value,
                    depth + 1
                )

            if result then
                return result
            end

        end

    end

    return nil
end

--==================================================
-- ITEM INFO
--==================================================

local function GetItemInfo(item)

    if type(item) ~= "table" then
        return nil
    end

    if not References then
        return nil
    end

    if not References.Items then
        return nil
    end

    local itemId =
        item.id
        or item.ID
        or item.Id

    if not itemId then
        return nil
    end

    local ok, result =
        pcall(function()

            return References.Items.GetInfo(
                itemId
            )

        end)

    if ok and type(result) == "table" then
        return result
    end

    return nil
end

--==================================================
-- BREED RESOLVER
--==================================================

local function GetBreed(
    item,
    info
)

    -- Direct item
    local breed =
        FindBreedInTable(item)

    if breed then
        return breed
    end

    -- Item info
    breed =
        FindBreedInTable(info)

    if breed then
        return breed
    end

    -- Nested item data
    if type(item) == "table" then

        local nestedNames = {

            "data",
            "Data",

            "attributes",
            "Attributes",

            "horse",
            "Horse",

            "stats",
            "Stats",

            "variants",
            "Variants"

        }

        for _, key in ipairs(
            nestedNames
        ) do

            if type(item[key]) == "table" then

                breed =
                    SearchKnownBreed(
                        item[key]
                    )

                if breed then
                    return breed
                end

            end

        end

    end

    -- Search item
    breed =
        SearchKnownBreed(item)

    if breed then
        return breed
    end

    -- Search info
    breed =
        SearchKnownBreed(info)

    if breed then
        return breed
    end

    --==================================================
    -- pId LOOKUP
    --==================================================

    local pId

    if type(item) == "table" then

        pId =
            item.pId
            or item.PId
            or item.pid
            or item.PID

    end

    if type(info) == "table" then

        pId =
            pId
            or info.pId
            or info.PId
            or info.pid
            or info.PID

    end

    if pId
        and References
        and References.Items
        and type(
            References.Items.GetInfo
        ) == "function" then

        local attempts = {

            pId,
            tostring(pId)

        }

        for _, lookupId in ipairs(
            attempts
        ) do

            local ok, result =
                pcall(function()

                    return References.Items.GetInfo(
                        lookupId
                    )

                end)

            if ok and type(result) == "table" then

                breed =
                    SearchKnownBreed(result)

                if breed then
                    return breed
                end

            end

        end

    end

    return "Breed Data Not Exposed"
end

--==================================================
-- COLOURS
--==================================================

local function GetColours(item)

    if type(item) ~= "table" then

        return
            "Colour Data Not Found",
            "Colour Data Not Found",
            "Colour Data Not Found"

    end

    local variants =
        item.variants

    if type(variants) ~= "table" then
        variants =
            item.Variants
    end

    if type(variants) ~= "table" then

        return
            "Colour Data Not Found",
            "Colour Data Not Found",
            "Colour Data Not Found"

    end

    local mainColour =
        variants.colour
        or variants.mainColour
        or variants.MainColour
        or variants.color
        or variants.Color

    local maneColour =
        variants.maneColour
        or variants.ManeColour
        or variants.maneColor
        or variants.ManeColor

    local tailColour =
        variants.tailColour
        or variants.TailColour
        or variants.tailColor
        or variants.TailColor

    return

        tostring(
            mainColour
            or "Colour Data Not Found"
        ),

        tostring(
            maneColour
            or "Colour Data Not Found"
        ),

        tostring(
            tailColour
            or "Colour Data Not Found"
        )

end

--==================================================
-- IS HORSE
--==================================================

local function IsHorse(item)

    if type(item) ~= "table" then
        return false
    end

    local variants =
        item.variants

    if type(variants) ~= "table" then
        variants =
            item.Variants
    end

    if type(variants) == "table" then

        if variants.colour
            or variants.mainColour
            or variants.MainColour
            or variants.maneColour
            or variants.ManeColour
            or variants.tailColour
            or variants.TailColour then

            return true
        end

    end

    if item.breed
        or item.Breed
        or item.breedName
        or item.BreedName
        or item.horseBreed
        or item.HorseBreed then

        return true
    end

    return false
end

