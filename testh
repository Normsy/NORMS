-- HORSE LIST
--==================================================

local HorseList = {}

--==================================================
-- SCAN ENTIRE INVENTORY
--==================================================

local function ScanInventory()

    table.clear(HorseList)

    local totalEntries = 0

    for uid, item in pairs(Inventory) do

        totalEntries += 1

        if type(item) == "table" then

            local info =
                GetItemInfo(item)

            local isHorse, breed =
                IsBreedProfile(
                    item,
                    info
                )

            if isHorse then

                table.insert(
                    HorseList,
                    {
                        uid = uid,
                        item = item,
                        info = info,
                        breed = breed
                    }
                )

            end

        end

    end

    return totalEntries
end

