    ProfileTitle.Text =
        "PROFILE "
        .. tostring(order)

    ProfileTitle.TextColor3 =
        Color3.fromRGB(
            255,
            215,
            100
        )

    ProfileTitle.TextSize = 7

    ProfileTitle.Font =
        Enum.Font.GothamBold

    ProfileTitle.TextXAlignment =
        Enum.TextXAlignment.Left

    ProfileTitle.Parent =
        Card

    --==============================================
    -- FIVE FIELDS
    --==============================================

    local Rows = {

        {
            "UID",
            tostring(uid)
        },

        {
            "Breed",
            tostring(breed)
        },

        {
            "Main",
            tostring(mainColour)
        },

        {
            "Mane",
            tostring(maneColour)
        },

        {
            "Tail",
            tostring(tailColour)
        }

    }

    for i, row in ipairs(Rows) do

        local Label =
            Instance.new("TextLabel")

        Label.Size =
            UDim2.new(
                1,
                -8,
                0,
                14
            )

        Label.Position =
            UDim2.fromOffset(
                4,
                18
                    + ((i - 1) * 15)
            )

        Label.BackgroundTransparency = 1

        Label.Text =
            row[1]
            .. ": "
            .. row[2]

        Label.TextColor3 =
            i == 2

            and Color3.fromRGB(
                255,
                215,
                100
            )

            or Color3.fromRGB(
                215,
                215,
                225
            )

        Label.TextSize = 6

        Label.Font =
            Enum.Font.Gotham

        Label.TextXAlignment =
            Enum.TextXAlignment.Left

        Label.TextYAlignment =
            Enum.TextYAlignment.Center

        Label.TextTruncate =
            Enum.TextTruncate.AtEnd

        Label.Parent =
            Card

    end

end

--==================================================
-- DISPLAY
--==================================================

local function DisplayHorses()

    for _, child in ipairs(
        Results:GetChildren()
    ) do

        if child:IsA("Frame") then
            child:Destroy()
        end

    end

    local searchText =
        Search.Text:lower()

    local shown = 0

    for _, horse in ipairs(
        HorseList
    ) do

        local breed =
            horse.breed
            or GetBreed(
                horse.item,
                horse.info
            )
            or "Unknown"

        local searchable =
            tostring(horse.uid)
            .. " "
            .. tostring(breed)

        if searchText == ""
            or searchable:lower():find(
                searchText,
                1,
                true
            ) then

            shown += 1

            CreateProfile(
                horse,
                shown
            )

        end

    end

    Status.Text =
        "Horses: "
        .. tostring(shown)
        .. " / "
        .. tostring(#HorseList)

    task.defer(
        UpdateCanvas
    )

end

