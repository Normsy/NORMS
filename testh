--==================================================
-- SORT BEST TO NORMAL
--==================================================

local function GetHorseStats(horse)
    local main,mane,tail=GetColours(horse.item)
    local v=horse.item.variants or horse.item.Variants or {}
    local unique=IsUniqueHair(mane) or IsUniqueHair(tail)
    local mismatch=not ColoursMatch(main,tail)
    local nat=horse.item.isNatDyed == true
    local horn=v.hornColour ~= nil and tostring(v.hornColour) ~= ""
    local priority=unique and 4 or mismatch and 3 or nat and 2 or horn and 1 or 0
    local count=(unique and 1 or 0)+(mismatch and 1 or 0)+(nat and 1 or 0)+(horn and 1 or 0)
    return priority,count
end

table.sort(HorseList,function(a,b)
    local pa,ca=GetHorseStats(a)
    local pb,cb=GetHorseStats(b)
    if pa~=pb then return pa>pb end
    if ca~=cb then return ca>cb end
    return tostring(a.uid)<tostring(b.uid)
end)

