--==================================================
-- NORMALIZATION
--==================================================

local function NormalizeText(text)
    if text == nil then
        return ""
    end

    text = tostring(text):lower()

    text = text:gsub("_", " ")
    text = text:gsub("%-", " ")

    -- Remove:
    -- (V1)
    -- (V2)
    -- (V3)
    -- etc.
    text = text:gsub("%s*%(%s*v%d+%s*%)", " ")

    -- Remove versions at the end:
    -- V1
    -- V2
    -- V10
    text = text:gsub("%s+v%d+%s*$", " ")

    -- Remove extra spaces
    text = text:gsub("%s+", " ")
    text = text:gsub("^%s+", "")
    text = text:gsub("%s+$", "")

    return text
end

--==================================================
-- BREED SEARCH
--==================================================

local BreedFields = {
    "breed",
    "Breed",

    "breedName",
    "BreedName",

    "horseBreed",
    "HorseBreed",

    "breedType",
    "BreedType",

    "horseType",
    "HorseType",

    "animalType",
    "AnimalType",

    "species",
    "Species",

    "type",
    "Type",

    "name",
    "Name",

    "itemName",
    "ItemName",

    "displayName",
    "DisplayName",

    "Display",
    "display"
}

local function MatchBreed(text)
    if text == nil then
        return nil
    end

    local normalized = NormalizeText(text)

    if normalized == "" then
        return nil
    end

    for _, keyword in ipairs(BreedKeywords) do
        local normalizedKeyword = NormalizeText(keyword)

        if normalized:find(normalizedKeyword, 1, true) then
            return BreedDisplayNames[normalizedKeyword]
                or tostring(text)
        end
    end

    return nil
end

local function SearchBreedData(data, depth, visited)
    if depth > 12 then
        return nil
    end

    if type(data) ~= "table" then
        return MatchBreed(data)
    end

    visited = visited or {}

    if visited[data] then
        return nil
    end

    visited[data] = true

    -- First check known breed-related fields
    for _, field in ipairs(BreedFields) do
        local value = data[field]

        if value ~= nil then
            local result = MatchBreed(value)

            if result then
                return result
            end
        end
    end

    -- Search nested data
    for key, value in pairs(data) do
        if type(value) == "string" then
            local keyText = tostring(key):lower()

            -- Only trust text from fields that can reasonably
            -- describe an animal/item.
            if keyText:find("breed", 1, true)
                or keyText:find("horse", 1, true)
                or keyText:find("animal", 1, true)
                or keyText:find("species", 1, true)
                or keyText == "type"
                or keyText == "name"
                or keyText:find("item", 1, true)
                or keyText:find("display", 1, true)
            then
                local result = MatchBreed(value)

                if result then
                    return result
                end
            end

        elseif type(value) == "table" then
            local result = SearchBreedData(
                value,
                depth + 1,
                visited
            )

            if result then
                return result
            end
        end
    end

    return nil
end

--==================================================
-- ITEM INFO
--==================================================

local function GetItemInfo(item)
    if not item or type(item) ~= "table" then
        return nil
    end

    local itemId =
        item.pId
        or item.PId
        or item.pid
        or item.itemId
        or item.ItemId
        or item.id
        or item.Id

    if not itemId then
        return nil
    end

    if References
        and References.Items
        and References.Items.GetInfo
    then
        local ok, info = pcall(function()
            return References.Items.GetInfo(itemId)
        end)

        if ok and type(info) == "table" then
            return info
        end
    end

    return nil
end

--==================================================
-- BREED DETECTION
--==================================================

local function GetBreed(item, info)
    -- Check actual inventory data first
    local breed = SearchBreedData(item, 0, {})

    if breed then
        return breed
    end

    -- Then item info
    if info then
        breed = SearchBreedData(info, 0, {})

        if breed then
            return breed
        end
    end

    -- Finally inspect pId through item information
    if item then
        local pId =
            item.pId
            or item.PId
            or item.pid

        if pId and References
            and References.Items
            and References.Items.GetInfo
        then
            local ok, pInfo = pcall(function()
                return References.Items.GetInfo(pId)
            end)

            if ok and type(pInfo) == "table" then
                breed = SearchBreedData(pInfo, 0, {})

                if breed then
                    return breed
                end
            end
        end
    end

    return nil
end

--==================================================
-- COLOURS
--==================================================

local function GetColours(item)
    local variants

    if type(item) == "table" then
        variants =
            item.variants
            or item.Variants
            or item.variant
            or item.Variant
    end

    if type(variants) ~= "table" then
        return "Unknown", "Unknown", "Unknown"
    end

    local mainColour =
        variants.colour
        or variants.color
        or variants.mainColour
        or variants.mainColor
        or variants.MainColour
        or variants.MainColor

    local maneColour =
        variants.maneColour
        or variants.maneColor
        or variants.ManeColour
        or variants.ManeColor

    local tailColour =
        variants.tailColour
        or variants.tailColor
        or variants.TailColour
        or variants.TailColor

    return (
        mainColour and tostring(mainColour) or "Unknown"
    ), (
        maneColour and tostring(maneColour) or "Unknown"
    ), (
        tailColour and tostring(tailColour) or "Unknown"
    )
end

--==================================================
-- INVENTORY RECURSIVE SCANNER
--==================================================

local HorseList = {}
local SeenTables = {}
local SeenUIDs = {}

local function ScanInventory(data, path, depth)
    if depth > 15 then
        return
    end

    if type(data) ~= "table" then
        return
    end

    if SeenTables[data] then
        return
    end

    SeenTables[data] = true

    for key, value in pairs(data) do
        if type(value) == "table" then

            local uid =
                value.uid
                or value.UID
                or value.Uid
                or value.uniqueId
                or value.UniqueId
                or value.id
                or value.Id

            -- If the table itself has no UID, use its inventory key.
            if uid == nil and key ~= nil then
                uid = key
            end

            local info = GetItemInfo(value)
            local breed = GetBreed(value, info)

            if breed then
                local uidText = tostring(uid)

                -- Prevent duplicate horse entries
                if not SeenUIDs[uidText] then
                    SeenUIDs[uidText] = true

                    local mainColour,
                        maneColour,
                        tailColour =
                        GetColours(value)

                    table.insert(HorseList, {
                        uid = uidText,
                        breed = breed,
                        mainColour = mainColour,
                        maneColour = maneColour,
                        tailColour = tailColour,
                        item = value,
                        info = info
                    })
                end
            end

            -- Continue scanning nested inventory tables
            ScanInventory(
                value,
                tostring(path) .. "." .. tostring(key),
                depth + 1
            )
        end
    end
end

ScanInventory(Inventory, "inventory", 0)

