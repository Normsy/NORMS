--==================================================
-- HORSE PROFILE CARD
--==================================================

local function AddHorse(
    uid,
    item,
    info,
    index
)

    local Card = Instance.new("Frame")

    Card.Size =
        UDim2.new(1, -2, 0, 145)

    Card.BackgroundColor3 =
        Color3.fromRGB(23, 23, 32)

    Card.BorderSizePixel = 0

    Card.LayoutOrder = index
    Card.Parent = Results

    local CardCorner = Instance.new("UICorner")
    CardCorner.CornerRadius = UDim.new(0, 8)
    CardCorner.Parent = Card

    local CardStroke = Instance.new("UIStroke")
    CardStroke.Color = Color3.fromRGB(42, 42, 54)
    CardStroke.Thickness = 1
    CardStroke.Parent = Card

    --==================================================
    -- HEADER
    --==================================================

    local Header = Instance.new("TextLabel")

    Header.Size =
        UDim2.new(1, -20, 0, 25)

    Header.Position =
        UDim2.fromOffset(10, 7)

    Header.BackgroundTransparency = 1

    Header.Text =
        "HORSE PROFILE"

    Header.TextColor3 =
        Color3.fromRGB(57, 255, 20)

    Header.TextSize = 9
    Header.Font = Enum.Font.GothamBold

    Header.TextXAlignment =
        Enum.TextXAlignment.Left

    Header.Parent = Card

    --==================================================
    -- DATA
    --==================================================

    local breed =
        GetBreed(item, info)

    local mainColour,
        maneColour,
        tailColour =
        GetColours(item)

    --==================================================
    -- FIELD CREATOR
    --==================================================

    local function CreateField(
        label,
        value,
        y
    )

        local Field = Instance.new("Frame")

        Field.Size =
            UDim2.new(1, -20, 0, 20)

        Field.Position =
            UDim2.fromOffset(10, y)

        Field.BackgroundColor3 =
            Color3.fromRGB(18, 18, 26)

        Field.BorderSizePixel = 0

        Field.Parent = Card

        local FieldCorner =
            Instance.new("UICorner")

        FieldCorner.CornerRadius =
            UDim.new(0, 4)

        FieldCorner.Parent = Field

        -- Label

        local Label =
            Instance.new("TextLabel")

        Label.Size =
            UDim2.new(0.38, 0, 1, 0)

        Label.Position =
            UDim2.fromOffset(8, 0)

        Label.BackgroundTransparency = 1

        Label.Text =
            label

        Label.TextColor3 =
            Color3.fromRGB(125, 130, 145)

        Label.TextSize = 7
        Label.Font = Enum.Font.GothamBold

        Label.TextXAlignment =
            Enum.TextXAlignment.Left

        Label.Parent = Field

        -- Value

        local Value =
            Instance.new("TextLabel")

        Value.Size =
            UDim2.new(0.62, -10, 1, 0)

        Value.Position =
            UDim2.new(0.38, 0, 0, 0)

        Value.BackgroundTransparency = 1

        Value.Text =
            tostring(value)

        Value.TextColor3 =
            Color3.fromRGB(235, 235, 245)

        Value.TextSize = 7
        Value.Font = Enum.Font.Gotham

        Value.TextXAlignment =
            Enum.TextXAlignment.Right

        Value.TextTruncate =
            Enum.TextTruncate.AtEnd

        Value.Parent = Field
    end

    --==================================================
    -- PROFILE DATA
    --==================================================

    CreateField(
        "UID",
        uid,
        34
    )

    CreateField(
        "BREED",
        breed,
        56
    )

    CreateField(
        "MAIN COLOUR",
        mainColour,
        78
    )

    CreateField(
        "MANE COLOUR",
        maneColour,
        100
    )

    CreateField(
        "TAIL COLOUR",
        tailColour,
        122
    )

end