--==================================================
-- SEARCH TABLE FOR BREED
--==================================================

local function SearchBreedData(
    tbl,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end

    depth = depth or 0
    visited = visited or {}

    if depth > 10 then
        return nil
    end

    if visited[tbl] then
        return nil
    end

    visited[tbl] = true

    --==============================================
    -- CHECK EXPLICIT BREED FIELDS FIRST
    --==============================================

    for _, field in ipairs(
        BreedFields
    ) do

        local value =
            tbl[field]

        if value ~= nil then

            local breed =
                FindBreedKeyword(value)

            if breed then
                return breed
            end

        end

    end

    --==============================================
    -- SEARCH ALL NESTED DATA
    --==============================================

    for key, value in pairs(tbl) do

        if type(value) == "table" then

            local breed =
                SearchBreedData(
                    value,
                    depth + 1,
                    visited
                )

            if breed then
                return breed
            end

        elseif type(value) == "string" then

            local normalizedKey =
                NormalizeText(key)

            local relevant =
                normalizedKey:find(
                    "breed",
                    1,
                    true
                )

                or normalizedKey:find(
                    "horse",
                    1,
                    true
                )

                or normalizedKey:find(
                    "animal",
                    1,
                    true
                )

                or normalizedKey:find(
                    "species",
                    1,
                    true
                )

                or normalizedKey:find(
                    "type",
                    1,
                    true
                )

                or normalizedKey:find(
                    "name",
                    1,
                    true
                )

                or normalizedKey:find(
                    "item",
                    1,
                    true
                )

            if relevant then

                local breed =
                    FindBreedKeyword(value)

                if breed then
                    return breed
                end

            end

        end

    end

    return nil
end

--==================================================
-- GET ITEM INFO
--==================================================

local function GetItemInfo(item)

    if type(item) ~= "table" then
        return nil
    end

    if not References
        or not References.Items then

        return nil
    end

    local itemId =
        item.id
        or item.ID
        or item.Id

    if not itemId then
        return nil
    end

    local ok, result =
        pcall(function()

            return References.Items.GetInfo(
                itemId
            )

        end)

    if ok and type(result) == "table" then
        return result
    end

    return nil
end

--==================================================
-- GET BREED
--==================================================

local function GetBreed(
    item,
    info
)

    -- Search inventory item
    local breed =
        SearchBreedData(item)

    if breed then
        return breed
    end

    -- Search item definition
    breed =
        SearchBreedData(info)

    if breed then
        return breed
    end

    --==============================================
    -- pId LOOKUP
    --==============================================

    local pId

    if type(item) == "table" then

        pId =
            item.pId
            or item.PId
            or item.pid

    end

    if type(info) == "table" then

        pId =
            pId
            or info.pId
            or info.PId
            or info.pid

    end

    if pId
        and References
        and References.Items
        and type(
            References.Items.GetInfo
        ) == "function" then

        local ok, result =
            pcall(function()

                return References.Items.GetInfo(
                    pId
                )

            end)

        if ok and type(result) == "table" then

            breed =
                SearchBreedData(result)

            if breed then
                return breed
            end

        end

    end

    return nil
end

--==================================================
-- CHECK IF INVENTORY ENTRY IS A PROFILE
--==================================================

local function IsBreedProfile(
    item,
    info
)

    local breed =
        GetBreed(
            item,
            info
        )

    if breed then
        return true, breed
    end

    return false, nil
end

--==================================================
-- GET COLOURS
--==================================================

local function GetColours(item)

    if type(item) ~= "table" then

        return
            "Unknown",
            "Unknown",
            "Unknown"

    end

    local variants =
        item.variants
        or item.Variants

    if type(variants) ~= "table" then

        return
            "Unknown",
            "Unknown",
            "Unknown"

    end

    local mainColour =
        variants.colour
        or variants.mainColour
        or variants.MainColour

    local maneColour =
        variants.maneColour
        or variants.ManeColour

    local tailColour =
        variants.tailColour
        or variants.TailColour

    return
        tostring(
            mainColour or "Unknown"
        ),

        tostring(
            maneColour or "Unknown"
        ),

        tostring(
            tailColour or "Unknown"
        )
end

