--==================================================
-- CREATE PROFILE
--==================================================

local function CreateProfile(
    uid,
    item,
    info,
    order
)

    local Card =
        Instance.new("Frame")

    Card.Size =
        UDim2.new(
            1,
            -2,
            0,
            113
        )

    Card.BackgroundColor3 =
        Color3.fromRGB(24, 24, 32)

    Card.BorderSizePixel = 0

    Card.LayoutOrder =
        order

    Card.Parent = Results

    local Corner =
        Instance.new("UICorner")

    Corner.CornerRadius =
        UDim.new(0, 6)

    Corner.Parent = Card

    local breed =
        GetBreed(
            item,
            info
        )

    local mainColour,
        maneColour,
        tailColour =
        GetColours(item)

    --==================================================
    -- FIVE ROWS
    --==================================================

    local Rows = {

        {
            "UID",
            tostring(uid)
        },

        {
            "Breed",
            breed
        },

        {
            "Main Colour",
            mainColour
        },

        {
            "Mane Colour",
            maneColour
        },

        {
            "Tail Colour",
            tailColour
        }

    }

    for i, row in ipairs(Rows) do

        local Label =
            Instance.new("TextLabel")

        Label.Size =
            UDim2.new(
                1,
                -12,
                0,
                19
            )

        Label.Position =
            UDim2.fromOffset(
                6,
                4 + ((i - 1) * 21)
            )

        Label.BackgroundTransparency = 1

        Label.Text =
            row[1]
            .. ": "
            .. tostring(row[2])

        Label.TextColor3 =
            i == 2
            and Color3.fromRGB(
                255,
                215,
                100
            )
            or Color3.fromRGB(
                220,
                220,
                230
            )

        Label.TextSize = 8

        Label.Font =
            Enum.Font.Gotham

        Label.TextXAlignment =
            Enum.TextXAlignment.Left

        Label.TextTruncate =
            Enum.TextTruncate.AtEnd

        Label.Parent = Card

    end
end

--==================================================
-- DISPLAY HORSES
--==================================================

local function DisplayHorses()

    for _, child in ipairs(
        Results:GetChildren()
    ) do

        if child:IsA("Frame") then
            child:Destroy()
        end

    end

    local searchText =
        Search.Text:lower()

    local shown = 0

    for _, horse in ipairs(HorseList) do

        local breed =
            GetBreed(
                horse.item,
                horse.info
            )

        local searchable =
            tostring(horse.uid)
            .. " "
            .. tostring(breed)

        if searchText == ""
            or searchable:lower():find(
                searchText,
                1,
                true
            ) then

            shown += 1

            CreateProfile(
                horse.uid,
                horse.item,
                horse.info,
                shown
            )

        end
    end

    Status.Text =
        "Horses: "
        .. tostring(shown)
        .. " / "
        .. tostring(#HorseList)

end

--==================================================
-- SCAN WHOLE INVENTORY
--==================================================

for uid, item in pairs(Inventory) do

    if type(item) == "table"
        and IsHorse(item) then

        local info =
            GetItemInfo(item)

        table.insert(
            HorseList,
            {
                uid = uid,
                item = item,
                info = info
            }
        )

    end

end

