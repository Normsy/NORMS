--==================================================
-- HORSES CACHE
--==================================================

local Horses = {}

--==================================================
-- PERFORM SCAN
--==================================================

local function PerformScan()

    if not inventoryLoaded then

        Status.Text =
            "STATUS: Inventory is not loaded."

        Status.TextColor3 =
            Color3.fromRGB(
                255,
                80,
                80
            )

        return
    end

    ClearResults()

    table.clear(Horses)

    Status.Text =
        "STATUS: Scanning inventory..."

    Status.TextColor3 =
        Color3.fromRGB(
            251,
            191,
            36
        )

    -- Direct inventory scan

    for uid, item in pairs(
        Inventory
    ) do

        if type(item) == "table"
            and IsHorse(item) then

            local info =
                GetItemInfo(item)

            Horses[#Horses + 1] = {

                UID =
                    tostring(uid),

                Item =
                    item,

                Info =
                    info

            }

        end

    end

    local query =
        Search.Text:lower()

    local shown = 0

    for _, horse in ipairs(
        Horses
    ) do

        local breed =
            GetBreed(
                horse.Item,
                horse.Info
            )

        local searchable =
            horse.UID
            .. " "
            .. breed

        if query == ""
            or searchable:lower():find(
                query,
                1,
                true
            ) then

            shown += 1

            AddHorse(
                horse.UID,
                horse.Item,
                horse.Info,
                shown
            )

        end

    end

    Status.Text =
        "STATUS: "
        .. tostring(shown)
        .. " horses found"

    Status.TextColor3 =
        Color3.fromRGB(
            57,
            255,
            20
        )

end

--==================================================
-- SEARCH
--==================================================

Search:GetPropertyChangedSignal(
    "Text"
):Connect(function()

    if inventoryLoaded then
        PerformScan()
    end

end)

