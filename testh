end

--==================================================
-- SCAN
--==================================================

local AllHorses = {}

local function Scan()

    ClearResults()

    table.clear(AllHorses)

    Status.Text =
        "STATUS: Scanning..."

    Status.TextColor3 =
        Color3.fromRGB(251, 191, 36)

    local inventory =
        GetInventory()

    if not inventory then

        Status.Text =
            "STATUS: Inventory unavailable"

        Status.TextColor3 =
            Color3.fromRGB(239, 68, 68)

        return
    end

    -- Only scan direct inventory entries.
    -- No recursive scanning to prevent freezing.

    for uid, item in pairs(inventory) do

        if type(item) == "table"
            and IsHorse(item) then

            local info =
                GetItemInfo(item)

            AllHorses[#AllHorses + 1] = {

                UID = tostring(uid),

                Item = item,

                Info = info
            }
        end
    end

    local query =
        Search.Text:lower()

    local shown = 0

    for _, horse in ipairs(AllHorses) do

        local item = horse.Item
        local info = horse.Info

        local name =
            tostring(
                item.name
                or item.Name
                or "Unnamed Horse"
            )

        local breed =
            GetBreed(item, info)

        local searchable =
            horse.UID
            .. " "
            .. name
            .. " "
            .. breed

        if query == ""
            or searchable:lower():find(
                query,
                1,
                true
            ) then

            shown += 1

            AddHorse(
                horse.UID,
                item,
                info,
                shown
            )
        end
    end

    Status.Text =
        "STATUS: "
        .. tostring(shown)
        .. " / "
        .. tostring(#AllHorses)
        .. " horses"

    Status.TextColor3 =
        Color3.fromRGB(57, 255, 20)
end

--==================================================
-- SEARCH EVENT
--==================================================

Search:GetPropertyChangedSignal(
    "Text"
):Connect(function()

    if #AllHorses > 0 then
        Scan()
    end
end)

--==================================================
-- DRAGGING
--==================================================

local dragging = false
local dragStart
local startPosition

Title.InputBegan:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        dragging = true

        dragStart =
            input.Position

        startPosition =
            Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)

    if not dragging then
        return
    end

    if input.UserInputType ==
        Enum.UserInputType.MouseMovement
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        local delta =
            input.Position - dragStart

        Main.Position =
            UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,

                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
    end
end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        dragging = false
    end
end)

