--==================================================
-- SEARCH BREED DATA
--==================================================

local function SearchBreedData(tbl, depth)

    if type(tbl) ~= "table" then
        return nil
    end

    depth = depth or 0

    if depth > 8 then
        return nil
    end

    -- First check explicit breed fields.
    for _, field in ipairs(BreedFields) do

        local value = tbl[field]

        if value ~= nil then

            local breed =
                FindBreedKeyword(value)

            if breed then
                return breed
            end

        end

    end

    -- Then inspect nested tables.
    for key, value in pairs(tbl) do

        if type(value) == "table" then

            local breed =
                SearchBreedData(
                    value,
                    depth + 1
                )

            if breed then
                return breed
            end

        elseif type(value) == "string" then

            -- Only inspect strings from fields that
            -- are likely to describe an item/animal.
            local keyName =
                NormalizeText(key)

            local relevant =
                keyName:find("breed", 1, true)
                or keyName:find("horse", 1, true)
                or keyName:find("animal", 1, true)
                or keyName:find("species", 1, true)
                or keyName:find("type", 1, true)
                or keyName:find("name", 1, true)
                or keyName:find("item", 1, true)

            if relevant then

                local breed =
                    FindBreedKeyword(value)

                if breed then
                    return breed
                end

            end

        end

    end

    return nil
end

--==================================================
-- GET ITEM INFO
--==================================================

local function GetItemInfo(item)

    if type(item) ~= "table" then
        return nil
    end

    if not References
        or not References.Items then
        return nil
    end

    local itemId =
        item.id
        or item.ID
        or item.Id

    if not itemId then
        return nil
    end

    local ok, result =
        pcall(function()
            return References.Items.GetInfo(itemId)
        end)

    if ok and type(result) == "table" then
        return result
    end

    return nil
end

--==================================================
-- GET BREED
--==================================================

local function GetBreed(item, info)

    -- Search actual inventory data
    local breed =
        SearchBreedData(item)

    if breed then
        return breed
    end

    -- Search item definition/info
    breed =
        SearchBreedData(info)

    if breed then
        return breed
    end

    -- pId lookup
    local pId

    if type(item) == "table" then
        pId =
            item.pId
            or item.PId
            or item.pid
    end

    if type(info) == "table" then
        pId =
            pId
            or info.pId
            or info.PId
            or info.pid
    end

    if pId
        and References
        and References.Items
        and type(
            References.Items.GetInfo
        ) == "function" then

        local ok, result =
            pcall(function()

                return References.Items.GetInfo(
                    pId
                )

            end)

        if ok and type(result) == "table" then

            breed =
                SearchBreedData(result)

            if breed then
                return breed
            end

        end

    end

    return nil
end

