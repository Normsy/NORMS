--==================================================
-- NORMALIZE TEXT
--==================================================

local function NormalizeText(value)

    if value == nil then
        return ""
    end

    local text = tostring(value):lower()

    text = text:gsub("[%p_]+", " ")
    text = text:gsub("%s+", " ")

    return text:match("^%s*(.-)%s*$")
end

--==================================================
-- FIND ALLOWED BREED
--==================================================

local function FindAllowedBreed(value)

    local text = NormalizeText(value)

    if text == "" then
        return nil
    end

    -- Exact matches first
    for key, displayName in pairs(AllowedBreeds) do

        if text == key then
            return displayName
        end

        if text == NormalizeText(displayName) then
            return displayName
        end

    end

    -- Partial matches
    for key, displayName in pairs(AllowedBreeds) do

        if text:find(key, 1, true) then
            return displayName
        end

    end

    return nil
end

--==================================================
-- GET FIELD
--==================================================

local function GetField(tbl, names)

    if type(tbl) ~= "table" then
        return nil
    end

    for _, key in ipairs(names) do

        if tbl[key] ~= nil then
            return tbl[key]
        end

    end

    return nil
end

--==================================================
-- FIND BREED IN TABLE
--==================================================

local function FindBreedInTable(tbl)

    if type(tbl) ~= "table" then
        return nil
    end

    local value = GetField(
        tbl,
        {
            "breed",
            "Breed",

            "breedName",
            "BreedName",

            "horseBreed",
            "HorseBreed",

            "breedType",
            "BreedType",

            "breedId",
            "BreedId"
        }
    )

    return FindAllowedBreed(value)
end

--==================================================
-- RECURSIVE BREED SEARCH
--==================================================

local function SearchAllowedBreed(tbl, depth)

    if type(tbl) ~= "table" then
        return nil
    end

    depth = depth or 0

    if depth > 6 then
        return nil
    end

    local direct = FindBreedInTable(tbl)

    if direct then
        return direct
    end

    for _, value in pairs(tbl) do

        if type(value) == "string" then

            local breed = FindAllowedBreed(value)

            if breed then
                return breed
            end

        elseif type(value) == "table" then

            local breed =
                SearchAllowedBreed(
                    value,
                    depth + 1
                )

            if breed then
                return breed
            end

        end

    end

    return nil
end

--==================================================
-- GET ITEM INFO
--==================================================

local function GetItemInfo(item)

    if type(item) ~= "table" then
        return nil
    end

    if not References
        or not References.Items then
        return nil
    end

    local itemId =
        item.id
        or item.ID
        or item.Id

    if not itemId then
        return nil
    end

    local ok, result =
        pcall(function()

            return References.Items.GetInfo(itemId)

        end)

    if ok and type(result) == "table" then
        return result
    end

    return nil
end

--==================================================
-- GET BREED
--==================================================

local function GetBreed(item, info)

    local breed

    -- Direct item
    breed = FindBreedInTable(item)

    if breed then
        return breed
    end

    -- Item info
    breed = FindBreedInTable(info)

    if breed then
        return breed
    end

    -- Search item
    breed = SearchAllowedBreed(item)

    if breed then
        return breed
    end

    -- Search item info
    breed = SearchAllowedBreed(info)

    if breed then
        return breed
    end

    -- pId lookup
    local pId

    if type(item) == "table" then

        pId =
            item.pId
            or item.PId
            or item.pid

    end

    if type(info) == "table" then

        pId =
            pId
            or info.pId
            or info.PId
            or info.pid

    end

    if pId
        and References
        and References.Items
        and type(
            References.Items.GetInfo
        ) == "function" then

        local attempts = {
            pId,
            tostring(pId)
        }

        for _, lookupId in ipairs(attempts) do

            local ok, result =
                pcall(function()

                    return References.Items.GetInfo(
                        lookupId
                    )

                end)

            if ok and type(result) == "table" then

                breed =
                    SearchAllowedBreed(result)

                if breed then
                    return breed
                end

            end

        end

    end

    return "Unknown Breed"
end

--==================================================
-- STRICT HORSE / DONKEY DETECTION
--==================================================

local function IsHorse(item)

    if type(item) ~= "table" then
        return false
    end

    -- Direct breed
    local breed =
        FindBreedInTable(item)

    if breed then
        return true
    end

    -- Nested structures
    local nestedKeys = {

        "data",
        "Data",

        "attributes",
        "Attributes",

        "horse",
        "Horse",

        "stats",
        "Stats",

        "config",
        "Config",

        "variants",
        "Variants"

    }

    for _, key in ipairs(nestedKeys) do

        if type(item[key]) == "table" then

            local found =
                SearchAllowedBreed(
                    item[key]
                )

            if found then
                return true
            end

        end

    end

    return false
end

--==================================================
-- GET COLOURS
--==================================================

local function GetColours(item)

    if type(item) ~= "table" then

        return
            "Colour Data Not Found",
            "Colour Data Not Found",
            "Colour Data Not Found"

    end

    local variants =
        item.variants
        or item.Variants

    if type(variants) ~= "table" then

        return
            "Colour Data Not Found",
            "Colour Data Not Found",
            "Colour Data Not Found"

    end

    local mainColour =
        variants.colour
        or variants.mainColour
        or variants.MainColour

    local maneColour =
        variants.maneColour
        or variants.ManeColour

    local tailColour =
        variants.tailColour
        or variants.TailColour

    return
        tostring(
            mainColour
            or "Colour Data Not Found"
        ),

        tostring(
            maneColour
            or "Colour Data Not Found"
        ),

        tostring(
            tailColour
            or "Colour Data Not Found"
        )
end

