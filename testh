    if not Dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local Delta = input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        Dragging = false

    end

end)

--==================================================
-- HORSE LIST
--==================================================

local HorseList = {}

--==================================================
-- SCAN ENTIRE INVENTORY
--==================================================

local function ScanInventory()

    table.clear(HorseList)

    local totalEntries = 0

    for uid, item in pairs(Inventory) do

        totalEntries += 1

        if type(item) == "table" then

            local info =
                GetItemInfo(item)

            local isHorse, breed =
                IsBreedProfile(
                    item,
                    info
                )

            if isHorse then

                table.insert(
                    HorseList,
                    {
                        uid = uid,
                        item = item,
                        info = info,
                        breed = breed
                    }
                )

            end

        end

    end

    return totalEntries
end

--==================================================
-- CREATE PROFILE
--==================================================

local function CreateProfile(
    horse,
    order
)

    local uid = horse.uid
    local item = horse.item
    local info = horse.info

    local breed =
        horse.breed
        or GetBreed(item, info)
        or "Unknown"

    local mainColour,
        maneColour,
        tailColour =
        GetColours(item)

    local Card =
        Instance.new("Frame")

    Card.BackgroundColor3 =
        Color3.fromRGB(8, 24, 42)

    Card.BorderSizePixel = 0
    Card.LayoutOrder = order
    Card.Parent = Results

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 13)
    Corner.Parent = Card

    local Stroke = Instance.new("UIStroke")

    local variants =
        item.variants
        or item.Variants
        or {}

    local HasHorn =
        variants.hornColour ~= nil
        and tostring(variants.hornColour) ~= ""

    local HasNatDyed =
        item.isNatDyed ~= nil

    local HasUniqueHair =
        IsUniqueHair(maneColour)
        or IsUniqueHair(tailColour)

    local MainTailDifferent =
        not ColoursMatch(mainColour, tailColour)

    -- RED = Unique Hair (BEST / highest priority)
    if HasUniqueHair then
        Stroke.Color = Color3.fromRGB(255, 45, 65)
        Stroke.Thickness = 2

    -- BLUE = Main and Tail are different (2nd best)
    elseif MainTailDifferent then
        Stroke.Color = Color3.fromRGB(0, 170, 255)
        Stroke.Thickness = 2

    -- GREEN = Nat Dyed (3rd best)
    elseif HasNatDyed then
        Stroke.Color = Color3.fromRGB(50, 255, 150)
        Stroke.Thickness = 2

    -- PURPLE = Horn Colour (4th best)
    elseif HasHorn then
        Stroke.Color = Color3.fromRGB(190, 50, 255)
        Stroke.Thickness = 2

    else
        Stroke.Color = Color3.fromRGB(22, 55, 85)
        Stroke.Thickness = 1
    end

    Stroke.Parent = Card

    --==================================================
    -- SPECIAL INDICATOR CIRCLES
    --==================================================

    local IndicatorContainer =
        Instance.new("Frame")

    IndicatorContainer.Size =
        UDim2.fromOffset(65, 20)

    IndicatorContainer.Position =
        UDim2.new(1, -76, 0, 9)

    IndicatorContainer.BackgroundTransparency = 1
    IndicatorContainer.Parent = Card

    local function AddIndicator(color, x)

        local Circle =
            Instance.new("Frame")

        Circle.Size = UDim2.fromOffset(13, 13)
        Circle.Position = UDim2.fromOffset(x, 2)
        Circle.BackgroundColor3 = color
        Circle.BorderSizePixel = 0
        Circle.Parent = IndicatorContainer

        local CircleCorner = Instance.new("UICorner")
        CircleCorner.CornerRadius = UDim.new(1, 0)
        CircleCorner.Parent = Circle

        local CircleStroke = Instance.new("UIStroke")
        CircleStroke.Color = Color3.fromRGB(255, 255, 255)
        CircleStroke.Thickness = 1
        CircleStroke.Transparency = 0.15
        CircleStroke.Parent = Circle

    end

    local IndicatorX = 0

    if HasUniqueHair then
        AddIndicator(Color3.fromRGB(255, 45, 65), IndicatorX)
        IndicatorX += 17
    end

    if MainTailDifferent then
        AddIndicator(Color3.fromRGB(0, 170, 255), IndicatorX)
        IndicatorX += 17
    end

    if HasNatDyed then
        AddIndicator(Color3.fromRGB(50, 255, 150), IndicatorX)
        IndicatorX += 17
    end

    if HasHorn then
        AddIndicator(Color3.fromRGB(190, 50, 255), IndicatorX)
    end

    --==================================================
    -- UID
    --==================================================

    local UIDLabel =
        Instance.new("TextLabel")

    UIDLabel.Size = UDim2.new(1, -95, 0, 18)
    UIDLabel.Position = UDim2.fromOffset(12, 8)
    UIDLabel.BackgroundTransparency = 1
    UIDLabel.Text = "UID: " .. tostring(uid)
    UIDLabel.TextColor3 = Color3.fromRGB(175, 200, 225)
    UIDLabel.TextSize = 9
    UIDLabel.Font = Enum.Font.Gotham
    UIDLabel.TextXAlignment = Enum.TextXAlignment.Left
    UIDLabel.TextTruncate = Enum.TextTruncate.AtEnd
    UIDLabel.Parent = Card

    --==================================================
    -- BREED
    --==================================================

    local BreedLabel =
        Instance.new("TextLabel")

    BreedLabel.Size = UDim2.new(1, -24, 0, 25)
    BreedLabel.Position = UDim2.fromOffset(12, 30)
    BreedLabel.BackgroundTransparency = 1
    BreedLabel.Text = tostring(breed)
    BreedLabel.TextColor3 = Color3.fromRGB(255, 214, 105)
    BreedLabel.TextSize = 13
    BreedLabel.Font = Enum.Font.GothamBold
    BreedLabel.TextXAlignment = Enum.TextXAlignment.Left
    BreedLabel.TextTruncate = Enum.TextTruncate.AtEnd
    BreedLabel.Parent = Card

    local Divider = Instance.new("Frame")
    Divider.Size = UDim2.new(1, -24, 0, 1)
    Divider.Position = UDim2.fromOffset(12, 58)
    Divider.BackgroundColor3 = Color3.fromRGB(20, 58, 92)
    Divider.BorderSizePixel = 0
    Divider.Parent = Card

    --==================================================
    -- DATA ROWS
    --==================================================

    local Rows = {
        {"Main", tostring(mainColour)},
        {"Mane", tostring(maneColour)},
        {"Tail", tostring(tailColour)}
    }

    for i, row in ipairs(Rows) do

        local Label =
            Instance.new("TextLabel")

        Label.Size = UDim2.new(1, -24, 0, 17)
        Label.Position = UDim2.fromOffset(12, 64 + ((i - 1) * 18))
        Label.BackgroundTransparency = 1
        Label.Text = row[1] .. ": " .. row[2]
        Label.TextColor3 = Color3.fromRGB(215, 225, 238)
        Label.TextSize = 9
        Label.Font = Enum.Font.Gotham
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.TextYAlignment = Enum.TextYAlignment.Center
        Label.TextTruncate = Enum.TextTruncate.AtEnd
        Label.Parent = Card

    end

end

--==================================================
-- DISPLAY
--==================================================

local function DisplayHorses()

    for _, child in ipairs(
        Results:GetChildren()
    ) do

        if child:IsA("Frame") then
            child:Destroy()
        end

    end

    local searchText =
        Search.Text:lower()

    local shown = 0

    for _, horse in ipairs(
        HorseList
    ) do

        local breed =
            horse.breed
            or GetBreed(
                horse.item,
                horse.info
            )
            or "Unknown"

        local searchable =
            tostring(horse.uid)
            .. " "
            .. tostring(breed)

        if searchText == ""
            or searchable:lower():find(
                searchText,
                1,
                true
            ) then

            shown += 1

            CreateProfile(
                horse,
                shown
            )

        end

    end

    Status.Text =
        tostring(shown)
        .. " / "
        .. tostring(#HorseList)
        .. " HORSES"

    task.defer(
        UpdateCanvas
    )

end

