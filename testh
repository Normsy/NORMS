--==================================================
-- FORMAT TEXT
--==================================================

local function FormatValue(Value)
    if Value == nil then
        return "Not Found"
    end

    local Text = tostring(Value)

    if Text == "" then
        return "Not Found"
    end

    Text = Text:gsub("(%l)(%u)", "%1 %2")
    Text = Text:gsub("(%a)(%d)", "%1 %2")

    return Text:gsub("^%l", string.upper)
end

--==================================================
-- NORMALIZE BREED
--==================================================

local function NormalizeBreed(Value)
    if Value == nil then
        return nil
    end

    local Text = tostring(Value)
    local Lower = string.lower(Text)

    -- Exact database match
    for Key, Display in pairs(BreedNames) do
        if Lower == Key then
            return Display
        end
    end

    -- Search inside text
    for Key, Display in pairs(BreedNames) do
        if string.find(Lower, Key, 1, true) then
            return Display
        end
    end

    -- Already contains horse
    if string.find(Lower, "horse", 1, true) then
        return FormatValue(Text)
    end

    return nil
end

--==================================================
-- RECURSIVE BREED SEARCH
--==================================================

local function FindBreed(Value, Depth)
    if Depth > 5 then
        return nil
    end

    local ValueType = typeof(Value)

    if ValueType == "string"
        or ValueType == "number" then

        return NormalizeBreed(Value)
    end

    if ValueType ~= "table" then
        return nil
    end

    -- Check common breed keys first
    local BreedKeys = {
        "breed",
        "Breed",
        "breedName",
        "BreedName",
        "horseBreed",
        "HorseBreed",
        "species",
        "Species",
        "name",
        "Name",
        "id",
        "Id",
        "ID",
        "pId",
        "PId",
        "pid"
    }

    for _, Key in ipairs(BreedKeys) do
        local Result = NormalizeBreed(Value[Key])

        if Result then
            return Result
        end
    end

    -- Search nested tables
    for Key, Child in pairs(Value) do
        if typeof(Child) == "table" then
            local Result = FindBreed(Child, Depth + 1)

            if Result then
                return Result
            end
        elseif typeof(Child) == "string" then
            local Result = NormalizeBreed(Child)

            if Result then
                return Result
            end
        end
    end

    return nil
end

--==================================================
-- GET COLOURS
--==================================================

local function GetColours(Item)
    local Variants = Item.variants or Item.Variants

    local MainColour
    local ManeColour
    local TailColour

    if typeof(Variants) == "table" then
        MainColour =
            Variants.colour
            or Variants.mainColour
            or Variants.MainColour

        ManeColour =
            Variants.maneColour
            or Variants.ManeColour

        TailColour =
            Variants.tailColour
            or Variants.TailColour
    end

    MainColour =
        MainColour
        or Item.colour
        or Item.mainColour
        or Item.MainColour

    ManeColour =
        ManeColour
        or Item.maneColour
        or Item.ManeColour

    TailColour =
        TailColour
        or Item.tailColour
        or Item.TailColour

    return MainColour, ManeColour, TailColour
end

--==================================================
-- CHECK IF HORSE
--==================================================

local function IsHorse(Item)
    if typeof(Item) ~= "table" then
        return false
    end

    -- Direct breed
    if FindBreed(Item, 0) then
        return true
    end

    -- Horse variants
    local Variants = Item.variants or Item.Variants

    if typeof(Variants) == "table" then
        if Variants.colour
            or Variants.mainColour
            or Variants.maneColour
            or Variants.tailColour
            or Variants.maneStyle
            or Variants.tailStyle then

            return true
        end
    end

    return false
end

--==================================================
-- CREATE PROFILE
--==================================================

local function CreateProfile(Horse)
    local Card = Instance.new("Frame")
    Card.Size = UDim2.new(1, -4, 0, 132)
    Card.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Card.BorderSizePixel = 0
    Card.Parent = Scroll

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Card

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(50, 50, 50)
    Stroke.Thickness = 1
    Stroke.Parent = Card

    -- Small profile header
    local Header = Instance.new("TextLabel")
    Header.Size = UDim2.new(1, -14, 0, 20)
    Header.Position = UDim2.fromOffset(7, 3)
    Header.BackgroundTransparency = 1
    Header.Text = "🐴  Horse Profile"
    Header.TextColor3 = Color3.fromRGB(255, 255, 255)
    Header.TextSize = 11
    Header.Font = Enum.Font.GothamBold
    Header.TextXAlignment = Enum.TextXAlignment.Left
    Header.Parent = Card

    -- Five rows
    local Rows = {
        {"UID", Horse.UID},
        {"Breed", Horse.Breed},
        {"Main Colour", Horse.MainColour},
        {"Mane Colour", Horse.ManeColour},
        {"Tail Colour", Horse.TailColour}
    }

    for Index, Row in ipairs(Rows) do
        local Label = Instance.new("TextLabel")

        Label.Size = UDim2.new(1, -14, 0, 20)
        Label.Position = UDim2.fromOffset(
            7,
            23 + ((Index - 1) * 21)
        )

        Label.BackgroundTransparency = 1

        Label.Text =
            Row[1] .. ": " .. FormatValue(Row[2])

        Label.TextColor3 =
            Index == 2
            and Color3.fromRGB(255, 215, 110)
            or Color3.fromRGB(215, 215, 215)

        Label.TextSize = 10
        Label.Font = Enum.Font.Gotham
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.TextTruncate = Enum.TextTruncate.AtEnd
        Label.Parent = Card
    end
end

--==================================================
-- REFRESH
--==================================================

local function RefreshProfiles()
    for _, Child in ipairs(Scroll:GetChildren()) do
        if Child:IsA("Frame") then
            Child:Destroy()
        end
    end

    local Search = string.lower(SearchBox.Text)
    local Count = 0

    for _, Horse in ipairs(HorseProfiles) do

        local UID = string.lower(
            tostring(Horse.UID or "")
        )

        local Breed = string.lower(
            tostring(Horse.Breed or "")
        )

        if Search == ""
            or string.find(UID, Search, 1, true)
            or string.find(Breed, Search, 1, true) then

            CreateProfile(Horse)
            Count += 1
        end
    end

    Status.Text = "Horses Found: " .. Count
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(
    RefreshProfiles
)

--==================================================
-- INVENTORY SCANNER
--==================================================

task.spawn(function()

    Status.Text = "Finding inventory data..."

    -- Find References
    local ReferencesModule =
        ReplicatedStorage:FindFirstChild("References")

    if not ReferencesModule then
        Status.Text = "References module not found"
        warn("[Horse Scanner] References module not found")
        return
    end

    if not ReferencesModule:IsA("ModuleScript") then
        Status.Text = "References is not a ModuleScript"
        warn("[Horse Scanner] References is not a ModuleScript")
        return
    end

    local SuccessReferences, References =
        pcall(require, ReferencesModule)

    if not SuccessReferences then
        Status.Text = "Failed to load References"
        warn("[Horse Scanner]", References)
        return
    end

    Status.Text = "Loading player data..."

    -- Find Data
    local Data

    pcall(function()
        Data =
            References.PlayerScripts
            .Priority
            .Data
    end)

    if not Data then
        Status.Text = "Data module not found"
        warn("[Horse Scanner] Data module not found")
        return
    end

    if type(Data.GetLocal) ~= "function" then
        Status.Text = "GetLocal not found"
        warn("[Horse Scanner] Data.GetLocal is not available")
        return
    end

    -- Get entire inventory
    Status.Text = "Scanning entire inventory..."

    local SuccessInventory, Inventory =
        pcall(function()
            return Data.GetLocal({"inventory"})
        end)

    if not SuccessInventory then
        Status.Text = "Inventory scan failed"
        warn("[Horse Scanner] Inventory error:", Inventory)
        return
    end

    if typeof(Inventory) ~= "table" then
        Status.Text =
            "Inventory returned " .. typeof(Inventory)

        warn(
            "[Horse Scanner] Inventory type:",
            typeof(Inventory)
        )

        return
    end

    --==================================================
    -- SCAN EVERY INVENTORY ENTRY
    --==================================================

    local Total = 0
    local Horses = 0

    for UID, Item in pairs(Inventory) do

        Total += 1

        if typeof(Item) == "table" and IsHorse(Item) then

            local MainColour,
                ManeColour,
                TailColour =
                GetColours(Item)

            local Breed =
                FindBreed(Item, 0)

            -- Try item info if available
            if not Breed then

                local ItemId =
                    Item.pId
                    or Item.PId
                    or Item.pid
                    or Item.itemId
                    or Item.ItemId

                if ItemId then

                    pcall(function()

                        if References.Items
                            and type(References.Items.GetInfo)
                            == "function" then

                            local Info =
                                References.Items.GetInfo(ItemId)

                            Breed =
                                FindBreed(Info, 0)
                                or Breed
                        end

                    end)

                end
            end

            -- Final fallback
            if not Breed then
                Breed = "Horse"
            end

            table.insert(HorseProfiles, {
                UID = UID,
                Breed = Breed,
                MainColour = MainColour,
                ManeColour = ManeColour,
                TailColour = TailColour
            })

            Horses += 1
        end
    end

    RefreshProfiles()

    Status.Text =
        "Horses: "
        .. tostring(Horses)
        .. " / Inventory Items: "
        .. tostring(Total)

    print(
        "[Horse Scanner] Inventory:",
        Total,
        "Horses:",
        Horses
    )

end)

