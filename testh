--==================================================
-- DATA ACCESS
--==================================================

local References
local Data

local function GetInventory()

    local success, result = pcall(function()

        References = References or require(
            ReplicatedStorage:WaitForChild("References")
        )

        Data = Data or require(
            References.PlayerScripts.Priority.Data
        )

        return Data.GetLocal({"inventory"})
    end)

    if success and type(result) == "table" then
        return result
    end

    return nil
end

--==================================================
-- ITEM INFO
--==================================================

local function GetItemInfo(item)

    if type(item) ~= "table" then
        return nil
    end

    if not References or not References.Items then
        return nil
    end

    local itemId =
        item.id
        or item.ID
        or item.Id

    if not itemId then
        return nil
    end

    local success, result = pcall(function()
        return References.Items.GetInfo(itemId)
    end)

    if success and type(result) == "table" then
        return result
    end

    return nil
end

--==================================================
-- FIELD HELPER
--==================================================

local function GetField(tbl, names)

    if type(tbl) ~= "table" then
        return nil
    end

    for _, name in ipairs(names) do

        if tbl[name] ~= nil then
            return tbl[name]
        end
    end

    return nil
end

--==================================================
-- BREED
--==================================================

local function GetBreed(item, info)

    local breed = GetField(item, {
        "breed",
        "Breed",
        "breedName",
        "BreedName",
        "horseBreed",
        "HorseBreed"
    })

    if breed == nil then

        breed = GetField(info, {
            "breed",
            "Breed",
            "breedName",
            "BreedName",
            "horseBreed",
            "HorseBreed"
        })

    end

    if breed == nil then
        return "Unknown Breed"
    end

    breed = tostring(breed)

    -- Add "Horse" automatically.
    -- Prevent "Horse Horse".

    if not breed:lower():find(
        "horse",
        1,
        true
    ) then

        breed = breed .. " Horse"

    end

    return breed
end

--==================================================
-- COLOURS
--==================================================

local function GetColours(item)

    local variants = item.variants

    if type(variants) ~= "table" then
        return "Unknown", "Unknown", "Unknown"
    end

    local mainColour =
        variants.colour
        or variants.mainColour
        or variants.MainColour

    local maneColour =
        variants.maneColour
        or variants.ManeColour

    local tailColour =
        variants.tailColour
        or variants.TailColour

    return
        tostring(mainColour or "Unknown"),
        tostring(maneColour or "Unknown"),
        tostring(tailColour or "Unknown")
end

--==================================================
-- HORSE CHECK
--==================================================

local function IsHorse(item)

    if type(item) ~= "table" then
        return false
    end

    local variants = item.variants

    if type(variants) == "table" then

        if variants.colour ~= nil
            or variants.maneColour ~= nil
            or variants.tailColour ~= nil then

            return true
        end
    end

    return false
end

