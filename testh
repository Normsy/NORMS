--==================================================
-- NORMALIZE
--==================================================

local function NormalizeText(value)

    if value == nil then
        return ""
    end

    local text = tostring(value):lower()

    text = text:gsub("[%p_]+", " ")
    text = text:gsub("%s+", " ")

    return text:match("^%s*(.-)%s*$")
end

--==================================================
-- FIND BREED KEYWORD
--==================================================

local function FindBreedKeyword(value)

    if value == nil then
        return nil
    end

    local text = NormalizeText(value)

    if text == "" then
        return nil
    end

    -- Check longer keywords first.
    -- This prevents "donkey" from winning over
    -- "mammoth donkey" or "standard donkey".

    local sortedKeywords = {
        "tennessee walking horse",
        "dutch warmblood",
        "mammoth donkey",
        "standard donkey",
        "paint horse",
        "quarter horse",
        "akhal teke",
        "akhal-teke",

        "andalusian",
        "appaloosa",
        "arabian",
        "clydesdale",
        "connemara",
        "fjord",
        "friesian",
        "hinny",
        "icelandic",
        "marwari",
        "morgan",
        "mule",
        "mustang",
        "percheron",
        "reindeer",
        "shire",
        "standardbred",
        "thoroughbred",
        "unicorn",
        "donkey"
    }

    for _, keyword in ipairs(sortedKeywords) do

        local normalizedKeyword =
            NormalizeText(keyword)

        if text == normalizedKeyword
            or text:find(
                normalizedKeyword,
                1,
                true
            ) then

            return BreedDisplayNames[keyword]
                or BreedDisplayNames[
                    normalizedKeyword
                ]

        end

    end

    return nil
end

