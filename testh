    sunrisestreaks=true, topaz=true, emerald=true, amethyst=true, mossy=true, tigerstripes=true,
    jaguarspots=true, moonstone=true, neonpurple=true, neonblue=true, obsidian=true,
    pearlyblue=true, deepspace=true, prismatic=true, volcanicorange=true, volcanicblack=true,
    pearlyblack=true, crackedlavafade=true, blessed=true, pearlypurple=true, sandy=true,
    pearlygold=true, clearseaglass=true
