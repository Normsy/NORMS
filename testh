        return
    end

    if input.UserInputType ==
        Enum.UserInputType.MouseMovement
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        local Delta =
            input.Position
            - DragStart

        Main.Position =
            UDim2.new(

                StartPosition.X.Scale,
                StartPosition.X.Offset
                    + Delta.X,

                StartPosition.Y.Scale,
                StartPosition.Y.Offset
                    + Delta.Y

            )

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        Dragging = false

    end

end)

--==================================================
-- HORSE LIST
--==================================================

local HorseList = {}

--==================================================
-- SCAN ENTIRE INVENTORY
--==================================================

local function ScanInventory()

    table.clear(HorseList)

    local totalEntries = 0

    for uid, item in pairs(Inventory) do

        totalEntries += 1

        if type(item) == "table" then

            local info =
                GetItemInfo(item)

            local isHorse, breed =
                IsBreedProfile(
                    item,
                    info
                )

            if isHorse then

                table.insert(
                    HorseList,
                    {
                        uid = uid,
                        item = item,
                        info = info,
                        breed = breed
                    }
                )

            end

        end

    end

    return totalEntries
end

--==================================================
-- CREATE PROFILE
--==================================================

local function CreateProfile(
    horse,
    order
)

    local uid =
        horse.uid

    local item =
        horse.item

    local info =
        horse.info

    local breed =
        horse.breed
        or GetBreed(
            item,
            info
        )
        or "Unknown"

    local mainColour,
        maneColour,
        tailColour =
        GetColours(item)

    local Card =
        Instance.new("Frame")

    Card.Size =
        UDim2.fromOffset(
            108,
            72
        )

    Card.BackgroundColor3 =
        Color3.fromRGB(
            24,
            24,
            32
        )

    Card.BorderSizePixel = 0

    Card.LayoutOrder =
        order

    Card.Parent =
        Results

    local Corner =
        Instance.new("UICorner")

    Corner.CornerRadius =
        UDim.new(
            0,
            5
        )

    Corner.Parent =
        Card

    local Stroke =
        Instance.new("UIStroke")

    local variants =
        item.variants
        or item.Variants
        or {}

    local HasHorn =
        variants.hornColour ~= nil
        and tostring(variants.hornColour) ~= ""

    local HasNatDyed =
        item.isNatDyed ~= nil

    local HasUniqueHair =
        IsUniqueHair(maneColour)
        or IsUniqueHair(tailColour)

    local MainTailDifferent =
        not ColoursMatch(mainColour, tailColour)

    local HorsePriority = 0

    if HasUniqueHair then
        HorsePriority = 4
    elseif MainTailDifferent then
        HorsePriority = 3
    elseif HasNatDyed then
        HorsePriority = 2
    elseif HasHorn then
        HorsePriority = 1
    end

    Card:SetAttribute("HorsePriority", HorsePriority)

    -- RED = Unique Hair (BEST / highest priority)
    if HasUniqueHair then

        Stroke.Color =
            Color3.fromRGB(
                255,
                0,
                0
            )

        Stroke.Thickness = 2

    -- BLUE = Main and Tail are different (2nd best)
    elseif MainTailDifferent then

        Stroke.Color =
            Color3.fromRGB(
                0,
                170,
                255
            )

        Stroke.Thickness = 2

    -- GREEN = Nat Dyed (3rd best)
    elseif HasNatDyed then

        Stroke.Color =
            Color3.fromRGB(
                0,
                255,
                0
            )

        Stroke.Thickness = 2

    -- PURPLE = Horn Colour (4th best)
    elseif HasHorn then

        Stroke.Color =
            Color3.fromRGB(
                170,
                0,
                255
            )

        Stroke.Thickness = 2

    else

        Stroke.Color =
            Color3.fromRGB(
                42,
                42,
                52
            )

        Stroke.Thickness = 1

    end

    Stroke.Parent =
        Card

    --==============================================
    -- SPECIAL INDICATOR CIRCLES
    -- Red = Unique Hair
    -- Blue = Main and Tail are different
    -- Green = Nat Dyed
    -- Purple = Horn Colour
    -- Every matching indicator is shown, even when
    -- another condition wins the main outline priority.
    --==============================================

    local IndicatorContainer =
        Instance.new("Frame")

    IndicatorContainer.Size =
        UDim2.fromOffset(40, 10)

    IndicatorContainer.Position =
        UDim2.new(1, -41, 0, 3)

    IndicatorContainer.BackgroundTransparency = 1
    IndicatorContainer.Parent = Card

    local function AddIndicator(color, x)

        local Circle =
            Instance.new("Frame")

        Circle.Size =
            UDim2.fromOffset(7, 7)

        Circle.Position =
            UDim2.fromOffset(x, 1)

        Circle.BackgroundColor3 = color
        Circle.BorderSizePixel = 0
        Circle.Parent = IndicatorContainer

        local CircleCorner =
            Instance.new("UICorner")

        CircleCorner.CornerRadius =
            UDim.new(1, 0)

        CircleCorner.Parent = Circle

        local CircleStroke =
            Instance.new("UIStroke")

        CircleStroke.Color =
            Color3.fromRGB(255, 255, 255)

        CircleStroke.Thickness = 1
        CircleStroke.Parent = Circle
    end

    local IndicatorX = 0

    -- Red = Unique Hair
    if HasUniqueHair then
        AddIndicator(
            Color3.fromRGB(255, 0, 0),
            IndicatorX
        )
        IndicatorX = IndicatorX + 8
    end

    -- Blue = Main and Tail are different
    if MainTailDifferent then
        AddIndicator(
            Color3.fromRGB(0, 170, 255),
            IndicatorX
        )
        IndicatorX = IndicatorX + 8
    end

    -- Green = Nat Dyed
    if HasNatDyed then
        AddIndicator(
            Color3.fromRGB(0, 255, 0),
            IndicatorX
        )
        IndicatorX = IndicatorX + 8
    end

    -- Purple = Horn Colour
    if HasHorn then
        AddIndicator(
            Color3.fromRGB(170, 0, 255),
            IndicatorX
        )
        IndicatorX = IndicatorX + 8
    end

    --==============================================
    -- PROFILE TITLE
    --==============================================

    --==============================================
    -- FIVE FIELDS
    --==============================================

    local BreedLabel =
        Instance.new("TextLabel")

    BreedLabel.Size =
        UDim2.new(1, -5, 0, 9)

    BreedLabel.Position =
        UDim2.fromOffset(3, 2)

    BreedLabel.BackgroundTransparency = 1
    BreedLabel.Text = tostring(breed)
    BreedLabel.TextColor3 =
        Color3.fromRGB(255, 215, 100)
    BreedLabel.TextSize = 5
    BreedLabel.Font = Enum.Font.GothamBold
    BreedLabel.TextXAlignment = Enum.TextXAlignment.Left
    BreedLabel.TextTruncate = Enum.TextTruncate.AtEnd
    BreedLabel.Parent = Card

    local Rows = {

        {
            "Main",
            tostring(mainColour)
        },

        {
            "Mane",
            tostring(maneColour)
        },

        {
            "Tail",
            tostring(tailColour)
        }

    }

    for i, row in ipairs(Rows) do

        local Label =
            Instance.new("TextLabel")

        Label.Size =
            UDim2.new(
                1,
                -5,
                0,
                8
            )

        Label.Position =
            UDim2.fromOffset(
                3,
                12
                    + ((i - 1) * 9)
            )

        Label.BackgroundTransparency = 1

        Label.Text =
            row[1]
            .. ": "
            .. row[2]

        Label.TextColor3 =
            Color3.fromRGB(
                215,
                215,
                225
            )

        Label.TextSize = 5

        Label.Font =
            Enum.Font.Gotham

        Label.TextXAlignment =
            Enum.TextXAlignment.Left

        Label.TextYAlignment =
            Enum.TextYAlignment.Center

        Label.TextTruncate =
            Enum.TextTruncate.AtEnd

        Label.Parent =
            Card

    end

    local UIDLabel =
        Instance.new("TextLabel")

    UIDLabel.Size =
        UDim2.new(1, -5, 0, 7)

    UIDLabel.Position =
        UDim2.fromOffset(3, 59)

    UIDLabel.BackgroundTransparency = 1
    UIDLabel.Text = "UID: " .. tostring(uid)
    UIDLabel.TextColor3 =
        Color3.fromRGB(105, 115, 135)
    UIDLabel.TextSize = 4
    UIDLabel.Font = Enum.Font.Gotham
    UIDLabel.TextXAlignment = Enum.TextXAlignment.Left
    UIDLabel.TextTruncate = Enum.TextTruncate.AtEnd
    UIDLabel.Parent = Card

    -- White outline used when this profile is selected.
    local SelectionStroke = Instance.new("UIStroke")
    SelectionStroke.Name = "SelectionStroke"
    SelectionStroke.Color = Color3.fromRGB(255, 255, 255)
    SelectionStroke.Thickness = 0
    SelectionStroke.Parent = Card

    -- Transparent button makes the whole profile selectable.
    local SelectProfile = Instance.new("TextButton")
    SelectProfile.Size = UDim2.fromScale(1, 1)
    SelectProfile.Position = UDim2.fromScale(0, 0)
    SelectProfile.BackgroundTransparency = 1
    SelectProfile.BorderSizePixel = 0
    SelectProfile.Text = ""
    SelectProfile.AutoButtonColor = false
    SelectProfile.ZIndex = 20
    SelectProfile.Parent = Card

    SelectProfile.MouseButton1Click:Connect(function()
        SelectionStroke.Thickness =
            SelectionStroke.Thickness == 0 and 2 or 0
    end)

end

--==================================================
-- SORT BEST TO NORMAL
--==================================================

local function GetHorseStats(horse)

    local item = horse.item

    local mainColour,
        maneColour,
        tailColour =
        GetColours(item)

    local variants =
        item.variants
        or item.Variants
        or {}

    local HasHorn =
        variants.hornColour ~= nil
        and tostring(variants.hornColour) ~= ""

    local HasNatDyed =
        item.isNatDyed ~= nil

    local HasUniqueHair =
        IsUniqueHair(maneColour)
        or IsUniqueHair(tailColour)

    local MainTailDifferent =
        not ColoursMatch(mainColour, tailColour)

    local priority = 0

    if HasUniqueHair then
        priority = 4
    elseif MainTailDifferent then
        priority = 3
    elseif HasNatDyed then
        priority = 2
    elseif HasHorn then
        priority = 1
    end

    local specialCount = 0

    if HasUniqueHair then specialCount += 1 end
    if MainTailDifferent then specialCount += 1 end
    if HasNatDyed then specialCount += 1 end
    if HasHorn then specialCount += 1 end

    return priority, specialCount
end

local function GetHorsePriority(horse)
    local priority = GetHorseStats(horse)
    return priority
end

table.sort(HorseList, function(a, b)

    local priorityA, countA = GetHorseStats(a)
    local priorityB, countB = GetHorseStats(b)

    -- Highest priority group always comes first.
    if priorityA ~= priorityB then
        return priorityA > priorityB
    end

    -- Within the same priority, horses with more special
    -- properties come first.
    if countA ~= countB then
        return countA > countB
    end

    return tostring(a.uid) < tostring(b.uid)
end)

-- HORSE LIST IS SORTED BEST -> NORMAL
-- 4 = Unique Hair
-- 3 = Main != Tail
-- 2 = Nat Dyed
-- 1 = Horn Colour
-- 0 = Normal
