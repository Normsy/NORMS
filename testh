--// ISLAND SCANNER
--// Prints / copies the exact size + location of every island, plus a ground-height grid,
--// and lets you record waypoints at your current position (exact X, Y, Z).
--//
--// Buttons:
--//   Scan Islands  -> bounds (min/max/center/size) of each island in Workspace.Islands
--//   Scan Ground   -> ground height grid for the island you are standing on
--//   Record Point  -> saves your current position as a Vector3.new(...) line
--//   Copy Points   -> copies all recorded points to the clipboard
--//   Clear Points  -> empties the recorded list

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local GRID_STEP = 150 -- studs between ground samples (smaller = more detail, more output)

--// ---------------------------------------------------------------- helpers
local function copy(text)
    if setclipboard then
        setclipboard(text)
        return true
    elseif toclipboard then
        toclipboard(text)
        return true
    end
    return false
end

local function save(name, text)
    pcall(function()
        if writefile then writefile(name, text) end
    end)
end

local function fmt(n)
    return string.format("%.1f", n)
end

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function addPartBounds(part, b)
    local cf, half = part.CFrame, part.Size / 2
    for _, sx in ipairs({-1, 1}) do
        for _, sy in ipairs({-1, 1}) do
            for _, sz in ipairs({-1, 1}) do
                local p = cf:PointToWorldSpace(Vector3.new(half.X * sx, half.Y * sy, half.Z * sz))
                b.minX = math.min(b.minX, p.X); b.maxX = math.max(b.maxX, p.X)
                b.minY = math.min(b.minY, p.Y); b.maxY = math.max(b.maxY, p.Y)
                b.minZ = math.min(b.minZ, p.Z); b.maxZ = math.max(b.maxZ, p.Z)
            end
        end
    end
    b.parts += 1
end

local function islandBounds(island)
    local b = {
        minX = math.huge, minY = math.huge, minZ = math.huge,
        maxX = -math.huge, maxY = -math.huge, maxZ = -math.huge,
        parts = 0,
    }
    local count = 0
    local function visit(obj)
        if obj:IsA("BasePart") then addPartBounds(obj, b) end
    end
    visit(island)
    for _, obj in ipairs(island:GetDescendants()) do
        visit(obj)
        count += 1
        if count % 2000 == 0 then task.wait() end
    end
    if b.parts == 0 then return nil end
    return b
end

local function currentIsland(islands, pos)
    local best, bestDist = nil, math.huge
    for _, island in ipairs(islands:GetChildren()) do
        local b = islandBounds(island)
        if b then
            local cx = math.clamp(pos.X, b.minX, b.maxX)
            local cz = math.clamp(pos.Z, b.minZ, b.maxZ)
            local d = math.sqrt((pos.X - cx) ^ 2 + (pos.Z - cz) ^ 2)
            if d < bestDist then
                bestDist = d
                best = island
            end
        end
    end
    return best
end

