--==================================================
-- NORMALIZE BREED
--==================================================

local function NormalizeBreed(value)

    if value == nil then
        return nil
    end

    local text = tostring(value)

    if text == "" then
        return nil
    end

    local lower = text:lower()

    for key, displayName in pairs(BreedNames) do

        if lower == key then
            return displayName
        end

        if lower == displayName:lower() then
            return displayName
        end

    end

    for key, displayName in pairs(BreedNames) do

        if lower:find(key, 1, true) then
            return displayName
        end

    end

    if lower:find("horse", 1, true) then
        return text
    end

    return nil
end

--==================================================
-- GET FIELD
--==================================================

local function GetField(tbl, names)

    if type(tbl) ~= "table" then
        return nil
    end

    for _, key in ipairs(names) do

        if tbl[key] ~= nil then
            return tbl[key]
        end

    end

    return nil
end

--==================================================
-- BREED FROM TABLE
--==================================================

local function FindBreedInTable(tbl)

    if type(tbl) ~= "table" then
        return nil
    end

    local value = GetField(tbl, {

        "breed",
        "Breed",
        "breedName",
        "BreedName",
        "horseBreed",
        "HorseBreed",
        "breedId",
        "BreedId"

    })

    return NormalizeBreed(value)
end

--==================================================
-- RECURSIVE BREED SEARCH
--==================================================

local function SearchKnownBreed(tbl, depth)

    if type(tbl) ~= "table" then
        return nil
    end

    depth = depth or 0

    if depth > 5 then
        return nil
    end

    -- First check direct breed fields
    local direct =
        FindBreedInTable(tbl)

    if direct then
        return direct
    end

    -- Search values
    for _, value in pairs(tbl) do

        if type(value) == "string"
            or type(value) == "number" then

            local result =
                NormalizeBreed(value)

            if result then
                return result
            end

        elseif type(value) == "table" then

            local result =
                SearchKnownBreed(
                    value,
                    depth + 1
                )

            if result then
                return result
            end
        end

    end

    return nil
end

--==================================================
-- ITEM INFO
--==================================================

local function GetItemInfo(item)

    if type(item) ~= "table" then
        return nil
    end

    if not References
        or not References.Items then

        return nil
    end

    local itemId =
        item.id
        or item.ID
        or item.Id

    if not itemId then
        return nil
    end

    local ok, result =
        pcall(function()

            return References.Items.GetInfo(
                itemId
            )

        end)

    if ok and type(result) == "table" then
        return result
    end

    return nil
end

--==================================================
-- BREED RESOLUTION
--==================================================

local function GetBreed(item, info)

    -- 1. Direct item
    local breed =
        FindBreedInTable(item)

    if breed then
        return breed
    end

    -- 2. Item info
    breed =
        FindBreedInTable(info)

    if breed then
        return breed
    end

    -- 3. Common nested structures
    if type(item) == "table" then

        local nested = {

            "data",
            "Data",

            "attributes",
            "Attributes",

            "horse",
            "Horse",

            "stats",
            "Stats"

        }

        for _, key in ipairs(nested) do

            if type(item[key]) == "table" then

                breed =
                    SearchKnownBreed(
                        item[key]
                    )

                if breed then
                    return breed
                end

            end

        end

    end

    -- 4. Search entire item
    breed =
        SearchKnownBreed(item)

    if breed then
        return breed
    end

    -- 5. Search entire item info
    breed =
        SearchKnownBreed(info)

    if breed then
        return breed
    end

    -- 6. Try pId
    local pId =
        item
        and (
            item.pId
            or item.PId
            or item.pid
        )

    if info then

        pId =
            pId
            or info.pId
            or info.PId
            or info.pid

    end

    if pId
        and References
        and References.Items
        and type(
            References.Items.GetInfo
        ) == "function" then

        local attempts = {
            pId,
            tostring(pId)
        }

        for _, lookupId in ipairs(attempts) do

            local ok, result =
                pcall(function()

                    return References.Items.GetInfo(
                        lookupId
                    )

                end)

            if ok and type(result) == "table" then

                breed =
                    SearchKnownBreed(result)

                if breed then
                    return breed
                end

            end

        end

    end

    return "Breed Data Not Exposed"
end

--==================================================
-- COLOURS
--==================================================

local function GetColours(item)

    if type(item) ~= "table" then

        return
            "Colour Data Not Found",
            "Colour Data Not Found",
            "Colour Data Not Found"

    end

    local variants =
        item.variants
        or item.Variants

    if type(variants) ~= "table" then

        return
            "Colour Data Not Found",
            "Colour Data Not Found",
            "Colour Data Not Found"

    end

    local mainColour =
        variants.colour
        or variants.mainColour
        or variants.MainColour

    local maneColour =
        variants.maneColour
        or variants.ManeColour

    local tailColour =
        variants.tailColour
        or variants.TailColour

    return

        tostring(
            mainColour
            or "Colour Data Not Found"
        ),

        tostring(
            maneColour
            or "Colour Data Not Found"
        ),

        tostring(
            tailColour
            or "Colour Data Not Found"
        )
end

--==================================================
-- HORSE DETECTION
--==================================================

local function IsHorse(item)

    if type(item) ~= "table" then
        return false
    end

    -- Main horse structure
    local variants =
        item.variants
        or item.Variants

    if type(variants) == "table" then

        if variants.colour
            or variants.mainColour
            or variants.MainColour
            or variants.maneColour
            or variants.ManeColour
            or variants.tailColour
            or variants.TailColour
            or variants.maneStyle
            or variants.tailStyle then

            return true
        end

    end

    -- Direct breed
    if item.breed
        or item.Breed
        or item.breedName
        or item.BreedName
        or item.horseBreed
        or item.HorseBreed then

        return true
    end

    return false
end

