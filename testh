local HorseList = {}
local DisplayHorses

local SelectedHorses = {}
local SelectedCategories = {
    UniqueHair = false,
    Mismatched = false,
    NaturalDyed = false,
    Horned = false,
    Normal = false
}

local function GetHorseCategory(horse)

    local mainColour, maneColour, tailColour =
        GetColours(horse.item)

    local variants =
        horse.item.variants
        or horse.item.Variants
        or {}

    local HasHorn =
        variants.hornColour ~= nil
        and tostring(variants.hornColour) ~= ""

    local HasNatDyed =
        horse.item.isNatDyed ~= nil

    local HasUniqueHair =
        IsUniqueHair(maneColour)
        or IsUniqueHair(tailColour)

    local MainTailDifferent =
        not ColoursMatch(mainColour, tailColour)

    if HasUniqueHair then
        return "UniqueHair"
    elseif MainTailDifferent then
        return "Mismatched"
    elseif HasNatDyed then
        return "NaturalDyed"
    elseif HasHorn then
        return "Horned"
    else
        return "Normal"
    end
end

local function IsHorseSelected(horse)
    if SelectedHorses[horse.uid] then
        return true
    end

    return SelectedCategories[GetHorseCategory(horse)] == true
end

local function SetCategorySelection(category, selected)
    SelectedCategories[category] = selected

    for _, horse in ipairs(HorseList) do
        if GetHorseCategory(horse) == category then
            if selected then
                SelectedHorses[horse.uid] = true
            else
                SelectedHorses[horse.uid] = nil
            end
        end
    end
end

