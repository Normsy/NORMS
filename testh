-- Prototype horse data
local horses = {
    {"Arabian", "Black", "Rare", true},
    {"Mustang", "Chestnut", "Uncommon", false},
    {"Andalusian", "White", "Rare", true},
    {"Friesian", "Black", "Epic", false},
    {"Quarter Horse", "Bay", "Common", false},
    {"Thoroughbred", "Palomino", "Rare", true},
}

local function createCard(horse, index)
    local name, colour, rarity, unique = table.unpack(horse)

    local card = Instance.new("TextButton")
    card.Name = "Horse_" .. index
    card.Text = ""
    card.AutoButtonColor = false
    card.BackgroundColor3 = Color3.fromRGB(29,29,35)
    card.BorderSizePixel = 0
    card.LayoutOrder = index
    card.Parent = list

    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(48,48,57)
    stroke.Parent = card

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0,52,0,52)
    icon.Position = UDim2.new(0.5,-26,0,10)
    icon.BackgroundColor3 = Color3.fromRGB(40,40,48)
    icon.Text = "ð´"
    icon.TextSize = 24
    icon.Parent = card
    Instance.new("UICorner", icon).CornerRadius = UDim.new(0,8)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1,-12,0,20)
    nameLabel.Position = UDim2.new(0,6,0,68)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = name
    nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.Parent = card

    local info = Instance.new("TextLabel")
    info.Size = UDim2.new(1,-12,0,18)
    info.Position = UDim2.new(0,6,0,90)
    info.BackgroundTransparency = 1
    info.Text = colour .. " â¢ " .. rarity
    info.TextColor3 = Color3.fromRGB(160,160,168)
    info.TextSize = 9
    info.Font = Enum.Font.Gotham
    info.Parent = card

    local uniqueLabel = Instance.new("TextLabel")
    uniqueLabel.Size = UDim2.new(1,-12,0,20)
    uniqueLabel.Position = UDim2.new(0,6,1,-25)
    uniqueLabel.BackgroundTransparency = 1
    uniqueLabel.Text = unique and "â UNIQUE" or "STANDARD"
    uniqueLabel.TextColor3 = unique and Color3.fromRGB(255,210,90) or Color3.fromRGB(105,105,112)
    uniqueLabel.TextSize = 9
    uniqueLabel.Font = Enum.Font.GothamBold
    uniqueLabel.Parent = card

    card.MouseEnter:Connect(function()
        card.BackgroundColor3 = Color3.fromRGB(38,38,45)
    end)

    card.MouseLeave:Connect(function()
        card.BackgroundColor3 = Color3.fromRGB(29,29,35)
    end)

    card.MouseButton1Click:Connect(function()
        print("Selected:", name, colour, rarity, unique)
    end)
end

for i, horse in ipairs(horses) do
    createCard(horse, i)
end
