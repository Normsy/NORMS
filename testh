-- DISPLAY
--==================================================

local function DisplayHorses()

    for _, child in ipairs(
        Results:GetChildren()
    ) do

        if child:IsA("Frame") then
            child:Destroy()
        end

    end

    local searchText =
        Search.Text:lower()

    local shown = 0

    for _, horse in ipairs(
        HorseList
    ) do

        local breed =
            GetBreed(
                horse.item,
                horse.info
            )

        local searchable =
            tostring(horse.uid)
            .. " "
            .. tostring(breed)

        if searchText == ""
            or searchable:lower():find(
                searchText,
                1,
                true
            ) then

            shown += 1

            CreateProfile(
                horse.uid,
                horse.item,
                horse.info,
                shown
            )

        end

    end

    Status.Text =
        "Horses: "
        .. tostring(shown)
        .. " / "
        .. tostring(#HorseList)

    task.defer(UpdateCanvas)

end

