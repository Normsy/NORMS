	lassoActive = state
	if state then
		runShopBatchLoop(1, function() return lassoActive end, amountBox, setState)
	end
end)

-- 3. Craft (Spams if blank/0, or runs specified count if > 0)
local craftActive = false
createToggleRow("Craft", "Spam / Amt", function(state, amountBox, setState)
	craftActive = state
	if state then
		task.spawn(function()
			local limit = parseAmount(amountBox.Text)
			local count = 0

			while craftActive do
				local args = {
					[1] = "Craft",
					[2] = {
						["id"] = 1243,
						["variants"] = {},
						["amt"] = 250
					}
				}
				CraftEvent:FireServer(unpack(args))
				count += 1

				if limit and limit > 0 and count >= limit then
					break
				end

				task.wait(0.15)
			end

			if craftActive then
				setState(false)
			end
		end)
	end
end)

