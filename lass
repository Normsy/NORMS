	AmountBox.Size = UDim2.new(0, 84, 0, 24)
	AmountBox.Font = Enum.Font.Gotham
	AmountBox.PlaceholderText = placeholderText
	AmountBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
	AmountBox.Text = ""
	AmountBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	AmountBox.TextSize = 10
	AmountBox.ClearTextOnFocus = false
	Instance.new("UICorner", AmountBox).CornerRadius = UDim.new(0, 5)

	local BoxStroke = Instance.new("UIStroke")
	BoxStroke.Color = Color3.fromRGB(50, 50, 50)
	BoxStroke.Thickness = 1
	BoxStroke.Parent = AmountBox

	local Switch = Instance.new("TextButton")
	Switch.Parent = Row
	Switch.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	Switch.Position = UDim2.new(1, -46, 0.5, -10)
	Switch.Size = UDim2.new(0, 38, 0, 20)
	Switch.Text = ""
	Switch.AutoButtonColor = false
	Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

	local Knob = Instance.new("Frame")
	Knob.Parent = Switch
	Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Knob.Position = UDim2.new(0, 3, 0.5, -7)
	Knob.Size = UDim2.new(0, 14, 0, 14)
	Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

	local state = false
	local function setState(newState)
		if state == newState then return end
		state = newState
		TweenService:Create(Switch, TweenInfo.new(0.15), {
			BackgroundColor3 = state and Color3.fromRGB(52, 199, 89) or Color3.fromRGB(50, 50, 50)
		}):Play()
		TweenService:Create(Knob, TweenInfo.new(0.15), {
			Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
		}):Play()
		if callback then
			callback(state, AmountBox, setState)
		end
	end

	Switch.MouseButton1Click:Connect(function()
		setState(not state)
	end)

	return setState
end

local function runShopBatchLoop(itemId, isActiveFn, amountBox, setState)
	task.spawn(function()
		local targetAmount = parseAmount(amountBox.Text)
		if not targetAmount or targetAmount <= 0 then
			setState(false)
			return
		end

		local bought = 0
		while isActiveFn() and bought < targetAmount do
			local batchAmt = math.min(1000, targetAmount - bought)
			local args = {
				[1] = "BuyShopItem",
				[2] = "Glacier Island Shop",
				[3] = itemId,
				[4] = batchAmt
			}
			ShopEvent:FireServer(unpack(args))
			bought += batchAmt
			task.wait(0.2)
		end

		if isActiveFn() then
			setState(false)
		end
	end)
end

-- 1. Buy Ice Shard (Item ID = 6, max 1000 per buy)
