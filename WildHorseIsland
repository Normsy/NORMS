local hopping = false
local function executeServerHop()
    if hopping then return end
    hopping = true

    ServerHopBtn.Text = "HOPPING..."
    if StatusText then
        StatusText.Text = "STATUS: Finding server..."
        StatusText.TextColor3 = Color3.fromRGB(251, 191, 36)
    end
    task.spawn(function()
        local success, err = pcall(function()
            local servers = {}
            local reqSuccess, reqResult = pcall(function()
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/public?sortOrder=Asc&limit=100"
                return game:HttpGet(url)
            end)
            if reqSuccess and reqResult then
                local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(reqResult) end)
                if decodeSuccess and data and data.data then
                    for _, s in ipairs(data.data) do
                        if type(s) == "table" and s.id ~= game.JobId and s.playing < s.maxPlayers then
                            table.insert(servers, s.id)
                        end
                    end
                end
            end
            if #servers > 0 then
                local targetServer = servers[math.random(1, #servers)]
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, LocalPlayer)
            else
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end
        end)
        if not success then
            warn("Server hop failed:", err)
            ServerHopBtn.Text = "Server Hop"
            if StatusText then
                StatusText.Text = "STATUS: Hop failed"
                StatusText.TextColor3 = Color3.fromRGB(239, 68, 68)
            end
            hopping = false
        end
    end)
end

