task.spawn(function()
    while ScreenGui.Parent do
        local char = LocalPlayer.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if AutoFarmEnabled and not ActiveWalkTarget and rootPart and humanoid and humanoid.Health > 0 then
            local horses = GetWorldHorses()
            if #horses > 0 then
                table.sort(horses, function(a, b)
                    local weightA = RarityPriority[a.Rarity] or 0
                    local weightB = RarityPriority[b.Rarity] or 0
                    if weightA ~= weightB then
                        return weightA > weightB
                    else
                        return a.Distance < b.Distance
                    end
                end)
                ActiveWalkTarget = horses[1].Model
                ActiveTargetIsland = horses[1].Island
                TargetUID = horses[1].UID
            end
        end

        if ActiveWalkTarget and rootPart and humanoid and humanoid.Health > 0 then
            local activeHorse = ActiveWalkTarget
            local activeWeld = nil
            local activeTween = nil

            local successRun = pcall(function()
                if not (activeHorse and activeHorse.Parent) then return end

                local targetIslandName = ActiveTargetIsland
                if not targetIslandName then
                    local currentObj = activeHorse
                    while currentObj and currentObj ~= Workspace do
                        if currentObj.Parent == Workspace:FindFirstChild("Islands") then
                            targetIslandName = currentObj.Name
                            break
                        end
                        currentObj = currentObj.Parent
                    end
                end

                local currentIslandName = GetCurrentPlayerIsland()
                if targetIslandName and currentIslandName == targetIslandName then
                    print("[TRAVEL LOG] Player is ALREADY on target island ('" .. tostring(targetIslandName) .. "'). Skipping travel sequence.")
                elseif targetIslandName then
                    local manualTravelRemote = TravelRemoteBox.Text
                    if manualTravelRemote == "" then
                        warn("[TRAVEL ERROR] Travel Remote field is empty in settings!")
                        if StatusText then
                            StatusText.Text = "STATUS: Enter Travel Remote first"
                            StatusText.TextColor3 = Color3.fromRGB(239, 68, 68)
                        end
                        ActiveWalkTarget = nil
                        ActiveTargetIsland = nil
                        TargetUID = nil
                        return
                    end

                    local travelFunc = Functions:FindFirstChild(manualTravelRemote)
                    if not travelFunc then
                        warn("[TRAVEL ERROR] RemoteFunction '" .. tostring(manualTravelRemote) .. "' was NOT found inside ReplicatedStorage.Communication.Functions!")
                        if StatusText then
                            StatusText.Text = "STATUS: Travel Remote not found"
                            StatusText.TextColor3 = Color3.fromRGB(239, 68, 68)
                        end
                        ActiveWalkTarget = nil
                        ActiveTargetIsland = nil
                        TargetUID = nil
                        return
                    end

                    if StatusText then
                        StatusText.Text = "STATUS: Traveling to " .. targetIslandName .. "..."
                        StatusText.TextColor3 = Color3.fromRGB(251, 191, 36)
                    end

                    local invokeSuccess, serverResult = pcall(function()
                        return travelFunc:InvokeServer("Travel", targetIslandName, 1)
                    end)

                    if not invokeSuccess then
                        if StatusText then
                            StatusText.Text = "STATUS: Travel Failed"
                            StatusText.TextColor3 = Color3.fromRGB(239, 68, 68)
                        end
                        ActiveWalkTarget = nil
                        ActiveTargetIsland = nil
                        TargetUID = nil
                        return
                    end

                    if StatusText then
                        StatusText.Text = "STATUS: Waiting for Island Arrival..."
                        StatusText.TextColor3 = Color3.fromRGB(251, 191, 36)
                    end

                    local travelWaitStart = tick()
                    local arrived = false
                    while tick() - travelWaitStart < 15 do
                        if ActiveWalkTarget ~= activeHorse or not (activeHorse and activeHorse.Parent) then return end
                        local islandFolder = Workspace:FindFirstChild("Islands") and Workspace.Islands:FindFirstChild(targetIslandName)
                        local currentIsland = GetCurrentPlayerIsland()
                        if (islandFolder and currentIsland == targetIslandName) or (islandFolder and (tick() - travelWaitStart > 3)) then
                            arrived = true
                            break
                        end
                        task.wait(0.2)
                    end
                    char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    rootPart = char:WaitForChild("HumanoidRootPart")
                    humanoid = char:WaitForChild("Humanoid")
                end

                if not (activeHorse and activeHorse.Parent) or humanoid.Health <= 0 then
                    ActiveWalkTarget = nil
                    ActiveTargetIsland = nil
                    TargetUID = nil
                    return
                end

                EnableNoClip(char)
                humanoid.PlatformStand = true
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                rootPart.Anchored = true

                local targetPart = activeHorse:IsA("Model") and (activeHorse.PrimaryPart or activeHorse:FindFirstChildWhichIsA("BasePart")) or activeHorse
                if targetPart then
                    local targetCFrame = targetPart.CFrame * CFrame.new(0, 3, 0)
                    local distance = (rootPart.Position - targetCFrame.Position).Magnitude
                    local tweenTime = distance / TWEEN_SPEED

                    if StatusText then
                        StatusText.Text = "STATUS: Tweening to Horse..."
                        StatusText.TextColor3 = Color3.fromRGB(251, 191, 36)
                    end

                    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                    activeTween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
                    activeTween:Play()

                    while activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing do
                        if ActiveWalkTarget ~= activeHorse or not (activeHorse and activeHorse.Parent) or humanoid.Health <= 0 then
                            activeTween:Cancel()
                            break
                        end
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        task.wait(0.03)
                    end

                    if ActiveWalkTarget == activeHorse and activeHorse and activeHorse.Parent and humanoid.Health > 0 then
                        rootPart.CFrame = targetPart.CFrame * CFrame.new(0, 3, 0)
                        activeWeld = Instance.new("WeldConstraint")
                        activeWeld.Name = "HorseTrackerWeld"
                        activeWeld.Part0 = rootPart
                        activeWeld.Part1 = targetPart
                        activeWeld.Parent = rootPart
                        rootPart.Anchored = true
                    end
                end

                while ActiveWalkTarget == activeHorse and activeHorse and activeHorse.Parent and humanoid.Health > 0 do
                    local manualCatchRemote = CatchRemoteBox.Text
                    if manualCatchRemote == "" or not ConfiguredLassoUID then
                        if StatusText then
                            StatusText.Text = "STATUS: Enter Catch Remote & Lasso UID first"
                            StatusText.TextColor3 = Color3.fromRGB(239, 68, 68)
                        end
                        ActiveWalkTarget = nil
                        ActiveTargetIsland = nil
                        TargetUID = nil
                        break
                    end

                    if StatusText then
                        local lName = LassoNameBox and LassoNameBox.Text ~= "" and LassoNameBox.Text or SelectedLasso
                        StatusText.Text = "STATUS: Catching (" .. lName .. ")..."
                        StatusText.TextColor3 = Color3.fromRGB(57, 255, 20)
                    end

                    pcall(function()
                        local catchEvent = Events:FindFirstChild(manualCatchRemote)
                        if catchEvent then
                            catchEvent:FireServer(
                                ConfiguredLassoUID,
                                "Activate",
                                activeHorse
                            )
                        end
                    end)
                    task.wait(0.2)
                end
            end)

            if activeTween then pcall(function() activeTween:Cancel() end) end
            if activeWeld then activeWeld:Destroy() end

            pcall(function()
                if rootPart then
                    rootPart.Anchored = false
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
                if humanoid then
                    humanoid.PlatformStand = false
                end
            end)
            DisableNoClip(char)

            ActiveWalkTarget = nil
            ActiveTargetIsland = nil
            TargetUID = nil
        else
            task.wait(0.5)
        end
    end
end)
